@page "/admin/bao-mat"
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.BaoMatModel
@{
    ViewData["Title"] = "Bảo mật tài khoản";
}

<section class="crm-page">
    <header class="crm-page-heading">
        <div>
            <p class="crm-eyebrow">Tài khoản</p>
            <h1>Bảo mật tài khoản</h1>
            <p class="crm-page-description">Xác thực hai bước dùng Google Authenticator, Microsoft Authenticator hoặc TOTP tương thích.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.Message)) { <p class="crm-ok" role="status">@Model.Message</p> }
    @if (!string.IsNullOrWhiteSpace(Model.Error)) { <p class="crm-alert" role="alert">@Model.Error</p> }

    <section class="crm-panel">
        <header class="crm-panel-heading">
            <h2>Xác thực hai bước</h2>
            <span class="education-status @(Model.MfaEnabled ? "education-status-active" : "education-status-inactive")"><i aria-hidden="true"></i>@(Model.MfaEnabled ? "Đang bật" : "Đang tắt")</span>
        </header>
        <div class="crm-form-grid" style="grid-template-columns:minmax(0,1fr)">
            @if (Model.MfaEnabled)
            {
                <form method="post" asp-page-handler="Disable" class="crm-form-grid" style="grid-template-columns:minmax(0,1fr)">
                    <label for="password">Mật khẩu hiện tại
                        <input id="password" name="Password" type="password" autocomplete="current-password" required />
                    </label>
                    <label for="code">Mã Authenticator 6 số
                        <input id="code" name="Code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required />
                    </label>
                    <div class="crm-form-actions"><button class="education-delete-button" type="submit">Tắt xác thực hai bước</button></div>
                </form>
            }
            else if (string.IsNullOrEmpty(Model.Secret))
            {
                <p class="crm-page-description">Tạo khóa rồi quét QR hoặc nhập khóa vào ứng dụng Authenticator.</p>
                <form method="post" asp-page-handler="Setup"><button class="crm-primary-button" type="submit">Tạo khóa thiết lập</button></form>
            }
            else
            {
                <p class="crm-page-description">Nhập URI vào ứng dụng Authenticator:</p>
                <p><code class="crm-code">@Model.ProvisioningUri</code></p>
                <p>Khóa dự phòng: <code class="crm-code">@Model.Secret</code></p>
                <form method="post" asp-page-handler="Enable" class="crm-form-grid" style="grid-template-columns:minmax(0,1fr)">
                    <label for="code">Mã Authenticator 6 số để xác nhận
                        <input id="code" name="Code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required />
                    </label>
                    <div class="crm-form-actions"><button class="crm-primary-button" type="submit">Xác nhận và bật</button></div>
                </form>
            }
        </div>
    </section>
</section>
