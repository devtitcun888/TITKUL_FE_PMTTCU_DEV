@page "/lien-he"
@model TITKUL.PMTTCU.Web.Pages.LienHeModel
@{
    ViewData["Title"] = "Liên hệ";
}
<section class="stack">
    <section class="card stack">
        <h1>Liên hệ</h1>
        @if (Model.ConfigurationUnavailable) { <p class="alert" role="alert">Chưa thể tải thông tin liên hệ. Vui lòng thử lại sau.</p> }
        @if (!string.IsNullOrWhiteSpace(Model.Name)) { <p>@Model.Name</p> }
        @if (!string.IsNullOrWhiteSpace(Model.Address)) { <p>Địa chỉ: @Model.Address</p> }
        @if (!string.IsNullOrWhiteSpace(Model.TelephoneHref)) { <p>Điện thoại: <a href="tel:@Model.TelephoneHref">@Model.Hotline</a></p> }
        @if (!string.IsNullOrWhiteSpace(Model.Email)) { <p>Email: <a href="mailto:@Model.Email">@Model.Email</a></p> }
        @if (!string.IsNullOrWhiteSpace(Model.MapsUrl))
        {
            <p><a class="button button-quiet" href="@Model.MapsLinkUrl" target="_blank" rel="noopener noreferrer">Mở địa chỉ trong ứng dụng bản đồ ↗</a></p>
            @if (Model.MapsEmbedUrl is not null)
            {
                <iframe title="Bản đồ" src="@Model.MapsEmbedUrl" width="100%" height="280" style="border:0;max-width:100%" loading="lazy" referrerpolicy="no-referrer" sandbox="allow-scripts allow-same-origin allow-popups"></iframe>
            }
            else
            {
                <p class="muted">Bản đồ nhúng chưa được cấu hình; mở liên kết để xem đường đi.</p>
            }
        }
        else
        {
            <p class="empty">Bản đồ chưa được cấu hình.</p>
        }
    </section>
    <section class="card stack">
        <h2>Gửi phản ánh</h2>
        @if (!string.IsNullOrEmpty(Model.Message)) { <p role="status">@Model.Message</p> }
        @if (!string.IsNullOrWhiteSpace(Model.TrackingCode))
        {
            <p>Mã theo dõi: <strong>@Model.TrackingCode</strong></p>
            <p><a href="/theo-doi-phan-anh/@Uri.EscapeDataString(Model.TrackingCode)">Mở trao đổi phản ánh</a></p>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <p class="alert" role="alert">@Model.ErrorMessage</p> }
        <p class="muted">Thông tin bạn gửi được dùng để tiếp nhận và phản hồi liên hệ. <a href="/Privacy">Xem thông tin về dữ liệu và quyền riêng tư</a>.</p>
        @if (!Model.TrackingCodeUnavailable)
        {
        <form method="post" class="stack">
            <div class="hp" aria-hidden="true"><label for="website">Website</label><input id="website" name="Website" tabindex="-1" autocomplete="off" /></div>
            <div><label for="hoTen">Họ tên</label><input id="hoTen" name="HoTen" value="@Model.HoTen" required maxlength="200" autocomplete="name" /></div>
            <div><label for="phone">Số điện thoại</label><input id="phone" name="Phone" type="tel" inputmode="tel" autocomplete="tel" value="@Model.Phone" required maxlength="20" /></div>
            <div><label for="mail">Email</label><input id="mail" name="Mail" type="email" autocomplete="email" value="@Model.Mail" maxlength="254" /></div>
            <div><label for="title">Tiêu đề</label><input id="title" name="Title" value="@Model.Title" required maxlength="250" /></div>
            <div><label for="body">Nội dung</label><textarea id="body" name="Body" rows="5" required maxlength="4000">@Model.Body</textarea></div>
            <button type="submit">Gửi</button>
        </form>
        }
    </section>
</section>
