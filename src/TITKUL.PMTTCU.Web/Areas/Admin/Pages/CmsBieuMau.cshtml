@page "/admin/cms/bieu-mau"
@using TITKUL.PMTTCU.Web.Areas.Admin
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.CmsBieuMauModel
@{
    ViewData["Title"] = "Biểu mẫu";
    var showModal = Model.CanEdit && (Request.Query.ContainsKey("create") || Request.HasFormContentType && Request.Form.Files.Count > 0);
    var returnUrl = Model.CurrentPathAndQuery;
    var firstPage = Math.Max(1, Model.CurrentPage - 2);
    var lastPage = Math.Min(Model.PageCount, Model.CurrentPage + 2);
}

<section class="crm-page cms-posts-page cms-list-page">

    @if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <p class="crm-alert" role="alert">@Model.ErrorMessage</p> }
    @if (!string.IsNullOrEmpty(Model.SuccessMessage)) { <p class="crm-ok" role="status">@Model.SuccessMessage</p> }

    <form class="cms-posts-toolbar" method="get" action="/admin/cms/bieu-mau" role="search" data-cms-autofilter data-cols="1">
        @await Html.PartialAsync("Shared/_CmsSortHidden", (Model.Sort, Model.Dir))
        <button class="cms-posts-filter-toggle @(Model.FiltersActive ? "has-active-filters" : null)" type="button" aria-label="Bộ lọc" aria-expanded="false" aria-controls="cms-form-filter-fields" data-cms-filter-toggle>
            <svg class="cms-posts-filter-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M4 5h16l-6.5 7.5v5l-3 1.5v-6.5L4 5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
        <div class="cms-posts-filter-fields" id="cms-form-filter-fields">
            <label class="cms-posts-field">
                <span>Từ khóa</span>
                <span class="cms-posts-search">
                    <span class="material-symbols-outlined" aria-hidden="true">search</span>
                    <input id="admin-form-query" name="q" type="search" value="@Model.Query" placeholder="Tên hoặc mã biểu mẫu" />
                </span>
            </label>
            <div class="cms-posts-toolbar-actions">
                <a class="cms-posts-reset" href="/admin/cms/bieu-mau">
                    <span class="material-symbols-outlined" aria-hidden="true">restart_alt</span>
                    Xóa lọc
                </a>
            </div>
        </div>
    </form>

    <section class="cms-posts-list" aria-labelledby="form-table-title">
        <header class="cms-posts-list-heading">
            <div>
                <h2 id="form-table-title">Danh sách biểu mẫu</h2>
                <p>@Model.Total.ToString("N0") biểu mẫu</p>
            </div>
            <div class="cms-posts-list-actions">
                @if (Model.CanEdit)
                {
                    <a class="crm-primary-button cms-posts-create" href="/admin/cms/bieu-mau?create=true"><span class="material-symbols-outlined" aria-hidden="true">add</span> Tải biểu mẫu</a>
                }
            </div>
        </header>

        @if (Model.Items.Count == 0)
        {
            <div class="cms-posts-empty">
                <span class="material-symbols-outlined" aria-hidden="true">description</span>
                <strong>@(Model.FiltersActive ? "Không tìm thấy biểu mẫu phù hợp" : "Chưa có biểu mẫu")</strong>
                <p>@(Model.FiltersActive ? "Thử xóa bộ lọc hoặc đổi từ khóa." : "Tải tệp và lưu nháp, rồi đăng khi sẵn sàng.")</p>
            </div>
        }
        else
        {
            <div class="cms-posts-table-scroll">
                <table class="cms-posts-table">
                    <thead>
                        <tr>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "code", Model.Dir)" href="@Model.SortUrl("code")">Mã <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "code", Model.Dir)</span></a></th>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "title", Model.Dir)" href="@Model.SortUrl("title")">Biểu mẫu <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "title", Model.Dir)</span></a></th>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "published", Model.Dir)" href="@Model.SortUrl("published")">Ngày công bố <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "published", Model.Dir)</span></a></th>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "expires", Model.Dir)" href="@Model.SortUrl("expires")">Thời hạn <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "expires", Model.Dir)</span></a></th>
                            <th scope="col">Xem/tải</th>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "status", Model.Dir)" href="@Model.SortUrl("status")">Trạng thái <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "status", Model.Dir)</span></a></th>
                            <th class="cms-posts-actions-col" scope="col">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var statusClass = item.Status?.ToLowerInvariant();
                        <tr>
                            <td><span class="cms-posts-category">@(item.Code ?? "—")</span></td>
                            <td class="cms-posts-title-cell"><strong>@item.Title</strong></td>
                            <td class="cms-posts-stamp">@(item.PublishedAt?.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="cms-posts-stamp">@(item.EffectiveFrom?.ToString("dd/MM/yyyy") ?? "—") – @(item.ExpiresOn?.ToString("dd/MM/yyyy") ?? "không giới hạn")</td>
                            <td>
                                @if (Model.CanUpdate)
                                {
                                    <form method="post" asp-page-handler="ViewMode" asp-route-id="@item.Id">
                                        @Html.AntiForgeryToken()
                                        <select name="mode" aria-label="Quyền xem @item.Title" data-cms-autosubmit>
                                            <option value="AUTO" selected="@(item.ViewMode == "AUTO")">Tự động</option>
                                            <option value="INLINE" selected="@(item.ViewMode == "INLINE")" disabled="@(item.MimeType != "application/pdf")">Cho xem trực tiếp</option>
                                            <option value="DOWNLOAD_ONLY" selected="@(item.ViewMode == "DOWNLOAD_ONLY")">Chỉ tải</option>
                                        </select>
                                    </form>
                                }
                                else { <span>@item.ViewMode</span> }
                            </td>
                            <td>
                                <span class="cms-posts-status is-@statusClass"><i aria-hidden="true"></i>@EducationUi.Status(item.Status ?? "")</span>
                            </td>
                            <td class="cms-posts-actions-col">
                                @if (Model.CanPublish && item.Status != "PUBLISHED")
                                {
                                    <details class="cms-posts-row-menu">
                                        <summary aria-label="Thao tác @item.Title"><span class="material-symbols-outlined" aria-hidden="true">more_horiz</span></summary>
                                        <div class="cms-posts-row-panel" role="menu">
                                            <button class="cms-posts-menu-btn" type="submit" form="cms-form-publish-@item.Id" role="menuitem">Đăng</button>
                                        </div>
                                    </details>
                                    <form id="cms-form-publish-@item.Id" method="post" asp-page-handler="Publish" hidden>
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        <footer class="cms-posts-pager">
            <p class="cms-posts-pager-summary">
                @(Model.Total == 0 ? "Không có biểu mẫu" : $"Hiển thị {Model.FromItem} - {Model.ToItem} của {Model.Total} biểu mẫu")
            </p>
            <div class="cms-posts-pager-controls">
                <form method="get" action="/admin/cms/bieu-mau" class="cms-posts-pagesize">
                    @if (!string.IsNullOrWhiteSpace(Model.Query)) { <input type="hidden" name="q" value="@Model.Query" /> }
                    @await Html.PartialAsync("Shared/_CmsSortHidden", (Model.Sort, Model.Dir))
                    <label>
                        <span class="visually-hidden">Số biểu mẫu mỗi trang</span>
                        <select name="pageSize" data-cms-posts-pagesize>
                            <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10 / trang</option>
                            <option value="20" selected="@(Model.PageSize == 20 ? "selected" : null)">20 / trang</option>
                            <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50 / trang</option>
                        </select>
                    </label>
                </form>
                <nav class="cms-posts-pages" aria-label="Phân trang biểu mẫu">
                    @if (Model.CurrentPage > 1)
                    {
                        <a class="cms-posts-page-btn" href="@Model.ListUrl(page: Model.CurrentPage - 1)" rel="prev" aria-label="Trang trước"><span class="material-symbols-outlined" aria-hidden="true">chevron_left</span></a>
                    }
                    else
                    {
                        <span class="cms-posts-page-btn is-disabled" aria-hidden="true"><span class="material-symbols-outlined">chevron_left</span></span>
                    }
                    @for (var pageNumber = firstPage; pageNumber <= lastPage; pageNumber++)
                    {
                        if (pageNumber == Model.CurrentPage)
                        {
                            <span class="cms-posts-page-btn is-current" aria-current="page">@pageNumber</span>
                        }
                        else
                        {
                            <a class="cms-posts-page-btn" href="@Model.ListUrl(page: pageNumber)">@pageNumber</a>
                        }
                    }
                    @if (Model.CurrentPage < Model.PageCount)
                    {
                        <a class="cms-posts-page-btn" href="@Model.ListUrl(page: Model.CurrentPage + 1)" rel="next" aria-label="Trang sau"><span class="material-symbols-outlined" aria-hidden="true">chevron_right</span></a>
                    }
                    else
                    {
                        <span class="cms-posts-page-btn is-disabled" aria-hidden="true"><span class="material-symbols-outlined">chevron_right</span></span>
                    }
                </nav>
            </div>
        </footer>
    </section>
</section>

@if (showModal)
{
    <dialog class="crm-modal" open data-close-href="/admin/cms/bieu-mau" aria-labelledby="form-modal-title">
        <div class="crm-modal-backdrop"></div>
        <section class="crm-modal-panel">
            <header class="crm-modal-heading">
                <div><p class="crm-eyebrow">Biểu mẫu</p><h2 id="form-modal-title">Tải biểu mẫu nháp</h2></div>
                <a class="crm-modal-close" href="/admin/cms/bieu-mau" aria-label="Đóng">×</a>
            </header>
            <form method="post" enctype="multipart/form-data" class="crm-modal-body">
                <div class="education-form-field"><label for="title">Tiêu đề <span>*</span></label><input id="title" name="Title" required maxlength="300" /></div>
                <p class="education-field-hint">Mã biểu mẫu do hệ thống tự cấp sau khi lưu.</p>
                <div class="education-form-field"><label for="summary">Mô tả</label><textarea id="summary" name="Summary" rows="2"></textarea></div>
                <div class="education-form-field"><label for="form-effective-from">Có hiệu lực từ</label><input id="form-effective-from" name="EffectiveFrom" type="date" /></div>
                <div class="education-form-field"><label for="form-expires-on">Có hiệu lực đến</label><input id="form-expires-on" name="ExpiresOn" type="date" /></div>
                <div class="education-form-field">
                    <label for="upload">Tệp PDF, Word, Excel (tối đa 20 MiB) <span>*</span></label>
                    <input id="upload" name="Upload" type="file" data-file-preview="20971520" accept=".pdf,.doc,.docx,.xls,.xlsx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required />
                    <small data-file-preview-status aria-live="polite"></small>
                </div>
                <div class="education-form-field">
                    <label for="view-mode">Quyền xem tệp công khai</label>
                    <select id="view-mode" name="ViewMode">
                        <option value="AUTO">Tự động (PDF xem trực tiếp, định dạng khác tải xuống)</option>
                        <option value="INLINE">Cho xem trực tiếp (PDF)</option>
                        <option value="DOWNLOAD_ONLY">Chỉ tải xuống</option>
                    </select>
                </div>
                <footer class="crm-modal-actions">
                    <a class="education-cancel-button" href="/admin/cms/bieu-mau">Hủy</a>
                    <button class="crm-primary-button" type="submit">Lưu nháp</button>
                </footer>
            </form>
        </section>
    </dialog>
}

<script src="~/js/admin-cms-list.js" asp-append-version="true" defer></script>
