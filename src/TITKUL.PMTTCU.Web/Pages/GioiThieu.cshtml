@page "/gioi-thieu"
@model TITKUL.PMTTCU.Web.Pages.GioiThieuModel
@{
    ViewData["Title"] = "Giới thiệu";
    var hasWideTable = PortalRichContent.ContainsTable(Model.Html);
}
<section class="card stack">
    <h1>Giới thiệu Trung tâm</h1>
    @if (Model.Unavailable)
    {
        <p class="alert" role="alert">Chưa thể tải nội dung. Vui lòng thử lại sau.</p>
    }
    else if (string.IsNullOrWhiteSpace(Model.Html))
    {
        <p class="empty">Chưa có nội dung giới thiệu.</p>
    }
    else
    {
        @if (hasWideTable) { <p id="cms-table-scroll-hint" class="portal-table-hint">Nếu bảng rộng, vuốt ngang để xem đủ cột. Dùng phím Tab để chọn bảng, sau đó dùng phím mũi tên.</p> }
        <div class="portal-rich-content">@Html.Raw(PortalRichContent.WithScrollableTables(Model.Html))</div>
    }
</section>
