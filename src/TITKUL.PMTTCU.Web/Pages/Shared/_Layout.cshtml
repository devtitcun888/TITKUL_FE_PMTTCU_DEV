<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PMTTCU Tân Trụ</title>
    @if (ViewData["Description"] is string description && description.Length > 0)
    {
        <meta name="description" content="@description" />
    }
    <link rel="stylesheet" href="~/css/pmttcu.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#noi-dung">Đi tới nội dung</a>
    <header class="portal-header">
        <div class="wrap">
            <a class="brand" asp-area="" asp-page="/Index">PMTTCU Tân Trụ</a>
            <nav aria-label="Chính">
                <ul class="nav-list">
                    <li><a asp-area="" asp-page="/Index">Trang chủ</a></li>
                    <li><a href="/lop-hoc">Lớp học</a></li>
                    <li><a href="/tin-tuc">Tin tức</a></li>
                    <li><a href="/su-kien">Sự kiện</a></li>
                    <li><a href="/thong-bao">Thông báo</a></li>
                    <li><a href="/van-ban">Văn bản</a></li>
                    <li><a href="/bieu-mau">Biểu mẫu</a></li>
                    <li><a href="/hoc-lieu">Học liệu số</a></li>
                    <li><a href="/thu-vien?loai=IMAGE">Hình ảnh</a></li>
                    <li><a href="/thu-vien?loai=VIDEO_LINK">Video</a></li>
                    <li><a href="/gioi-thieu">Giới thiệu</a></li>
                    <li><a href="/co-cau">Cơ cấu</a></li>
                    <li><a href="/van-hoa-the-thao">Văn hóa - Thể thao</a></li>
                    <li><a href="/lien-he">Liên hệ</a></li>
                    <li><a href="/tra-cuu">Tra cứu chứng nhận</a></li>
                    <li><a asp-area="" asp-page="/Privacy">Thông tin</a></li>
                    <li><a href="/admin">Quản trị</a></li>
                </ul>
            </nav>
        </div>
    </header>
    <main id="noi-dung" class="page">
        <div class="wrap">
            @RenderBody()
        </div>
    </main>
    <footer class="portal-footer">
        <div class="wrap">
            <p>Trung tâm cung ứng dịch vụ sự nghiệp công xã Tân Trụ</p>
            <a asp-area="" asp-page="/Privacy">Thông tin</a>
        </div>
    </footer>
</body>
</html>
