@page "/admin/khao-sat/{id:guid}/ket-qua"
@using System.Text.Json
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.KhaoSatKetQuaModel
@{
    ViewData["Title"] = "Kết quả khảo sát";
    ViewData["UseAdminCharts"] = true;
}
<section class="crm-page">
    <header class="crm-page-heading">
        <div>
            <p class="crm-eyebrow">Khảo sát &amp; báo cáo</p>
            <h1>Kết quả khảo sát</h1>
            <p class="crm-page-description">Bảng và biểu đồ theo từng câu hỏi.</p>
        </div>
        <a class="education-cancel-button" href="/admin/khao-sat/@Model.SurveyId/thiet-ke">Về thiết kế</a>
    </header>
    @if (Model.CanExport)
    {
        <p><a class="button" href="/admin/khao-sat/@Model.SurveyId/ket-qua?handler=Xuat">Xuất Excel</a></p>
    }
    @if (Model.Item is null)
    {
        <p class="empty">Chưa có số liệu.</p>
    }
    else
    {
        <p>Số phiếu: @Model.Item.Responses</p>
        @foreach (var question in Model.Item.Questions)
        {
            <section class="stack">
                <h2>@question.Text</h2>
                @if (question.Options.Count > 0)
                {
                    <div class="admin-chart-wrap"><canvas data-chart-kind="doughnut" data-chart="@JsonSerializer.Serialize(new { labels = question.Options.Select(option => option.Text), values = question.Options.Select(option => option.Count) })" role="img" aria-label="Biểu đồ tỷ trọng lựa chọn cho câu hỏi @question.Text">Biểu đồ lựa chọn khảo sát</canvas></div>
                    <div class="table-scroll"><table class="report-table"><caption>Kết quả lựa chọn: @question.Text</caption><thead><tr><th scope="col">Lựa chọn</th><th scope="col">Số phiếu</th></tr></thead><tbody>
                    @foreach (var option in question.Options)
                    {
                        <tr><th scope="row">@option.Text</th><td>@option.Count</td></tr>
                    }
                    </tbody></table></div>
                }
                @if (question.Scales.Count > 0)
                {
                    <div class="admin-chart-wrap"><canvas data-chart="@JsonSerializer.Serialize(new { labels = question.Scales.Select(scale => scale.Value.ToString()), values = question.Scales.Select(scale => scale.Count) })" role="img" aria-label="Biểu đồ thang điểm cho câu hỏi @question.Text">Biểu đồ thang điểm khảo sát</canvas></div>
                    <div class="table-scroll"><table class="report-table"><caption>Kết quả thang điểm: @question.Text</caption><thead><tr><th scope="col">Mức điểm</th><th scope="col">Số phiếu</th></tr></thead><tbody>
                    @foreach (var scale in question.Scales)
                    {
                        <tr><th scope="row">@scale.Value</th><td>@scale.Count</td></tr>
                    }
                    </tbody></table></div>
                }
                @foreach (var text in question.Texts)
                {
                    <p>@text</p>
                }
            </section>
        }
    }
</section>
