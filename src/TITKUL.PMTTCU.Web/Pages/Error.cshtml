@page
@model ErrorModel
@{
    ViewData["Title"] = "Lỗi";
}

<section class="card stack" role="alert">
    <h1>Đã xảy ra lỗi.</h1>
    <p>Yêu cầu chưa được xử lý xong.</p>
    @if (Model.ShowRequestId)
    {
        <p><strong>Mã theo dõi:</strong> <code>@Model.RequestId</code></p>
    }
</section>
