@page "/admin/cms/bai-viet"
@using TITKUL.PMTTCU.Web.Areas.Admin
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.CmsBaiVietModel
@{
    ViewData["Title"] = "Bài viết";
}

<section class="card stack">
    <h1>Bài viết</h1>
    @if (Model.CanEdit)
    {
        <p><a class="button" href="/admin/cms/bai-viet/sua">Viết bài mới</a></p>
    }
    <form class="public-filter" method="get" action="/admin/cms/bai-viet" role="search">
        <label for="admin-post-query">Tìm bài viết</label>
        <div><input id="admin-post-query" name="q" type="search" value="@Model.Query" placeholder="Tiêu đề hoặc từ khóa" /><button class="button" type="submit">Tìm</button></div>
    </form>
    @if (Model.Items.Count == 0)
    {
        <p class="empty">Chưa có bài viết.</p>
    }
    else
    {
        <div class="table-scroll">
            <table>
                <caption>Danh sách bài</caption>
                <thead>
                    <tr>
                        <th scope="col">Tiêu đề</th>
                        <th scope="col">Chuyên mục</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col">Ghim</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><a href="/admin/cms/bai-viet/sua/@item.Id">@item.Title</a></td>
                        <td>@item.CategoryName</td>
                        <td>@EducationUi.Status(item.Status)</td>
                        <td>@(item.Pinned ? "Có" : "")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
@await Html.PartialAsync("/Pages/Shared/_PublicPager.cshtml", new TITKUL.PMTTCU.Web.Pages.PublicPagerModel(Model.CurrentPage, Model.PageSize, Model.Total))
