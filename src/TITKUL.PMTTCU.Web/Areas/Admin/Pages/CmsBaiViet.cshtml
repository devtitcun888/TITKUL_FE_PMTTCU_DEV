@page "/admin/cms/bai-viet"
@using TITKUL.PMTTCU.Web.Areas.Admin
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.CmsBaiVietModel
@{
    ViewData["Title"] = Model.KindTitle;
    var returnUrl = Model.CurrentPathAndQuery;
    var firstPage = Math.Max(1, Model.CurrentPage - 2);
    var lastPage = Math.Min(Model.PageCount, Model.CurrentPage + 2);
}

<section class="crm-page cms-posts-page cms-list-page">

    <nav class="cms-domain-tabs" aria-label="Phân hệ nội dung">
        <a class="@(Model.KindFilter == "TIN_TUC" ? "is-active" : null)" href="/admin/cms/bai-viet?kind=TIN_TUC">Tin tức - sự kiện</a>
        <a class="@(Model.KindFilter == "HUONG_DAN_SO" ? "is-active" : null)" href="/admin/cms/bai-viet?kind=HUONG_DAN_SO">Bình dân học vụ số</a>
        <a class="@(Model.KindFilter == "CHUONG_TRINH_HOC" ? "is-active" : null)" href="/admin/cms/bai-viet?kind=CHUONG_TRINH_HOC">Bài giới thiệu khóa học</a>
    </nav>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="crm-alert" role="alert">@Model.ErrorMessage</p>
    }

    <form class="cms-posts-toolbar" method="get" action="/admin/cms/bai-viet" role="search" data-cms-autofilter>
        <input type="hidden" name="kind" value="@Model.KindFilter" />
        @if (!string.IsNullOrWhiteSpace(Model.Sort))
        {
            <input type="hidden" name="sort" value="@Model.Sort" />
            @if (Model.Dir == "desc") { <input type="hidden" name="dir" value="desc" /> }
        }
        <button class="cms-posts-filter-toggle @(Model.FiltersActive ? "has-active-filters" : null)" type="button" aria-label="Bộ lọc" aria-expanded="false" aria-controls="cms-posts-filter-fields" data-cms-filter-toggle>
            <svg class="cms-posts-filter-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M4 5h16l-6.5 7.5v5l-3 1.5v-6.5L4 5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
        <div class="cms-posts-filter-fields" id="cms-posts-filter-fields">
            <label class="cms-posts-field">
                <span>Từ khóa</span>
                <span class="cms-posts-search">
                    <span class="material-symbols-outlined" aria-hidden="true">search</span>
                    <input id="admin-post-query" name="q" type="search" value="@Model.Query" placeholder="Tiêu đề hoặc từ khóa" />
                </span>
            </label>
            <label class="cms-posts-field">
                <span>Chuyên mục</span>
                <select name="categoryId" data-cms-filter>
                    <option value="">Tất cả chuyên mục</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id ? "selected" : null)">@cat.Name</option>
                    }
                </select>
            </label>
            <label class="cms-posts-field">
                <span>Trạng thái</span>
                <select name="status" data-cms-filter>
                    <option value="">Tất cả trạng thái</option>
                    <option value="PUBLISHED" selected="@(Model.Status == "PUBLISHED" ? "selected" : null)">Đã đăng</option>
                    <option value="DRAFT" selected="@(Model.Status == "DRAFT" ? "selected" : null)">Bản nháp</option>
                    <option value="ARCHIVED" selected="@(Model.Status == "ARCHIVED" ? "selected" : null)">Lưu trữ</option>
                </select>
            </label>
            <label class="cms-posts-field cms-posts-pin-filter">
                <span>Chỉ bài đã ghim</span>
                <span class="cms-posts-switch">
                    <input type="checkbox" name="pinned" value="1" checked="@(Model.PinnedOnly ? "checked" : null)" data-cms-filter />
                    <span class="cms-posts-switch-ui" aria-hidden="true"></span>
                    <span>Chỉ hiển thị bài đã ghim</span>
                </span>
            </label>
            <div class="cms-posts-toolbar-actions">
                <a class="cms-posts-reset" href="/admin/cms/bai-viet?kind=@Model.KindFilter">
                    <span class="material-symbols-outlined" aria-hidden="true">restart_alt</span>
                    Xóa lọc
                </a>
            </div>
        </div>
    </form>

    <section class="cms-posts-kpis" aria-label="Thống kê bài viết">
        <a class="cms-posts-kpi is-all @(Model.Status is null && !Model.PinnedOnly ? "is-current" : null)" href="@Model.ListUrl(page: 1, status: "", pinned: false)">
            <span class="cms-posts-kpi-icon" aria-hidden="true"><span class="material-symbols-outlined">article</span></span>
            <span>
                <span class="cms-posts-kpi-label">Tất cả</span>
                <strong>@Model.TotalAll.ToString("N0")</strong>
            </span>
        </a>
        <a class="cms-posts-kpi is-published @(Model.Status == "PUBLISHED" && !Model.PinnedOnly ? "is-current" : null)" href="@Model.ListUrl(page: 1, status: "PUBLISHED", pinned: false)">
            <span class="cms-posts-kpi-icon" aria-hidden="true"><span class="cms-posts-dot"></span></span>
            <span>
                <span class="cms-posts-kpi-label">Đã đăng</span>
                <strong>@Model.TotalPublished.ToString("N0")</strong>
            </span>
        </a>
        <a class="cms-posts-kpi is-draft @(Model.Status == "DRAFT" && !Model.PinnedOnly ? "is-current" : null)" href="@Model.ListUrl(page: 1, status: "DRAFT", pinned: false)">
            <span class="cms-posts-kpi-icon" aria-hidden="true"><span class="material-symbols-outlined">description</span></span>
            <span>
                <span class="cms-posts-kpi-label">Bản nháp</span>
                <strong>@Model.TotalDraft.ToString("N0")</strong>
            </span>
        </a>
        <a class="cms-posts-kpi is-pinned @(Model.PinnedOnly ? "is-current" : null)" href="@Model.ListUrl(page: 1, status: "", pinned: true)">
            <span class="cms-posts-kpi-icon" aria-hidden="true"><span class="material-symbols-outlined">keep</span></span>
            <span>
                <span class="cms-posts-kpi-label">Đã ghim</span>
                <strong>@Model.TotalPinned.ToString("N0")</strong>
            </span>
        </a>
    </section>

    <section class="cms-posts-list" aria-labelledby="post-table-title">
        <header class="cms-posts-list-heading">
            <div>
                <h2 id="post-table-title">@Model.KindTitle</h2>
                <p>@Model.Total.ToString("N0") bài viết</p>
            </div>
            <div class="cms-posts-list-actions">
                @if (Model.CanEdit)
                {
                    <a class="crm-primary-button cms-posts-create" href="/admin/cms/bai-viet/sua?kind=@Model.KindFilter"><span class="material-symbols-outlined" aria-hidden="true">add</span> Thêm nội dung</a>
                }
                @if (Model.CanUpdate || Model.CanPublish)
                {
                    <details class="cms-posts-bulk">
                        <summary>Thao tác hàng loạt <span class="material-symbols-outlined" aria-hidden="true">expand_more</span></summary>
                        <div class="cms-posts-bulk-menu" role="menu">
                            @if (Model.CanPublish)
                            {
                                <button class="cms-posts-menu-btn" type="submit" form="cms-posts-bulk" name="action" value="publish" role="menuitem">Đăng bài đã chọn</button>
                                <button class="cms-posts-menu-btn" type="submit" form="cms-posts-bulk" name="action" value="unpublish" role="menuitem">Gỡ đăng đã chọn</button>
                            }
                            @if (Model.CanUpdate)
                            {
                                <button class="cms-posts-menu-btn" type="submit" form="cms-posts-bulk" name="action" value="pin" role="menuitem">Ghim bài đã chọn</button>
                                <button class="cms-posts-menu-btn" type="submit" form="cms-posts-bulk" name="action" value="unpin" role="menuitem">Bỏ ghim đã chọn</button>
                            }
                        </div>
                    </details>
                }
            </div>
        </header>

        @if (Model.Items.Count == 0)
        {
            <div class="cms-posts-empty">
                <span class="material-symbols-outlined" aria-hidden="true">article</span>
                <strong>@(Model.FiltersActive ? "Không tìm thấy bài viết phù hợp" : "Chưa có bài viết")</strong>
                <p>@(Model.FiltersActive ? "Thử xóa bộ lọc hoặc đổi từ khóa." : "Viết bài mới để hiển thị trên trang tin tức.")</p>
            </div>
        }
        else
        {
            <div class="cms-posts-table-scroll">
                <table class="cms-posts-table cms-posts-table-article">
                    <thead>
                        <tr>
                            <th class="cms-posts-check" scope="col">
                                <input type="checkbox" data-cms-posts-check-all form="cms-posts-bulk" aria-label="Chọn tất cả bài trên trang" />
                            </th>
                            <th scope="col">
                                <a class="cms-posts-sort @(Model.Sort == "title" ? "is-active is-" + Model.Dir : null)" href="@Model.SortUrl("title")">Tiêu đề <span class="material-symbols-outlined" aria-hidden="true">@(Model.Sort == "title" ? (Model.Dir == "desc" ? "expand_more" : "expand_less") : "swap_vert")</span></a>
                            </th>
                            <th scope="col">
                                <a class="cms-posts-sort @(Model.Sort == "category" ? "is-active is-" + Model.Dir : null)" href="@Model.SortUrl("category")">Chuyên mục <span class="material-symbols-outlined" aria-hidden="true">swap_vert</span></a>
                            </th>
                            <th scope="col">
                                <a class="cms-posts-sort @(Model.Sort == "status" ? "is-active is-" + Model.Dir : null)" href="@Model.SortUrl("status")">Trạng thái <span class="material-symbols-outlined" aria-hidden="true">swap_vert</span></a>
                            </th>
                            <th scope="col" class="cms-posts-pin-col">
                                <a class="cms-posts-sort @(Model.Sort == "pinned" ? "is-active is-" + Model.Dir : null)" href="@Model.SortUrl("pinned")">Ghim <span class="material-symbols-outlined" aria-hidden="true">swap_vert</span></a>
                            </th>
                            <th scope="col">
                                <a class="cms-posts-sort @(Model.Sort == "updated" ? "is-active is-" + Model.Dir : null)" href="@Model.SortUrl("updated")">Cập nhật <span class="material-symbols-outlined" aria-hidden="true">swap_vert</span></a>
                            </th>
                            <th class="cms-posts-actions-col" scope="col">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var statusClass = item.Status?.ToLowerInvariant();
                        <tr>
                            <td class="cms-posts-check">
                                <input form="cms-posts-bulk" type="checkbox" name="ids" value="@item.Id" aria-label="Chọn bài @item.Title" />
                            </td>
                            <td class="cms-posts-title-cell">
                                <a href="/admin/cms/bai-viet/sua/@item.Id?kind=@Model.KindFilter">@item.Title</a>
                            </td>
                            <td>
                                <span class="cms-posts-category">@item.CategoryName</span>
                            </td>
                            <td>
                                <span class="cms-posts-status is-@statusClass"><i aria-hidden="true"></i>@Model.StatusLabel(item.Status)</span>
                            </td>
                            <td class="cms-posts-pin-col">
                                @if (Model.CanUpdate)
                                {
                                    <form method="post" asp-page-handler="Pin" class="cms-posts-icon-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="pinned" value="@((!item.Pinned).ToString().ToLowerInvariant())" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button type="submit" class="cms-posts-pin @(item.Pinned ? "is-on" : null)" title="@(item.Pinned ? "Bỏ ghim" : "Ghim bài")" aria-label="@(item.Pinned ? "Bỏ ghim " + item.Title : "Ghim " + item.Title)">
                                            <span class="material-symbols-outlined" aria-hidden="true">keep</span>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="cms-posts-pin @(item.Pinned ? "is-on" : null)" aria-hidden="true"><span class="material-symbols-outlined">keep</span></span>
                                }
                            </td>
                            <td class="cms-posts-stamp">@Model.FormatStamp(item.PublishedAt)</td>
                            <td class="cms-posts-actions-col">
                                <details class="cms-posts-row-menu">
                                    <summary aria-label="Thao tác @item.Title"><span class="material-symbols-outlined" aria-hidden="true">more_horiz</span></summary>
                                    <div class="cms-posts-row-panel" role="menu">
                                        <a role="menuitem" href="/admin/cms/bai-viet/sua/@item.Id?kind=@Model.KindFilter">Sửa bài</a>
                                        <a role="menuitem" href="/admin/cms/bai-viet/sua/@item.Id?kind=@Model.KindFilter&amp;preview=true" target="_blank" rel="noopener">Xem trước</a>
                                        @if (Model.CanUpdate)
                                        {
                                            <button class="cms-posts-menu-btn" type="submit" form="cms-posts-pin-@item.Id" role="menuitem">@(item.Pinned ? "Bỏ ghim" : "Ghim bài")</button>
                                        }
                                        @if (Model.CanPublish && item.Status != "PUBLISHED")
                                        {
                                            <button class="cms-posts-menu-btn" type="submit" form="cms-posts-publish-@item.Id" role="menuitem">Đăng bài</button>
                                        }
                                        @if (Model.CanPublish && item.Status == "PUBLISHED")
                                        {
                                            <button class="cms-posts-menu-btn" type="submit" form="cms-posts-unpublish-@item.Id" role="menuitem">Gỡ đăng</button>
                                        }
                                    </div>
                                </details>
                                @if (Model.CanUpdate)
                                {
                                    <form id="cms-posts-pin-@item.Id" method="post" asp-page-handler="Pin" hidden>
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="pinned" value="@((!item.Pinned).ToString().ToLowerInvariant())" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    </form>
                                }
                                @if (Model.CanPublish && item.Status != "PUBLISHED")
                                {
                                    <form id="cms-posts-publish-@item.Id" method="post" asp-page-handler="Publish" hidden>
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    </form>
                                }
                                @if (Model.CanPublish && item.Status == "PUBLISHED")
                                {
                                    <form id="cms-posts-unpublish-@item.Id" method="post" asp-page-handler="Unpublish" hidden>
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        <footer class="cms-posts-pager">
            <p class="cms-posts-pager-summary">
                @(Model.Total == 0 ? "Không có bài viết" : $"Hiển thị {Model.FromItem} - {Model.ToItem} của {Model.Total} bài viết")
            </p>
            <div class="cms-posts-pager-controls">
                <form method="get" action="/admin/cms/bai-viet" class="cms-posts-pagesize">
                    @if (!string.IsNullOrWhiteSpace(Model.Query)) { <input type="hidden" name="q" value="@Model.Query" /> }
                    @if (!string.IsNullOrWhiteSpace(Model.Status)) { <input type="hidden" name="status" value="@Model.Status" /> }
                    @if (Model.CategoryId is Guid catId) { <input type="hidden" name="categoryId" value="@catId" /> }
                    @if (Model.PinnedOnly) { <input type="hidden" name="pinned" value="1" /> }
                    @if (!string.IsNullOrWhiteSpace(Model.Sort))
                    {
                        <input type="hidden" name="sort" value="@Model.Sort" />
                        @if (Model.Dir == "desc") { <input type="hidden" name="dir" value="desc" /> }
                    }
                    <label>
                        <span class="visually-hidden">Số bài mỗi trang</span>
                        <select name="pageSize" data-cms-posts-pagesize>
                            <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10 / trang</option>
                            <option value="20" selected="@(Model.PageSize == 20 ? "selected" : null)">20 / trang</option>
                            <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50 / trang</option>
                        </select>
                    </label>
                </form>
                <nav class="cms-posts-pages" aria-label="Phân trang bài viết">
                    @if (Model.CurrentPage > 1)
                    {
                        <a class="cms-posts-page-btn" href="@Model.ListUrl(page: Model.CurrentPage - 1)" rel="prev" aria-label="Trang trước"><span class="material-symbols-outlined" aria-hidden="true">chevron_left</span></a>
                    }
                    else
                    {
                        <span class="cms-posts-page-btn is-disabled" aria-hidden="true"><span class="material-symbols-outlined">chevron_left</span></span>
                    }
                    @for (var pageNumber = firstPage; pageNumber <= lastPage; pageNumber++)
                    {
                        if (pageNumber == Model.CurrentPage)
                        {
                            <span class="cms-posts-page-btn is-current" aria-current="page">@pageNumber</span>
                        }
                        else
                        {
                            <a class="cms-posts-page-btn" href="@Model.ListUrl(page: pageNumber)">@pageNumber</a>
                        }
                    }
                    @if (Model.CurrentPage < Model.PageCount)
                    {
                        <a class="cms-posts-page-btn" href="@Model.ListUrl(page: Model.CurrentPage + 1)" rel="next" aria-label="Trang sau"><span class="material-symbols-outlined" aria-hidden="true">chevron_right</span></a>
                    }
                    else
                    {
                        <span class="cms-posts-page-btn is-disabled" aria-hidden="true"><span class="material-symbols-outlined">chevron_right</span></span>
                    }
                </nav>
            </div>
        </footer>
    </section>
</section>

<form id="cms-posts-bulk" method="post" asp-page-handler="Bulk" hidden>
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@returnUrl" />
</form>

<script src="~/js/admin-cms-list.js" asp-append-version="true" defer></script>
