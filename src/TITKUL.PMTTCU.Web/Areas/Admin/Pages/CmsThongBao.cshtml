@page "/admin/cms/thong-bao"
@using TITKUL.PMTTCU.Web.Areas.Admin
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.CmsThongBaoModel
@{
    ViewData["Title"] = "Thông báo";
    var returnUrl = Model.CurrentPathAndQuery;
    var firstPage = Math.Max(1, Model.CurrentPage - 2);
    var lastPage = Math.Min(Model.PageCount, Model.CurrentPage + 2);
}

<section class="crm-page cms-posts-page cms-list-page">

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="crm-alert" role="alert">@Model.ErrorMessage</p>
    }

    <form class="cms-posts-toolbar" method="get" action="/admin/cms/thong-bao" role="search" data-cms-autofilter data-cols="2">
        @await Html.PartialAsync("Shared/_CmsSortHidden", (Model.Sort, Model.Dir))
        <button class="cms-posts-filter-toggle @(Model.FiltersActive ? "has-active-filters" : null)" type="button" aria-label="Bộ lọc" aria-expanded="false" aria-controls="cms-notice-filter-fields" data-cms-filter-toggle>
            <svg class="cms-posts-filter-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M4 5h16l-6.5 7.5v5l-3 1.5v-6.5L4 5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
        <div class="cms-posts-filter-fields" id="cms-notice-filter-fields">
            <label class="cms-posts-field">
                <span>Từ khóa</span>
                <span class="cms-posts-search">
                    <span class="material-symbols-outlined" aria-hidden="true">search</span>
                    <input id="admin-notice-query" name="q" type="search" value="@Model.Query" placeholder="Tiêu đề hoặc từ khóa" />
                </span>
            </label>
            <label class="cms-posts-field">
                <span>Trạng thái</span>
                <select name="status" data-cms-filter>
                    <option value="">Tất cả trạng thái</option>
                    <option value="PUBLISHED" selected="@(Model.Status == "PUBLISHED" ? "selected" : null)">Đã đăng</option>
                    <option value="DRAFT" selected="@(Model.Status == "DRAFT" ? "selected" : null)">Bản nháp</option>
                    <option value="ARCHIVED" selected="@(Model.Status == "ARCHIVED" ? "selected" : null)">Lưu trữ</option>
                </select>
            </label>
            <div class="cms-posts-toolbar-actions">
                <a class="cms-posts-reset" href="/admin/cms/thong-bao">
                    <span class="material-symbols-outlined" aria-hidden="true">restart_alt</span>
                    Xóa lọc
                </a>
            </div>
        </div>
    </form>

    <section class="cms-posts-kpis" data-cols="4" aria-label="Thống kê thông báo">
        <a class="cms-posts-kpi is-all @(Model.Status is null ? "is-current" : null)" href="@Model.ListUrl(page: 1, status: "")">
            <span class="cms-posts-kpi-icon" aria-hidden="true"><span class="material-symbols-outlined">campaign</span></span>
            <span>
                <span class="cms-posts-kpi-label">Tất cả</span>
                <strong>@Model.TotalAll.ToString("N0")</strong>
            </span>
        </a>
        <a class="cms-posts-kpi is-published @(Model.Status == "PUBLISHED" ? "is-current" : null)" href="@Model.ListUrl(page: 1, status: "PUBLISHED")">
            <span class="cms-posts-kpi-icon" aria-hidden="true"><span class="cms-posts-dot"></span></span>
            <span>
                <span class="cms-posts-kpi-label">Đã đăng</span>
                <strong>@Model.TotalPublished.ToString("N0")</strong>
            </span>
        </a>
        <a class="cms-posts-kpi is-draft @(Model.Status == "DRAFT" ? "is-current" : null)" href="@Model.ListUrl(page: 1, status: "DRAFT")">
            <span class="cms-posts-kpi-icon" aria-hidden="true"><span class="material-symbols-outlined">description</span></span>
            <span>
                <span class="cms-posts-kpi-label">Bản nháp</span>
                <strong>@Model.TotalDraft.ToString("N0")</strong>
            </span>
        </a>
        <a class="cms-posts-kpi is-cancelled @(Model.Status == "ARCHIVED" ? "is-current" : null)" href="@Model.ListUrl(page: 1, status: "ARCHIVED")">
            <span class="cms-posts-kpi-icon" aria-hidden="true"><span class="material-symbols-outlined">keep</span></span>
            <span>
                <span class="cms-posts-kpi-label">Lưu trữ</span>
                <strong>@Model.TotalArchived.ToString("N0")</strong>
            </span>
        </a>
    </section>

    <section class="cms-posts-list" aria-labelledby="notice-table-title">
        <header class="cms-posts-list-heading">
            <div>
                <h2 id="notice-table-title">Danh sách thông báo</h2>
                <p>@Model.Total.ToString("N0") thông báo</p>
            </div>
            <div class="cms-posts-list-actions">
                @if (Model.CanEdit)
                {
                    <a class="crm-primary-button cms-posts-create" href="/admin/cms/thong-bao/sua"><span class="material-symbols-outlined" aria-hidden="true">add</span> Tạo thông báo</a>
                }
            </div>
        </header>

        @if (Model.Items.Count == 0)
        {
            <div class="cms-posts-empty">
                <span class="material-symbols-outlined" aria-hidden="true">campaign</span>
                <strong>@(Model.FiltersActive ? "Không tìm thấy thông báo phù hợp" : "Chưa có thông báo")</strong>
                <p>@(Model.FiltersActive ? "Thử xóa bộ lọc hoặc đổi từ khóa." : "Tạo thông báo để hiện banner hoặc danh sách công khai.")</p>
            </div>
        }
        else
        {
            <div class="cms-posts-table-scroll">
                <table class="cms-posts-table">
                    <thead>
                        <tr>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "title", Model.Dir)" href="@Model.SortUrl("title")">Tiêu đề <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "title", Model.Dir)</span></a></th>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "level", Model.Dir)" href="@Model.SortUrl("level")">Mức <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "level", Model.Dir)</span></a></th>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "status", Model.Dir)" href="@Model.SortUrl("status")">Trạng thái <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "status", Model.Dir)</span></a></th>
                            <th class="cms-posts-actions-col" scope="col">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var statusClass = item.Status?.ToLowerInvariant();
                        var levelClass = item.Level == "URGENT" ? "is-urgent" : "is-draft";
                        <tr>
                            <td class="cms-posts-title-cell">
                                <a href="/admin/cms/thong-bao/sua/@item.Id">@item.Title</a>
                            </td>
                            <td>
                                <span class="cms-posts-status @levelClass"><i aria-hidden="true"></i>@EducationUi.Status(item.Level)</span>
                            </td>
                            <td>
                                <span class="cms-posts-status is-@statusClass"><i aria-hidden="true"></i>@Model.StatusLabel(item.Status)</span>
                            </td>
                            <td class="cms-posts-actions-col">
                                <details class="cms-posts-row-menu">
                                    <summary aria-label="Thao tác @item.Title"><span class="material-symbols-outlined" aria-hidden="true">more_horiz</span></summary>
                                    <div class="cms-posts-row-panel" role="menu">
                                        <a role="menuitem" href="/admin/cms/thong-bao/sua/@item.Id">Sửa</a>
                                        <a role="menuitem" href="/admin/cms/thong-bao/sua/@item.Id?preview=true" target="_blank" rel="noopener">Xem trước</a>
                                        @if (Model.CanPublish && item.Status != "PUBLISHED")
                                        {
                                            <button class="cms-posts-menu-btn" type="submit" form="cms-notice-publish-@item.Id" role="menuitem">Đăng thông báo</button>
                                        }
                                        @if (Model.CanPublish && item.Status == "PUBLISHED")
                                        {
                                            <button class="cms-posts-menu-btn" type="submit" form="cms-notice-archive-@item.Id" role="menuitem">Lưu trữ</button>
                                        }
                                    </div>
                                </details>
                                @if (Model.CanPublish && item.Status != "PUBLISHED")
                                {
                                    <form id="cms-notice-publish-@item.Id" method="post" asp-page-handler="Publish" hidden>
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    </form>
                                }
                                @if (Model.CanPublish && item.Status == "PUBLISHED")
                                {
                                    <form id="cms-notice-archive-@item.Id" method="post" asp-page-handler="Archive" hidden>
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        <footer class="cms-posts-pager">
            <p class="cms-posts-pager-summary">
                @(Model.Total == 0 ? "Không có thông báo" : $"Hiển thị {Model.FromItem} - {Model.ToItem} của {Model.Total} thông báo")
            </p>
            <div class="cms-posts-pager-controls">
                <form method="get" action="/admin/cms/thong-bao" class="cms-posts-pagesize">
                    @if (!string.IsNullOrWhiteSpace(Model.Query)) { <input type="hidden" name="q" value="@Model.Query" /> }
                    @if (!string.IsNullOrWhiteSpace(Model.Status)) { <input type="hidden" name="status" value="@Model.Status" /> }
                    @await Html.PartialAsync("Shared/_CmsSortHidden", (Model.Sort, Model.Dir))
                    <label>
                        <span class="visually-hidden">Số thông báo mỗi trang</span>
                        <select name="pageSize" data-cms-posts-pagesize>
                            <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10 / trang</option>
                            <option value="20" selected="@(Model.PageSize == 20 ? "selected" : null)">20 / trang</option>
                            <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50 / trang</option>
                        </select>
                    </label>
                </form>
                <nav class="cms-posts-pages" aria-label="Phân trang thông báo">
                    @if (Model.CurrentPage > 1)
                    {
                        <a class="cms-posts-page-btn" href="@Model.ListUrl(page: Model.CurrentPage - 1)" rel="prev" aria-label="Trang trước"><span class="material-symbols-outlined" aria-hidden="true">chevron_left</span></a>
                    }
                    else
                    {
                        <span class="cms-posts-page-btn is-disabled" aria-hidden="true"><span class="material-symbols-outlined">chevron_left</span></span>
                    }
                    @for (var pageNumber = firstPage; pageNumber <= lastPage; pageNumber++)
                    {
                        if (pageNumber == Model.CurrentPage)
                        {
                            <span class="cms-posts-page-btn is-current" aria-current="page">@pageNumber</span>
                        }
                        else
                        {
                            <a class="cms-posts-page-btn" href="@Model.ListUrl(page: pageNumber)">@pageNumber</a>
                        }
                    }
                    @if (Model.CurrentPage < Model.PageCount)
                    {
                        <a class="cms-posts-page-btn" href="@Model.ListUrl(page: Model.CurrentPage + 1)" rel="next" aria-label="Trang sau"><span class="material-symbols-outlined" aria-hidden="true">chevron_right</span></a>
                    }
                    else
                    {
                        <span class="cms-posts-page-btn is-disabled" aria-hidden="true"><span class="material-symbols-outlined">chevron_right</span></span>
                    }
                </nav>
            </div>
        </footer>
    </section>
</section>

<script src="~/js/admin-cms-list.js" asp-append-version="true" defer></script>
