@page "/admin/xoa-mu-chu"
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.XoaMuChuModel
@{
    ViewData["Title"] = "Sổ theo dõi xóa mù chữ";
}
<section class="card stack admin-education-page">
    <h1>Sổ theo dõi xóa mù chữ</h1>
    <p>Ghi nhận người học và năm đạt các cấp độ đúng theo biểu mẫu. Không yêu cầu xác minh hay minh chứng.</p>
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <p class="alert" role="alert">@Model.ErrorMessage</p> }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) { <p class="status-note" role="status">@Model.SuccessMessage</p> }
    <section class="card stack">
        <div class="row-actions"><h2>Nhập từ biểu mẫu</h2><a class="button button-quiet" href="/admin/xoa-mu-chu?handler=Export">Xuất Excel</a></div>
        <form method="post" enctype="multipart/form-data" asp-page-handler="Import" class="row-actions">
            <label for="importFile">Workbook .xlsx</label><input id="importFile" name="ImportFile" type="file" accept=".xlsx" required /><button type="submit">Nhập dữ liệu</button>
        </form>
    </section>
    <details class="card stack" open="@(Model.EntryId.HasValue ? "open" : null)">
        <summary>@(Model.EntryId.HasValue ? "Sửa dòng theo dõi" : "Thêm dòng thủ công")</summary>
        <form method="post" asp-page-handler="SaveEntry" class="stack">
            @if (Model.EntryId is Guid entryId) { <input type="hidden" name="EntryId" value="@entryId" /> }
            <div class="row-actions">
                <div><label for="sourceSheet">Sheet nguồn</label><input id="sourceSheet" name="SourceSheet" value="@Model.SourceSheet" maxlength="100" /></div>
                <div><label for="sequence">STT</label><input id="sequence" name="Sequence" type="number" min="0" value="@Model.Sequence" /></div>
                <div><label for="familyName">Họ và</label><input id="familyName" name="FamilyName" value="@Model.FamilyName" maxlength="180" /></div>
                <div><label for="givenName">Tên</label><input id="givenName" name="GivenName" value="@Model.GivenName" maxlength="180" /></div>
                <div><label for="female">Nữ</label><select id="female" name="Female"><option value="false" selected="@(!Model.Female ? "selected" : null)">Không</option><option value="true" selected="@(Model.Female ? "selected" : null)">Có</option></select></div>
            </div>
            <div class="row-actions">
                <div><label for="occupation">Nghề nghiệp</label><input id="occupation" name="Occupation" value="@Model.Occupation" maxlength="240" /></div>
                <div><label for="position">Chức vụ</label><input id="position" name="Position" value="@Model.Position" maxlength="180" /></div>
                <div><label for="address">Địa chỉ</label><input id="address" name="Address" value="@Model.Address" maxlength="500" /></div>
            </div>
            <fieldset class="stack"><legend>Năm đạt trình độ học vấn</legend>
                <div class="row-actions">
                    <div><label for="illiterateYear">Mù chữ</label><input id="illiterateYear" name="IlliterateYear" type="number" value="@Model.IlliterateYear" /></div>
                    <div><label for="grade1Year">Lớp 1</label><input id="grade1Year" name="Grade1Year" type="number" value="@Model.Grade1Year" /></div>
                    <div><label for="grade2Year">Lớp 2</label><input id="grade2Year" name="Grade2Year" type="number" value="@Model.Grade2Year" /></div>
                    <div><label for="grade3Year">Lớp 3</label><input id="grade3Year" name="Grade3Year" type="number" value="@Model.Grade3Year" /></div>
                    <div><label for="literateYear">Biết chữ</label><input id="literateYear" name="LiterateYear" type="number" value="@Model.LiterateYear" /></div>
                    <div><label for="grade4Year">Lớp 4</label><input id="grade4Year" name="Grade4Year" type="number" value="@Model.Grade4Year" /></div>
                    <div><label for="grade5Year">Lớp 5</label><input id="grade5Year" name="Grade5Year" type="number" value="@Model.Grade5Year" /></div>
                    <div><label for="primaryCompleteYear">HTCTTH</label><input id="primaryCompleteYear" name="PrimaryCompleteYear" type="number" value="@Model.PrimaryCompleteYear" /></div>
                </div>
            </fieldset>
            <div><label for="note">Ghi chú</label><input id="note" name="Note" value="@Model.Note" /></div>
            <button type="submit">@(Model.EntryId.HasValue ? "Lưu dòng" : "Thêm dòng")</button>
        </form>
    </details>
    <div class="table-scroll"><table>
        <caption>@Model.Entries.Count dòng sổ theo dõi</caption>
        <thead><tr><th>Sheet</th><th>STT</th><th>Họ và tên</th><th>Nữ</th><th>Nghề nghiệp</th><th>Chức vụ</th><th>Địa chỉ</th><th>Mù chữ</th><th>Lớp 1</th><th>Lớp 2</th><th>Lớp 3</th><th>Biết chữ</th><th>Lớp 4</th><th>Lớp 5</th><th>HTCTTH</th><th>Ghi chú</th><th>Thao tác</th></tr></thead>
        <tbody>
            @if (Model.Entries.Count == 0) { <tr><td colspan="17">Chưa có dòng theo dõi.</td></tr> }
            @foreach (var item in Model.Entries)
            {
                <tr><td>@item.SourceSheet</td><td>@item.Sequence</td><td>@item.FamilyName @item.GivenName</td><td>@(item.Female ? "X" : "")</td><td>@item.Occupation</td><td>@item.Position</td><td>@item.Address</td><td>@item.IlliterateYear</td><td>@item.Grade1Year</td><td>@item.Grade2Year</td><td>@item.Grade3Year</td><td>@item.LiterateYear</td><td>@item.Grade4Year</td><td>@item.Grade5Year</td><td>@item.PrimaryCompleteYear</td><td>@item.Note</td><td class="row-actions"><a href="/admin/xoa-mu-chu?entryId=@item.Id">Sửa</a><form method="post" asp-page-handler="DeleteEntry"><input type="hidden" name="entryId" value="@item.Id" /><button type="submit" class="button-quiet">Xóa</button></form></td></tr>
            }
        </tbody>
    </table></div>
</section>
