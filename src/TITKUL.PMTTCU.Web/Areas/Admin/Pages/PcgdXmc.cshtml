@page "/admin/pcgd-xmc"
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.PcgdXmcModel
@{
    ViewData["Title"] = "Điều tra PCGD/XMC";
}
<section class="card stack admin-education-page">
    <h1>Điều tra phổ cập giáo dục, xóa mù chữ</h1>
    <p>Quản lý theo đợt; tên địa bàn được giữ nguyên dưới dạng văn bản từ biểu mẫu. Chưa ánh xạ sang mã địa bàn.</p>
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <p class="alert" role="alert">@Model.ErrorMessage</p> }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) { <p class="status-note" role="status">@Model.SuccessMessage</p> }
    <section class="card stack">
        <h2>Tạo đợt điều tra</h2>
        <form method="post" asp-page-handler="CreateRound" class="row-actions">
            <div><label for="year">Năm</label><input id="year" name="Year" type="number" min="1" max="9999" value="@Model.Year" /></div>
            <div><label for="roundTitle">Tên đợt</label><input id="roundTitle" name="RoundTitle" maxlength="240" required placeholder="Điều tra PCGD/XMC năm ..." /></div>
            <button type="submit">Tạo đợt</button>
        </form>
    </section>
    <div class="table-scroll"><table>
        <caption>Các đợt điều tra PCGD/XMC</caption>
        <thead><tr><th>Năm</th><th>Tên đợt</th><th>Ngày tạo</th><th>Thao tác</th></tr></thead>
        <tbody>
            @if (Model.Rounds.Count == 0) { <tr><td colspan="4">Chưa có đợt điều tra.</td></tr> }
            @foreach (var round in Model.Rounds) { <tr><td>@round.Year</td><td>@round.Title</td><td>@round.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td><a href="/admin/pcgd-xmc?id=@round.Id">Mở</a></td></tr> }
        </tbody>
    </table></div>
    @if (Model.SelectedRound is not null)
    {
        <section class="card stack">
            <div class="row-actions"><div><h2>@Model.SelectedRound.Title (@Model.SelectedRound.Year)</h2><p>@Model.Entries.Count dòng trong đợt.</p></div><a class="button button-quiet" href="/admin/pcgd-xmc?handler=Export&amp;id=@Model.SelectedRound.Id">Xuất Excel</a></div>
            <h3>Nhập biểu mẫu Excel</h3>
            <form method="post" enctype="multipart/form-data" asp-page-handler="Import" asp-route-id="@Model.SelectedRound.Id" class="row-actions">
                <label for="importFile">Workbook .xlsx</label><input id="importFile" name="ImportFile" type="file" accept=".xlsx" required /><button type="submit">Nhập dữ liệu</button>
            </form>
            <details class="stack" open="@(Model.EntryId.HasValue ? "open" : null)">
                <summary>@(Model.EntryId.HasValue ? "Sửa dòng" : "Thêm dòng thủ công")</summary>
                <form method="post" asp-page-handler="SaveEntry" asp-route-id="@Model.SelectedRound.Id" class="stack">
                    @if (Model.EntryId is Guid entryId) { <input type="hidden" name="EntryId" value="@entryId" /> }
                    <div class="row-actions">
                        <div><label for="sourceSheet">Sheet nguồn</label><input id="sourceSheet" name="SourceSheet" value="@Model.SourceSheet" maxlength="100" placeholder="BD / BH / BT / MANUAL" /></div>
                        <div><label for="sequence">STT</label><input id="sequence" name="Sequence" type="number" min="0" value="@Model.Sequence" /></div>
                        <div><label for="province">Tỉnh</label><input id="province" name="Province" value="@Model.Province" maxlength="240" /></div>
                        <div><label for="commune">Xã</label><input id="commune" name="Commune" value="@Model.Commune" maxlength="240" /></div>
                        <div><label for="hamlet">Ấp</label><input id="hamlet" name="Hamlet" value="@Model.Hamlet" maxlength="240" /></div>
                        <div><label for="surveyTime">Thời điểm điều tra</label><input id="surveyTime" name="SurveyTime" value="@Model.SurveyTime" maxlength="240" /></div>
                    </div>
                    <div class="row-actions">
                        <div><label for="familyName">Họ và</label><input id="familyName" name="FamilyName" value="@Model.FamilyName" maxlength="180" /></div>
                        <div><label for="givenName">Tên</label><input id="givenName" name="GivenName" value="@Model.GivenName" maxlength="180" /></div>
                        <div><label for="birthYear">Năm sinh</label><input id="birthYear" name="BirthYear" type="number" value="@Model.BirthYear" /></div>
                        <div><label for="female">Nữ</label><select id="female" name="Female"><option value="false" selected="@(!Model.Female ? "selected" : null)">Không</option><option value="true" selected="@(Model.Female ? "selected" : null)">Có</option></select></div>
                        <div><label for="educationLevel">Trình độ VH</label><input id="educationLevel" name="EducationLevel" value="@Model.EducationLevel" maxlength="240" /></div>
                        <div><label for="studyStatus">Đã nghỉ/đang học</label><input id="studyStatus" name="StudyStatus" value="@Model.StudyStatus" maxlength="120" /></div>
                    </div>
                    <div class="row-actions"><div><label for="address">Địa chỉ</label><input id="address" name="Address" value="@Model.Address" maxlength="500" /></div><div><label for="note">Ghi chú</label><input id="note" name="Note" value="@Model.Note" /></div></div>
                    <button type="submit">@(Model.EntryId.HasValue ? "Lưu dòng" : "Thêm dòng")</button>
                </form>
            </details>
            <div class="table-scroll"><table>
                <caption>Danh sách điều tra theo mẫu</caption>
                <thead><tr><th>Sheet</th><th>Ấp</th><th>STT</th><th>Họ và tên</th><th>Năm sinh</th><th>Nữ</th><th>Địa chỉ</th><th>Trình độ VH</th><th>Đã nghỉ/đang học</th><th>Ghi chú</th><th>Thao tác</th></tr></thead>
                <tbody>@foreach (var item in Model.Entries) { <tr><td>@item.SourceSheet</td><td>@item.Hamlet</td><td>@item.Sequence</td><td>@item.FamilyName @item.GivenName</td><td>@item.BirthYear</td><td>@(item.Female ? "X" : "")</td><td>@item.Address</td><td>@item.EducationLevel</td><td>@item.StudyStatus</td><td>@item.Note</td><td class="row-actions"><a href="/admin/pcgd-xmc?id=@item.RoundId&amp;entryId=@item.Id">Sửa</a><form method="post" asp-page-handler="DeleteEntry" asp-route-id="@item.RoundId"><input type="hidden" name="entryId" value="@item.Id" /><button type="submit" class="button-quiet">Xóa</button></form></td></tr> }</tbody>
            </table></div>
        </section>
    }
</section>
