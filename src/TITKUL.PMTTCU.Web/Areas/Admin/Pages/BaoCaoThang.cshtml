@page "/admin/bao-cao/thang"
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.BaoCaoThangModel
@{
    ViewData["Title"] = "Đối soát tháng";
}

<section class="crm-page">
    <header class="crm-page-heading">
        <div>
            <p class="crm-eyebrow">Khảo sát &amp; báo cáo</p>
            <h1>Đối soát báo cáo tháng</h1>
            <p class="crm-page-description">Sheet Tong hop ghi ba số KPI. Sheet Chi tiet ghi từng lớp, không gộp ô.</p>
        </div>
        <div class="crm-heading-actions">
            <a class="education-cancel-button" href="/admin/bao-cao?From=@Model.From&amp;To=@Model.To">Về chuyên cần</a>
            @if (Model.Item is not null)
            {
                <a class="crm-primary-button" href="/admin/bao-cao/thang?handler=Xuat&amp;From=@Model.From&amp;To=@Model.To">Tải Excel</a>
            }
        </div>
    </header>

    <section class="crm-toolbar" aria-label="Kỳ đối soát">
        <form method="get" class="crm-filter">
            <label for="month">Tháng
                <input id="month" name="Month" type="month" value="@Model.Month" />
            </label>
            <label for="from">Từ ngày
                <input id="from" name="From" type="date" value="@Model.From" />
            </label>
            <label for="to">Đến ngày
                <input id="to" name="To" type="date" value="@Model.To" />
            </label>
            <button class="crm-primary-button" type="submit">Áp dụng</button>
        </form>
    </section>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="crm-alert" role="alert">@Model.ErrorMessage</p>
    }

    @if (Model.Item is not null)
    {
        <section class="crm-kpi-grid" aria-label="Tóm tắt tháng">
            <article class="crm-kpi"><span>Lớp</span><strong>@Model.Item.Classes</strong></article>
            <article class="crm-kpi"><span>Học viên</span><strong>@Model.Item.Learners</strong></article>
            <article class="crm-kpi"><span>Chuyên cần</span><strong>@Model.Item.AttendancePercent.ToString("0.##")%</strong></article>
        </section>
    }
</section>
