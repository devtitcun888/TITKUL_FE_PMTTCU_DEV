@page "/dang-ky/{ma}"
@model DangKyLopModel
@{
    ViewData["Title"] = "Đăng ký lớp";
    ViewData["Robots"] = "noindex, nofollow, noarchive";
}

<section class="card stack public-detail-page">
    <p class="public-detail-back"><a href="/lop-hoc"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span> Về danh sách lớp</a></p>
    <header class="public-detail-heading">
        <p class="public-detail-eyebrow">Đăng ký học</p>
        <h1>Đăng ký lớp</h1>
    </header>
    @if (Model.Class is not null)
    {
        <p><strong>@Model.Class.Name</strong> · @Model.Class.ProgramName · còn @Model.Class.Remaining chỗ</p>
            <p><a href="/lop-hoc/@Uri.EscapeDataString(Model.Class.Code)">Xem chi tiết lớp</a></p>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="alert" role="alert">@Model.ErrorMessage</p>
    }
    @if (Model.SubmissionAcceptedWithoutCode)
    {
        <p class="status-note" role="status">@Model.SubmissionMessage</p>
    }
    @if (Model.Class is { CanRegister: true } && !Model.SubmissionAcceptedWithoutCode)
    {
        <form method="post" class="stack">
            <input type="hidden" name="IdempotencyKey" value="@Model.IdempotencyKey" />
            <div class="hp" aria-hidden="true">
                <label for="website">Trang web</label>
                <input id="website" name="Website" value="@Model.Website" tabindex="-1" autocomplete="off" />
            </div>
            <div>
                <label for="fullName">Họ tên</label>
                <input id="fullName" name="FullName" value="@Model.FullName" required maxlength="200" autocomplete="name" />
            </div>
            <div>
                <label for="phone">Số điện thoại</label>
                <input id="phone" name="Phone" value="@Model.Phone" required inputmode="tel" autocomplete="tel" />
            </div>
            <fieldset class="stack">
                <legend>Nhắc lịch buổi học (không bắt buộc)</legend>
                <p>Chỉ gửi nhắc trước 24 giờ và 1 giờ cho kênh bạn chọn.</p>
                <label><input type="checkbox" name="ReminderSms" value="true" checked="@(Model.ReminderSms ? "checked" : null)" /> SMS đến số điện thoại trên</label>
                <label><input type="checkbox" name="ReminderZalo" value="true" checked="@(Model.ReminderZalo ? "checked" : null)" /> Zalo đến số điện thoại trên</label>
                <div>
                    <label for="reminderEmail">Email nhắc lịch</label>
                    <input id="reminderEmail" name="ReminderEmail" type="email" value="@Model.ReminderEmail" maxlength="254" autocomplete="email" />
                </div>
                <label><input type="checkbox" name="ReminderEmailOptIn" value="true" checked="@(Model.ReminderEmailOptIn ? "checked" : null)" /> Nhận nhắc qua email</label>
            </fieldset>
            <div>
                <label for="citizenId">CCCD/CMND</label>
                <input id="citizenId" name="CitizenId" value="@Model.CitizenId" required inputmode="numeric" maxlength="12" />
            </div>
            <div>
                <label for="birthDate">Ngày sinh</label>
                <input id="birthDate" name="BirthDate" type="date" value="@Model.BirthDate?.ToString("yyyy-MM-dd")" required />
            </div>
            <div>
                <label for="gender">Giới tính</label>
                <select id="gender" name="Gender">
                    <option value="NAM" selected="@(Model.Gender == "NAM" ? "selected" : null)">Nam</option>
                    <option value="NU" selected="@(Model.Gender == "NU" ? "selected" : null)">Nữ</option>
                    <option value="KHAC" selected="@(Model.Gender == "KHAC" ? "selected" : null)">Khác</option>
                </select>
            </div>
            <fieldset class="stack">
                <legend>Địa chỉ</legend>
                <p>Mẫu: Số 123, đường Trương Gia Mô, Ấp Bình Hòa, @Model.Commune, @Model.Province.</p>
                <div>
                    <label for="houseNumber">Số nhà</label>
                    <input id="houseNumber" name="HouseNumber" value="@Model.HouseNumber" maxlength="40" autocomplete="address-line1" />
                </div>
                <div>
                    <label for="street">Tên đường</label>
                    <input id="street" name="Street" value="@Model.Street" maxlength="120" autocomplete="address-line2" />
                </div>
                @if (Model.Hamlets.Count > 0)
                {
                    <div>
                        <label for="hamletId">Ấp</label>
                        <select id="hamletId" name="HamletId" required>
                            <option value="">Chọn ấp</option>
                            @foreach (var hamlet in Model.Hamlets)
                            {
                                <option value="@hamlet.Id" selected="@(Model.HamletId == hamlet.Id ? "selected" : null)">@hamlet.Name</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <div>
                        <label for="hamletName">@(Model.HamletCatalogUnavailable ? "Ấp (danh mục tạm thời chưa tải được)" : "Ấp")</label>
                        <input id="hamletName" name="HamletName" value="@Model.HamletName" required maxlength="120" autocomplete="address-level3" />
                        <small>@(Model.HamletCatalogUnavailable ? "Bạn có thể nhập tên ấp để tiếp tục; hệ thống lưu nguyên văn." : "Danh mục ấp chưa tải được. Nhập tên gọi hiện có.")</small>
                    </div>
                }
                <p>@Model.Commune, @Model.Province.</p>
            </fieldset>
            <div>
                <label for="note">Ghi chú</label>
                <input id="note" name="Note" value="@Model.Note" maxlength="1000" />
            </div>
            <div>
                <label>
                    <input type="checkbox" name="Consent" value="true" required checked="@(Model.Consent ? "checked" : null)" />
                    Tôi đồng ý Trung tâm sử dụng dữ liệu này để quản lý lớp học.
                </label>
                <small><a href="/Privacy">Xem thông tin về dữ liệu và quyền riêng tư</a>.</small>
            </div>
            <button type="submit">Đăng ký lớp</button>
        </form>
    }
    else if (Model.Class is { CanRegister: false })
    {
        <p class="alert" role="status">Form không nhận đăng ký lúc này. @(Model.Class.ClosedReason == "EDU_FULL" ? "Lớp đã đủ chỗ." : "Lớp chưa mở, đã đóng hoặc hết hạn.")</p>
    }
</section>
