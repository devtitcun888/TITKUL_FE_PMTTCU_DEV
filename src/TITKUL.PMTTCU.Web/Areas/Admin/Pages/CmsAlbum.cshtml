@page "/admin/cms/album"
@using TITKUL.PMTTCU.Web.Areas.Admin
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.CmsAlbumModel
@{
    ViewData["Title"] = "Thư viện";
    var showModal = Model.CanEdit && (Request.Query.ContainsKey("create") || Request.HasFormContentType);
    var returnUrl = Model.CurrentPathAndQuery;
    var firstPage = Math.Max(1, Model.CurrentPage - 2);
    var lastPage = Math.Min(Model.PageCount, Model.CurrentPage + 2);
}

<section class="crm-page cms-posts-page cms-list-page">

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="crm-alert" role="alert">@Model.ErrorMessage</p>
    }

    <form class="cms-posts-toolbar" method="get" action="/admin/cms/album" data-cms-autofilter data-cols="1">
        @await Html.PartialAsync("Shared/_CmsSortHidden", (Model.Sort, Model.Dir))
        <button class="cms-posts-filter-toggle @(Model.FiltersActive ? "has-active-filters" : null)" type="button" aria-label="Bộ lọc" aria-expanded="false" aria-controls="cms-album-filter-fields" data-cms-filter-toggle>
            <svg class="cms-posts-filter-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M4 5h16l-6.5 7.5v5l-3 1.5v-6.5L4 5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
        <div class="cms-posts-filter-fields" id="cms-album-filter-fields">
            <label class="cms-posts-field">
                <span>Loại</span>
                <select name="kind" data-cms-filter>
                    <option value="">Tất cả</option>
                    <option value="IMAGE" selected="@(Model.FilterKind == "IMAGE" ? "selected" : null)">Ảnh</option>
                    <option value="VIDEO_LINK" selected="@(Model.FilterKind == "VIDEO_LINK" ? "selected" : null)">Video</option>
                    <option value="HOC_LIEU" selected="@(Model.FilterKind == "HOC_LIEU" ? "selected" : null)">Học liệu</option>
                </select>
            </label>
            <div class="cms-posts-toolbar-actions">
                <a class="cms-posts-reset" href="/admin/cms/album">
                    <span class="material-symbols-outlined" aria-hidden="true">restart_alt</span>
                    Xóa lọc
                </a>
            </div>
        </div>
    </form>

    <section class="cms-posts-kpis" data-cols="4" aria-label="Thống kê album">
        <a class="cms-posts-kpi is-all @(Model.FilterKind is null ? "is-current" : null)" href="@Model.ListUrl(page: 1, kind: "")">
            <span class="cms-posts-kpi-icon" aria-hidden="true"><span class="material-symbols-outlined">photo_library</span></span>
            <span>
                <span class="cms-posts-kpi-label">Tất cả</span>
                <strong>@Model.TotalAll.ToString("N0")</strong>
            </span>
        </a>
        <a class="cms-posts-kpi is-published @(Model.FilterKind == "IMAGE" ? "is-current" : null)" href="@Model.ListUrl(page: 1, kind: "IMAGE")">
            <span class="cms-posts-kpi-icon" aria-hidden="true"><span class="material-symbols-outlined">photo_library</span></span>
            <span>
                <span class="cms-posts-kpi-label">Ảnh</span>
                <strong>@Model.TotalImage.ToString("N0")</strong>
            </span>
        </a>
        <a class="cms-posts-kpi is-draft @(Model.FilterKind == "VIDEO_LINK" ? "is-current" : null)" href="@Model.ListUrl(page: 1, kind: "VIDEO_LINK")">
            <span class="cms-posts-kpi-icon" aria-hidden="true"><span class="material-symbols-outlined">visibility</span></span>
            <span>
                <span class="cms-posts-kpi-label">Video</span>
                <strong>@Model.TotalVideo.ToString("N0")</strong>
            </span>
        </a>
        <a class="cms-posts-kpi is-pinned @(Model.FilterKind == "HOC_LIEU" ? "is-current" : null)" href="@Model.ListUrl(page: 1, kind: "HOC_LIEU")">
            <span class="cms-posts-kpi-icon" aria-hidden="true"><span class="material-symbols-outlined">description</span></span>
            <span>
                <span class="cms-posts-kpi-label">Học liệu</span>
                <strong>@Model.TotalHocLieu.ToString("N0")</strong>
            </span>
        </a>
    </section>

    <section class="cms-posts-list" aria-labelledby="album-table-title">
        <header class="cms-posts-list-heading">
            <div>
                <h2 id="album-table-title">Danh sách album</h2>
                <p>@Model.Total.ToString("N0") album</p>
            </div>
            <div class="cms-posts-list-actions">
                @if (Model.CanEdit)
                {
                    <a class="crm-primary-button cms-posts-create" href="/admin/cms/album?create=true"><span class="material-symbols-outlined" aria-hidden="true">add</span> Tạo album</a>
                }
            </div>
        </header>

        @if (Model.Items.Count == 0)
        {
            <div class="cms-posts-empty">
                <span class="material-symbols-outlined" aria-hidden="true">photo_library</span>
                <strong>@(Model.FiltersActive ? "Không tìm thấy album phù hợp" : "Chưa có album")</strong>
                <p>@(Model.FiltersActive ? "Thử xóa bộ lọc." : "Tạo nháp rồi thêm ảnh hoặc liên kết video.")</p>
            </div>
        }
        else
        {
            <div class="cms-posts-table-scroll">
                <table class="cms-posts-table">
                    <thead>
                        <tr>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "title", Model.Dir)" href="@Model.SortUrl("title")">Tiêu đề <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "title", Model.Dir)</span></a></th>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "kind", Model.Dir)" href="@Model.SortUrl("kind")">Danh mục <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "kind", Model.Dir)</span></a></th>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "status", Model.Dir)" href="@Model.SortUrl("status")">Trạng thái <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "status", Model.Dir)</span></a></th>
                            <th class="cms-posts-actions-col" scope="col">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var statusClass = item.Status?.ToLowerInvariant();
                        <tr>
                            <td class="cms-posts-title-cell"><a href="/admin/cms/album/@item.Id">@item.Title</a></td>
                            <td><span class="cms-posts-category">@EducationUi.Status(item.Kind)</span></td>
                            <td><span class="cms-posts-status is-@statusClass"><i aria-hidden="true"></i>@EducationUi.Status(item.Status ?? "")</span></td>
                            <td class="cms-posts-actions-col">
                                <details class="cms-posts-row-menu">
                                    <summary aria-label="Thao tác @item.Title"><span class="material-symbols-outlined" aria-hidden="true">more_horiz</span></summary>
                                    <div class="cms-posts-row-panel" role="menu">
                                        <a role="menuitem" href="/admin/cms/album/@item.Id">Mở album</a>
                                        @if (Model.CanPublish && item.Status != "PUBLISHED")
                                        {
                                            <button class="cms-posts-menu-btn" type="submit" form="cms-album-publish-@item.Id" role="menuitem">Đăng</button>
                                        }
                                    </div>
                                </details>
                                @if (Model.CanPublish && item.Status != "PUBLISHED")
                                {
                                    <form id="cms-album-publish-@item.Id" method="post" asp-page-handler="Publish" hidden>
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        <footer class="cms-posts-pager">
            <p class="cms-posts-pager-summary">
                @(Model.Total == 0 ? "Không có album" : $"Hiển thị {Model.FromItem} - {Model.ToItem} của {Model.Total} album")
            </p>
            <div class="cms-posts-pager-controls">
                <form method="get" action="/admin/cms/album" class="cms-posts-pagesize">
                    @if (!string.IsNullOrWhiteSpace(Model.FilterKind)) { <input type="hidden" name="kind" value="@Model.FilterKind" /> }
                    @await Html.PartialAsync("Shared/_CmsSortHidden", (Model.Sort, Model.Dir))
                    <label>
                        <span class="visually-hidden">Số album mỗi trang</span>
                        <select name="pageSize" data-cms-posts-pagesize>
                            <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10 / trang</option>
                            <option value="20" selected="@(Model.PageSize == 20 ? "selected" : null)">20 / trang</option>
                            <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50 / trang</option>
                        </select>
                    </label>
                </form>
                <nav class="cms-posts-pages" aria-label="Phân trang album">
                    @if (Model.CurrentPage > 1)
                    {
                        <a class="cms-posts-page-btn" href="@Model.ListUrl(page: Model.CurrentPage - 1)" rel="prev" aria-label="Trang trước"><span class="material-symbols-outlined" aria-hidden="true">chevron_left</span></a>
                    }
                    else
                    {
                        <span class="cms-posts-page-btn is-disabled" aria-hidden="true"><span class="material-symbols-outlined">chevron_left</span></span>
                    }
                    @for (var pageNumber = firstPage; pageNumber <= lastPage; pageNumber++)
                    {
                        if (pageNumber == Model.CurrentPage)
                        {
                            <span class="cms-posts-page-btn is-current" aria-current="page">@pageNumber</span>
                        }
                        else
                        {
                            <a class="cms-posts-page-btn" href="@Model.ListUrl(page: pageNumber)">@pageNumber</a>
                        }
                    }
                    @if (Model.CurrentPage < Model.PageCount)
                    {
                        <a class="cms-posts-page-btn" href="@Model.ListUrl(page: Model.CurrentPage + 1)" rel="next" aria-label="Trang sau"><span class="material-symbols-outlined" aria-hidden="true">chevron_right</span></a>
                    }
                    else
                    {
                        <span class="cms-posts-page-btn is-disabled" aria-hidden="true"><span class="material-symbols-outlined">chevron_right</span></span>
                    }
                </nav>
            </div>
        </footer>
    </section>
</section>

@if (showModal)
{
    <dialog class="crm-modal" open data-close-href="/admin/cms/album" aria-labelledby="album-modal-title">
        <div class="crm-modal-backdrop"></div>
        <section class="crm-modal-panel">
            <header class="crm-modal-heading">
                <div><p class="crm-eyebrow">Thư viện</p><h2 id="album-modal-title">Tạo album nháp</h2></div>
                <a class="crm-modal-close" href="/admin/cms/album" aria-label="Đóng">×</a>
            </header>
            <form method="post" class="crm-modal-body">
                <div class="education-form-field"><label for="title">Tiêu đề <span>*</span></label><input id="title" name="Title" required maxlength="250" /></div>
                <div class="education-form-field">
                    <label for="kind">Danh mục</label>
                    <select id="kind" name="Kind">
                        <option value="IMAGE">Hình ảnh</option>
                        <option value="VIDEO_LINK">Video</option>
                        <option value="HOC_LIEU">Học liệu số chung</option>
                    </select>
                </div>
                <footer class="crm-modal-actions">
                    <a class="education-cancel-button" href="/admin/cms/album">Hủy</a>
                    <button class="crm-primary-button" type="submit">Tạo nháp</button>
                </footer>
            </form>
        </section>
    </dialog>
}

<script src="~/js/admin-cms-list.js" asp-append-version="true" defer></script>
