@page "/admin/cms/thong-bao"
@using TITKUL.PMTTCU.Web.Areas.Admin
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.CmsThongBaoModel
@{
    ViewData["Title"] = "Thông báo";
}

<section class="card stack">
    <h1>Thông báo</h1>
    <form class="public-filter" method="get" action="/admin/cms/thong-bao" role="search">
        <label for="admin-notice-query">Tìm thông báo</label>
        <div><input id="admin-notice-query" name="q" type="search" value="@Model.Query" placeholder="Tiêu đề hoặc từ khóa" /><button class="button" type="submit">Tìm</button></div>
    </form>
    @if (Model.CanEdit)
    {
        <p><a class="button" href="/admin/cms/thong-bao/sua">Tạo thông báo</a></p>
    }
    @if (Model.Items.Count == 0)
    {
        <p class="empty">Chưa có thông báo.</p>
    }
    else
    {
        <div class="table-scroll">
            <table>
                <caption>Danh sách thông báo</caption>
                <thead>
                    <tr>
                        <th scope="col">Tiêu đề</th>
                        <th scope="col">Mức</th>
                        <th scope="col">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><a href="/admin/cms/thong-bao/sua/@item.Id">@item.Title</a></td>
                        <td>@EducationUi.Status(item.Level)</td>
                        <td>@EducationUi.Status(item.Status)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
@await Html.PartialAsync("/Pages/Shared/_PublicPager.cshtml", new TITKUL.PMTTCU.Web.Pages.PublicPagerModel(Model.CurrentPage, Model.PageSize, Model.Total))
