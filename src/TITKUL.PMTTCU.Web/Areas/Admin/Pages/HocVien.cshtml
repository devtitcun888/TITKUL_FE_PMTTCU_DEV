@page "/admin/hoc-vien"
@using TITKUL.PMTTCU.Web.Areas.Admin
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.HocVienModel
@{
    ViewData["Title"] = "Học viên";
    var firstPage = Math.Max(1, Model.CurrentPage - 2);
    var lastPage = Math.Min(Model.PageCount, Model.CurrentPage + 2);
}

<section class="crm-page cms-posts-page cms-list-page">

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="crm-alert" role="alert">@Model.ErrorMessage</p>
    }

    <form class="cms-posts-toolbar" method="get" action="/admin/hoc-vien" role="search" data-cms-autofilter data-cols="3">
        @await Html.PartialAsync("Shared/_CmsSortHidden", (Model.Sort, Model.Dir))
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
        <button class="cms-posts-filter-toggle @(Model.FiltersActive ? "has-active-filters" : null)" type="button" aria-label="Bộ lọc" aria-expanded="false" aria-controls="edu-learner-filter-fields" data-cms-filter-toggle>
            <svg class="cms-posts-filter-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M4 5h16l-6.5 7.5v5l-3 1.5v-6.5L4 5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
        <div class="cms-posts-filter-fields" id="edu-learner-filter-fields">
            <label class="cms-posts-field">
                <span>Từ khóa</span>
                <span class="cms-posts-search">
                    <span class="material-symbols-outlined" aria-hidden="true">search</span>
                    <input name="q" type="search" value="@Model.Query" autocomplete="off" placeholder="Tên hoặc số điện thoại" />
                </span>
            </label>
            <label class="cms-posts-field">
                <span>Lớp</span>
                <select name="classId" data-cms-filter>
                    <option value="">Tất cả lớp</option>
                    @foreach (var cls in Model.Classes)
                    {
                        <option value="@cls.Id" selected="@(Model.ClassFilter == cls.Id ? "selected" : null)">@cls.Code — @cls.Name</option>
                    }
                </select>
            </label>
            <label class="cms-posts-field">
                <span>Thôn/ấp</span>
                <select name="hamletId" data-cms-filter>
                    <option value="">Tất cả thôn/ấp</option>
                    @foreach (var hamlet in Model.Hamlets)
                    {
                        <option value="@hamlet.Id" selected="@(Model.HamletFilter == hamlet.Id ? "selected" : null)">@hamlet.Name</option>
                    }
                </select>
            </label>
            <label class="cms-posts-field">
                <span>Tuổi từ</span>
                <input name="ageFrom" type="number" min="0" max="120" value="@Model.AgeFrom" data-cms-filter />
            </label>
            <label class="cms-posts-field">
                <span>Tuổi đến</span>
                <input name="ageTo" type="number" min="0" max="120" value="@Model.AgeTo" data-cms-filter />
            </label>
            <div class="cms-posts-toolbar-actions">
                <a class="cms-posts-reset" href="/admin/hoc-vien">
                    <span class="material-symbols-outlined" aria-hidden="true">restart_alt</span>
                    Xóa lọc
                </a>
            </div>
        </div>
    </form>

    <section class="cms-posts-list" aria-labelledby="learner-table-title">
        <header class="cms-posts-list-heading">
            <div>
                <h2 id="learner-table-title">Danh sách học viên</h2>
                <p>@Model.Total.ToString("N0") học viên</p>
            </div>
            <div class="cms-posts-list-actions">
                @if (Model.CanExport)
                {
                    <a class="crm-primary-button cms-posts-create" href="@Model.ExportUrl()"><span class="material-symbols-outlined" aria-hidden="true">download</span> Xuất Excel</a>
                }
            </div>
        </header>
        @if (Model.Items.Count == 0)
        {
            <div class="cms-posts-empty">
                <span class="material-symbols-outlined" aria-hidden="true">person</span>
                <strong>@(Model.FiltersActive ? "Không có học viên khớp bộ lọc" : "Chưa có học viên")</strong>
                <p>@(Model.FiltersActive ? "Đổi điều kiện tìm hoặc xóa lọc để xem toàn bộ." : "Học viên xuất hiện khi đăng ký lớp.")</p>
            </div>
        }
        else
        {
            <div class="cms-posts-table-scroll">
                <table class="cms-posts-table">
                    <thead>
                        <tr>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "name", Model.Dir)" href="@Model.SortUrl("name")">Họ tên <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "name", Model.Dir)</span></a></th>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "phone", Model.Dir)" href="@Model.SortUrl("phone")">Điện thoại <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "phone", Model.Dir)</span></a></th>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "age", Model.Dir)" href="@Model.SortUrl("age")">Tuổi <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "age", Model.Dir)</span></a></th>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "hamlet", Model.Dir)" href="@Model.SortUrl("hamlet")">Thôn/ấp <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "hamlet", Model.Dir)</span></a></th>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "status", Model.Dir)" href="@Model.SortUrl("status")">Trạng thái <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "status", Model.Dir)</span></a></th>
                            <th class="cms-posts-actions-col" scope="col">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var statusClass = item.Status is "DANG_KY" or "ACTIVE" ? "published" : item.Status is "HUY" ? "cancelled" : "draft";
                        <tr>
                            <td class="cms-posts-title-cell"><strong>@item.FullName</strong></td>
                            <td>@item.Phone</td>
                            <td>@item.Age</td>
                            <td>@item.HamletName</td>
                            <td><span class="cms-posts-status is-@statusClass"><i aria-hidden="true"></i>@EducationUi.Status(item.Status ?? "")</span></td>
                            <td class="cms-posts-actions-col">
                                <details class="cms-posts-row-menu">
                                    <summary aria-label="Thao tác @item.FullName"><span class="material-symbols-outlined" aria-hidden="true">more_horiz</span></summary>
                                    <div class="cms-posts-row-panel" role="menu">
                                        <a role="menuitem" href="/admin/hoc-vien/@item.Id">Hồ sơ</a>
                                    </div>
                                </details>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        <footer class="cms-posts-pager">
            <p class="cms-posts-pager-summary">
                @(Model.Total == 0 ? "Không có học viên" : $"Hiển thị {Model.FromItem} - {Model.ToItem} của {Model.Total} học viên")
            </p>
            <div class="cms-posts-pager-controls">
                <form method="get" action="/admin/hoc-vien" class="cms-posts-pagesize">
                    @if (!string.IsNullOrWhiteSpace(Model.Query)) { <input type="hidden" name="q" value="@Model.Query" /> }
                    @if (Model.ClassFilter is Guid classId) { <input type="hidden" name="classId" value="@classId" /> }
                    @if (Model.HamletFilter is Guid hamletId) { <input type="hidden" name="hamletId" value="@hamletId" /> }
                    @if (Model.AgeFrom is int ageFrom) { <input type="hidden" name="ageFrom" value="@ageFrom" /> }
                    @if (Model.AgeTo is int ageTo) { <input type="hidden" name="ageTo" value="@ageTo" /> }
                    @await Html.PartialAsync("Shared/_CmsSortHidden", (Model.Sort, Model.Dir))
                    <label>
                        <span class="visually-hidden">Số học viên mỗi trang</span>
                        <select name="pageSize" data-cms-posts-pagesize>
                            <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10 / trang</option>
                            <option value="20" selected="@(Model.PageSize == 20 ? "selected" : null)">20 / trang</option>
                            <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50 / trang</option>
                        </select>
                    </label>
                </form>
                <nav class="cms-posts-pages" aria-label="Phân trang học viên">
                    @if (Model.CurrentPage > 1)
                    {
                        <a class="cms-posts-page-btn" href="@Model.ListUrl(page: Model.CurrentPage - 1)" rel="prev" aria-label="Trang trước"><span class="material-symbols-outlined" aria-hidden="true">chevron_left</span></a>
                    }
                    else
                    {
                        <span class="cms-posts-page-btn is-disabled" aria-hidden="true"><span class="material-symbols-outlined">chevron_left</span></span>
                    }
                    @for (var pageNumber = firstPage; pageNumber <= lastPage; pageNumber++)
                    {
                        if (pageNumber == Model.CurrentPage)
                        {
                            <span class="cms-posts-page-btn is-current" aria-current="page">@pageNumber</span>
                        }
                        else
                        {
                            <a class="cms-posts-page-btn" href="@Model.ListUrl(page: pageNumber)">@pageNumber</a>
                        }
                    }
                    @if (Model.CurrentPage < Model.PageCount)
                    {
                        <a class="cms-posts-page-btn" href="@Model.ListUrl(page: Model.CurrentPage + 1)" rel="next" aria-label="Trang sau"><span class="material-symbols-outlined" aria-hidden="true">chevron_right</span></a>
                    }
                    else
                    {
                        <span class="cms-posts-page-btn is-disabled" aria-hidden="true"><span class="material-symbols-outlined">chevron_right</span></span>
                    }
                </nav>
            </div>
        </footer>
    </section>
</section>

<script src="~/js/admin-cms-list.js" asp-append-version="true" defer></script>
