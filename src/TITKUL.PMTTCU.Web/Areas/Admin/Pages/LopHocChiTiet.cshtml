@page "/admin/lop-hoc/{id:guid}"
@using TITKUL.PMTTCU.Web.Areas.Admin
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.LopHocChiTietModel
@{
    ViewData["Title"] = "Chi tiết lớp";
    var showSession = Request.Query.ContainsKey("session");
    var showMaterial = Request.Query.ContainsKey("material");
}

<section class="crm-page">
    <header class="crm-page-heading">
        <div>
            <p class="crm-eyebrow">Đào tạo &amp; người học</p>
            <h1>Chi tiết lớp</h1>
            <p class="crm-page-description">Hồ sơ lớp, QR đăng ký, buổi học và học viên.</p>
        </div>
        <div class="crm-heading-actions">
            <a class="education-cancel-button" href="/admin/lop-hoc">Về danh sách</a>
            <a class="education-cancel-button" href="/admin/lop-hoc/@Model.Item?.Id/chung-nhan">Chứng nhận</a>
            <a class="education-cancel-button" href="/admin/lop-hoc/@Model.Item?.Id/don-phep">Đơn xin phép</a>
            @if (Model.CanEdit)
            {
                <a class="crm-primary-button" href="/admin/lop-hoc/@Model.Item?.Id?session=true"><span aria-hidden="true">＋</span> Thêm buổi</a>
            }
        </div>
    </header>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="crm-alert" role="alert">@Model.ErrorMessage</p>
    }
    @if (Model.Item is not null)
    {
        <p class="crm-ok">Trạng thái hiện tại: <strong>@EducationUi.Status(Model.Item.Status)</strong></p>
        @if (Model.CanManage && !string.IsNullOrEmpty(Model.QrUrl))
        {
            <section class="crm-panel">
                <header class="crm-panel-heading"><h2>QR đăng ký</h2></header>
                <div class="crm-form-grid">
                    <p class="crm-field-wide">Quét mã mở <code>@Model.QrUrl</code></p>
                    <p><img src="/admin/lop-hoc/@Model.Item.Id?handler=Qr" alt="Mã QR đăng ký lớp @Model.Item.Code" width="180" height="180" /></p>
                    <p class="crm-form-actions crm-field-wide">
                        <a class="education-cancel-button" href="/admin/lop-hoc/@Model.Item.Id?handler=Qr">Tải PNG</a>
                        <a class="education-cancel-button" href="/dang-ky/@Model.Item.Code">Mở form công khai</a>
                        <button type="button" class="crm-primary-button" data-copy-url="/dang-ky/@Model.Item.Code">Sao chép liên kết đăng ký</button>
                    </p>
                    <p class="crm-field-wide" data-copy-feedback role="status" aria-live="polite"></p>
                </div>
            </section>
        }
        @if (Model.CanEdit)
        {
            <form method="post" class="crm-panel crm-form-grid">
                <div>
                    <label for="programId">Chương trình</label>
                    <select id="programId" name="ProgramId" required>
                        @foreach (var program in Model.Programs)
                        {
                            <option value="@program.Id" selected="@(Model.ProgramId == program.Id ? "selected" : null)">@program.Code — @program.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="roomId">Phòng</label>
                    <select id="roomId" name="RoomId">
                        <option value="">Không gán phòng</option>
                        @foreach (var room in Model.Rooms)
                        {
                            <option value="@room.Id" selected="@(Model.RoomId == room.Id ? "selected" : null)">@room.Code — @room.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="clubId">Câu lạc bộ (nếu có)</label>
                    <select id="clubId" name="ClubId">
                        <option value="">Không thuộc câu lạc bộ</option>
                        @foreach (var club in Model.Clubs) { <option value="@club.Id" selected="@(Model.ClubId == club.Id ? "selected" : null)">@club.Code — @club.Name</option> }
                    </select>
                </div>
                <p class="status-note"><strong>Mã lớp:</strong> <code>@Model.Item.Code</code> · Mã không thay đổi sau khi tạo.</p>
                <div>
                    <label for="name">Tên lớp</label>
                    <input id="name" name="Name" value="@Model.Name" required maxlength="250" />
                </div>
                <div>
                    <label for="startDate">Ngày bắt đầu</label>
                    <input id="startDate" name="StartDate" type="date" value="@Model.StartDate?.ToString("yyyy-MM-dd")" required />
                </div>
                <div>
                    <label for="endDate">Ngày kết thúc</label>
                    <input id="endDate" name="EndDate" type="date" value="@Model.EndDate?.ToString("yyyy-MM-dd")" required />
                </div>
                <div>
                    <label for="capacity">Sĩ số tối đa</label>
                    <input id="capacity" name="Capacity" type="number" min="1" value="@Model.Capacity" required />
                </div>
                <div>
                    <label for="public">Công khai</label>
                    <select id="public" name="Public">
                        <option value="true" selected="@(Model.Public ? "selected" : null)">Có</option>
                        <option value="false" selected="@(!Model.Public ? "selected" : null)">Không</option>
                    </select>
                </div>
                <div class="crm-form-actions"><button class="crm-primary-button" type="submit">Lưu thông tin lớp</button></div>
            </form>
        }
        else
        {
            <p><strong>Mã:</strong> @Model.Item.Code</p>
            <p><strong>Tên:</strong> @Model.Item.Name</p>
            <p><strong>Thời gian:</strong> @Model.Item.StartDate.ToString("dd/MM/yyyy") - @Model.Item.EndDate.ToString("dd/MM/yyyy")</p>
            <p><strong>Sĩ số tối đa:</strong> @Model.Item.Capacity</p>
        }
        @if (Model.CanManage && Model.AllowedTransitions.Count > 0)
        {
            <form method="post" asp-page-handler="Transition" class="stack">
                <div>
                    <label for="toStatus">Chuyển sang</label>
                    <select id="toStatus" name="ToStatus" required>
                        @foreach (var status in Model.AllowedTransitions)
                        {
                            <option value="@status">@EducationUi.Status(status)</option>
                        }
                    </select>
                </div>
                <button type="submit">Cập nhật trạng thái</button>
            </form>
        }
        else if (Model.CanManage)
        {
            <p class="status-note">Lớp đã đóng hoặc hủy. Không mở lại trong phạm vi hiện tại.</p>
        }

        <h2>Giảng viên</h2>
        @if (Model.Teachers.Count == 0)
        {
            <p class="empty">Chưa phân công giảng viên.</p>
        }
        else
        {
            <ul>
                @foreach (var teacher in Model.Teachers)
                {
                    <li class="row-actions">
                        <span>@teacher.Username</span>
                        @if (Model.CanManage)
                        {
                            <form method="post" asp-page-handler="RemoveTeacher">
                                <input type="hidden" name="userId" value="@teacher.UserId" />
                                <button type="submit" class="button-quiet">Gỡ</button>
                            </form>
                        }
                    </li>
                }
            </ul>
        }
        @if (Model.CanManage)
        {
            <form method="post" asp-page-handler="Assign" class="stack">
                <div>
                    <label for="teacherUserId">Phân công</label>
                    <select id="teacherUserId" name="TeacherUserId" required>
                        <option value="">Chọn giảng viên hoặc cán bộ</option>
                        @foreach (var person in Model.Staff)
                        {
                            <option value="@person.Id">@person.Username</option>
                        }
                    </select>
                </div>
                <button type="submit">Thêm giảng viên</button>
            </form>
        }

        @if (Model.CanManage)
        {
            <h2>Cộng tác viên, giáo viên theo biểu mẫu</h2>
            @if (Model.AssignedCollaborators.Count == 0)
            {
                <p class="empty">Chưa phân công nhân sự từ danh mục cộng tác viên.</p>
            }
            else
            {
                <ul>
                    @foreach (var person in Model.AssignedCollaborators)
                    {
                        <li class="row-actions">
                            <span>@person.FullName@(string.IsNullOrWhiteSpace(person.WorkUnit) ? "" : " — " + person.WorkUnit)</span>
                            <form method="post" asp-page-handler="RemoveCollaborator">
                                <input type="hidden" name="collaboratorId" value="@person.CollaboratorId" />
                                <button type="submit" class="button-quiet">Gỡ</button>
                            </form>
                        </li>
                    }
                </ul>
            }
            <form method="post" asp-page-handler="AssignCollaborator" class="stack">
                <div>
                    <label for="classCollaboratorId">Phân công cộng tác viên, giáo viên</label>
                    <select id="classCollaboratorId" name="ClassCollaboratorId" required>
                        <option value="">Chọn người trong danh mục</option>
                        @foreach (var person in Model.Collaborators)
                        {
                            <option value="@person.Id">@person.FullName@(string.IsNullOrWhiteSpace(person.WorkUnit) ? "" : " — " + person.WorkUnit)</option>
                        }
                    </select>
                    @if (Model.Collaborators.Count == 0)
                    {
                        <small>Thêm hồ sơ tại mục Nhân sự, cộng tác viên trước khi phân công.</small>
                    }
                </div>
                <button type="submit" disabled="@(Model.Collaborators.Count == 0 ? "disabled" : null)">Phân công</button>
            </form>
        }

        <section class="crm-table-card" aria-labelledby="session-table-title">
        <header class="crm-table-heading">
            <div><h2 id="session-table-title">Buổi học</h2><p>@Model.Sessions.Count buổi</p></div>
        </header>
        @if (Model.Sessions.Count == 0)
        {
            <div class="crm-empty"><strong>Chưa có buổi học</strong></div>
        }
        else
        {
            <div class="crm-table-scroll">
                <table class="crm-table">
                    <caption>Thời khóa biểu lớp</caption>
                    <thead>
                        <tr>
                            <th scope="col">Buổi</th>
                            <th scope="col">Thời gian</th>
                            <th scope="col">Hình thức</th>
                            <th scope="col">Trạng thái</th>
                            <th scope="col">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var session in Model.Sessions)
                    {
                        <tr>
                            <td>@session.Title</td>
                            <td>@session.StartAt.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM HH:mm") - @session.EndAt.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm")</td>
                            <td>@EducationUi.Status(session.Mode)</td>
                            <td>@EducationUi.Status(session.Status)</td>
                            <td class="row-actions">
                                <a href="/admin/diem-danh/@session.Id">Điểm danh</a>
                            @if (Model.CanManage && session.Status == "SCHEDULED")
                            {
                                    <form method="post" asp-page-handler="CancelSession">
                                        <input type="hidden" name="sessionId" value="@session.Id" />
                                        <button type="submit" class="button-quiet">Hủy buổi</button>
                                    </form>
                            }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        </section>

        <section class="crm-table-card" aria-labelledby="enroll-table-title">
        <header class="crm-table-heading">
            <div><h2 id="enroll-table-title">Danh sách đăng ký</h2><p>@Model.Enrollments.Count học viên</p></div>
        </header>
        @if (Model.Enrollments.Count == 0)
        {
            <div class="crm-empty"><strong>Chưa có đăng ký</strong></div>
        }
        else
        {
            <div class="crm-table-scroll">
                <table class="crm-table">
                    <caption>Học viên đã đăng ký</caption>
                    <thead>
                        <tr>
                            <th scope="col">Họ tên</th>
                            <th scope="col">Điện thoại</th>
                            <th scope="col">Mã</th>
                            <th scope="col">Trạng thái</th>
                            <th scope="col">Lúc</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.Enrollments)
                    {
                        <tr>
                            <td>@row.FullName</td>
                            <td>@row.Phone</td>
                            <td>@row.Code</td>
                            <td>@EducationUi.Status(row.Status)</td>
                            <td>@row.RegisteredAt.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM HH:mm")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        </section>

        <section class="crm-panel">
            <header class="crm-panel-heading">
                <div><h2>Học liệu</h2></div>
                @if (Model.CanMaterial)
                {
                    <a class="crm-primary-button" href="/admin/lop-hoc/@Model.Item.Id?material=true"><span aria-hidden="true">＋</span> Thêm học liệu</a>
                }
            </header>
            @if (Model.Materials.Count == 0)
            {
                <div class="crm-empty"><strong>Chưa có học liệu</strong></div>
            }
            else
            {
                <div class="material-grid" style="padding:16px">
                    @foreach (var material in Model.Materials)
                    {
                        <article class="material-card">
                            <h3>@material.Title</h3>
                            <p>@(material.Public ? "Công khai" : "Nội bộ") · @material.FileName</p>
                            <p><a class="education-cancel-button" href="/admin/lop-hoc/@Model.Item.Id?handler=MaterialFile&amp;materialId=@material.Id">Tải tệp</a></p>
                        </article>
                    }
                </div>
            }
        </section>
    }
</section>

@if (showSession && Model.Item is not null && Model.CanEdit)
{
    <dialog class="crm-modal" open data-close-href="/admin/lop-hoc/@Model.Item.Id" aria-labelledby="session-modal-title">
        <div class="crm-modal-backdrop"></div>
        <section class="crm-modal-panel">
            <header class="crm-modal-heading">
                <div><p class="crm-eyebrow">Thời khóa biểu</p><h2 id="session-modal-title">Thêm buổi học</h2></div>
                <a class="crm-modal-close" href="/admin/lop-hoc/@Model.Item.Id" aria-label="Đóng">×</a>
            </header>
            <form method="post" asp-page-handler="Session" class="crm-modal-body">
                <label for="sessionTitle">Tên buổi<input id="sessionTitle" name="SessionTitle" value="@Model.SessionTitle" required maxlength="250" /></label>
                <label for="sessionRoomId">Phòng
                    <select id="sessionRoomId" name="SessionRoomId">
                        <option value="">Không gán phòng</option>
                        @foreach (var room in Model.Rooms) { <option value="@room.Id">@room.Code — @room.Name</option> }
                    </select>
                </label>
                <label for="sessionStart">Bắt đầu<input id="sessionStart" name="SessionStart" type="datetime-local" value="@Model.SessionStart" required /></label>
                <label for="sessionEnd">Kết thúc<input id="sessionEnd" name="SessionEnd" type="datetime-local" value="@Model.SessionEnd" required /></label>
                <label for="sessionMode">Hình thức
                    <select id="sessionMode" name="SessionMode">
                        <option value="OFFLINE" selected="@(Model.SessionMode == "OFFLINE" ? "selected" : null)">Trực tiếp</option>
                        <option value="ONLINE" selected="@(Model.SessionMode == "ONLINE" ? "selected" : null)">Trực tuyến</option>
                        <option value="HYBRID" selected="@(Model.SessionMode == "HYBRID" ? "selected" : null)">Kết hợp</option>
                    </select>
                </label>
                <label for="meetingUrl">Liên kết Meet/Zoom (HTTPS)<input id="meetingUrl" name="MeetingUrl" value="@Model.MeetingUrl" maxlength="1000" /></label>
                <footer class="crm-modal-actions">
                    <a class="education-cancel-button" href="/admin/lop-hoc/@Model.Item.Id">Hủy</a>
                    <button class="crm-primary-button" type="submit">Thêm buổi học</button>
                </footer>
            </form>
        </section>
    </dialog>
}

@if (showMaterial && Model.Item is not null && Model.CanMaterial)
{
    <dialog class="crm-modal" open data-close-href="/admin/lop-hoc/@Model.Item.Id" aria-labelledby="material-modal-title">
        <div class="crm-modal-backdrop"></div>
        <section class="crm-modal-panel">
            <header class="crm-modal-heading">
                <div><p class="crm-eyebrow">Học liệu</p><h2 id="material-modal-title">Thêm học liệu</h2></div>
                <a class="crm-modal-close" href="/admin/lop-hoc/@Model.Item.Id" aria-label="Đóng">×</a>
            </header>
            <form method="post" asp-page-handler="Material" enctype="multipart/form-data" class="crm-modal-body">
                <label for="materialTitle">Tiêu đề học liệu<input id="materialTitle" name="MaterialTitle" value="@Model.MaterialTitle" required maxlength="250" /></label>
                <label for="materialDescription">Mô tả<input id="materialDescription" name="MaterialDescription" value="@Model.MaterialDescription" maxlength="1000" /></label>
                <label for="materialFile">Tệp PDF hoặc ảnh
                    <input id="materialFile" name="MaterialFile" type="file" data-file-preview="20971520" data-image-max="5242880" accept=".pdf,.png,.jpg,.jpeg,application/pdf,image/png,image/jpeg" required />
                    <small>Ảnh tối đa 5 MiB; PDF tối đa 20 MiB.</small>
                    <small data-file-preview-status aria-live="polite"></small>
                </label>
                <label>
                    <input type="checkbox" name="MaterialPublic" value="true" checked="@(Model.MaterialPublic ? "checked" : null)" />
                    Công khai trên trang lớp
                </label>
                <footer class="crm-modal-actions">
                    <a class="education-cancel-button" href="/admin/lop-hoc/@Model.Item.Id">Hủy</a>
                    <button class="crm-primary-button" type="submit">Thêm học liệu</button>
                </footer>
            </form>
        </section>
    </dialog>
}
