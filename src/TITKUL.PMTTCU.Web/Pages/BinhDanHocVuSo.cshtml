@page "/binh-dan-hoc-vu-so"
@model TITKUL.PMTTCU.Web.Pages.BinhDanHocVuSoModel
@{
    ViewData["Title"] = "Bình dân học vụ số";
    ViewData["Description"] = "Bài viết và hướng dẫn kỹ năng số dành cho người dân.";
}

<section class="card stack public-learning-page">
    <header class="public-learning-intro">
        <p class="public-learning-eyebrow">HỌC TẬP CỘNG ĐỒNG</p>
        <h1>Bình dân học vụ số</h1>
        <p>Hướng dẫn kỹ năng số thiết thực để người dân tự tin tiếp cận thông tin và dịch vụ trực tuyến.</p>
    </header>
    <form class="public-filter" method="get" action="/binh-dan-hoc-vu-so" role="search">
        <label for="digital-literacy-query">Tìm nội dung</label>
        <div><input id="digital-literacy-query" name="q" type="search" value="@Model.Query" maxlength="80" placeholder="Nhập tiêu đề hoặc từ khóa" /><button class="button" type="submit">Tìm kiếm</button></div>
        @if (!string.IsNullOrWhiteSpace(Model.Query)) { <a href="/binh-dan-hoc-vu-so">Xóa tìm kiếm</a> }
    </form>
    @if (Model.ErrorMessage is not null)
    {
        <p class="alert" role="alert">@Model.ErrorMessage</p>
    }
    else if (Model.Items.Count == 0)
    {
        <p class="empty" role="status">@(string.IsNullOrWhiteSpace(Model.Query) ? "Nội dung đang được Trung tâm cập nhật." : "Không tìm thấy nội dung phù hợp.")</p>
    }
    else
    {
        <div class="public-learning-grid">
            @foreach (var item in Model.Items)
            {
                var imageUrl = item.ThumbnailUrl ?? item.CoverUrl;
                <article class="public-learning-card">
                    <a class="public-learning-card-image" href="/tin-tuc/@Uri.EscapeDataString(item.Slug)">
                        @if (!string.IsNullOrWhiteSpace(imageUrl))
                        {
                            <img src="@imageUrl" alt="" loading="lazy" decoding="async" />
                        }
                        else
                        {
                            <span aria-hidden="true">▤</span>
                        }
                    </a>
                    <div class="public-learning-card-copy">
                        <span class="public-learning-category">@item.CategoryName</span>
                        <h2><a href="/tin-tuc/@Uri.EscapeDataString(item.Slug)">@item.Title</a></h2>
                        @if (!string.IsNullOrWhiteSpace(item.Summary)) { <p>@item.Summary</p> }
                        @if (item.PublishedAt is DateTimeOffset publishedAt) { <time datetime="@publishedAt.ToString("O")">@publishedAt.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</time> }
                    </div>
                </article>
            }
        </div>
    }
    @await Html.PartialAsync("_PublicPager", new TITKUL.PMTTCU.Web.Pages.PublicPagerModel(Model.CurrentPage, Model.PageSize, Model.Total))
</section>
