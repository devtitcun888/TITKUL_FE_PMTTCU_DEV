@page "/admin/lop-hoc"
@using TITKUL.PMTTCU.Web.Areas.Admin
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.LopHocModel
@{
    ViewData["Title"] = "Lớp học";
    var firstPage = Math.Max(1, Model.CurrentPage - 2);
    var lastPage = Math.Min(Model.PageCount, Model.CurrentPage + 2);
}

<section class="crm-page cms-posts-page cms-list-page">

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="crm-alert" role="alert">@Model.ErrorMessage</p>
    }

    <form class="cms-posts-toolbar" method="get" action="/admin/lop-hoc" role="search" data-cms-autofilter data-cols="3">
        @await Html.PartialAsync("Shared/_CmsSortHidden", (Model.Sort, Model.Dir))
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
        <button class="cms-posts-filter-toggle @(Model.FiltersActive ? "has-active-filters" : null)" type="button" aria-label="Bộ lọc" aria-expanded="false" aria-controls="edu-class-filter-fields" data-cms-filter-toggle>
            <svg class="cms-posts-filter-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M4 5h16l-6.5 7.5v5l-3 1.5v-6.5L4 5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
        <div class="cms-posts-filter-fields" id="edu-class-filter-fields">
            <label class="cms-posts-field">
                <span>Từ khóa</span>
                <span class="cms-posts-search">
                    <span class="material-symbols-outlined" aria-hidden="true">search</span>
                    <input name="q" type="search" value="@Model.Query" placeholder="Tìm mã hoặc tên lớp" />
                </span>
            </label>
            <label class="cms-posts-field">
                <span>Trạng thái</span>
                <select name="status" data-cms-filter>
                    <option value="">Tất cả trạng thái</option>
                    <option value="DU_KIEN" selected="@(Model.StatusFilter == "DU_KIEN" ? "selected" : null)">Dự kiến</option>
                    <option value="MO_DANG_KY" selected="@(Model.StatusFilter == "MO_DANG_KY" ? "selected" : null)">Mở đăng ký</option>
                    <option value="DANG_HOC" selected="@(Model.StatusFilter == "DANG_HOC" ? "selected" : null)">Đang học</option>
                    <option value="DONG" selected="@(Model.StatusFilter == "DONG" ? "selected" : null)">Đóng</option>
                    <option value="HUY" selected="@(Model.StatusFilter == "HUY" ? "selected" : null)">Hủy</option>
                </select>
            </label>
            <label class="cms-posts-field">
                <span>Chương trình</span>
                <select name="programId" data-cms-filter>
                    <option value="">Tất cả chương trình</option>
                    @foreach (var program in Model.Programs)
                    {
                        <option value="@program.Id" selected="@(Model.ProgramFilter == program.Id ? "selected" : null)">@program.Code — @program.Name</option>
                    }
                </select>
            </label>
            <div class="cms-posts-toolbar-actions">
                <a class="cms-posts-reset" href="/admin/lop-hoc">
                    <span class="material-symbols-outlined" aria-hidden="true">restart_alt</span>
                    Xóa lọc
                </a>
            </div>
        </div>
    </form>

    <section class="cms-posts-kpis" data-cols="4" aria-label="Thống kê lớp học">
        <a class="cms-posts-kpi is-all @(Model.StatusFilter is null ? "is-current" : null)" href="@Model.ListUrl(page: 1, status: "")">
            <span class="cms-posts-kpi-icon" aria-hidden="true"><span class="material-symbols-outlined">school</span></span>
            <span><span class="cms-posts-kpi-label">Tất cả</span><strong>@Model.TotalAll.ToString("N0")</strong></span>
        </a>
        <a class="cms-posts-kpi is-published @(Model.StatusFilter == "MO_DANG_KY" ? "is-current" : null)" href="@Model.ListUrl(page: 1, status: "MO_DANG_KY")">
            <span class="cms-posts-kpi-icon" aria-hidden="true"><span class="cms-posts-dot"></span></span>
            <span><span class="cms-posts-kpi-label">Mở đăng ký</span><strong>@Model.TotalOpen.ToString("N0")</strong></span>
        </a>
        <a class="cms-posts-kpi is-draft @(Model.StatusFilter == "DANG_HOC" ? "is-current" : null)" href="@Model.ListUrl(page: 1, status: "DANG_HOC")">
            <span class="cms-posts-kpi-icon" aria-hidden="true"><span class="material-symbols-outlined">menu_book</span></span>
            <span><span class="cms-posts-kpi-label">Đang học</span><strong>@Model.TotalLearning.ToString("N0")</strong></span>
        </a>
        <a class="cms-posts-kpi is-cancelled @(Model.StatusFilter == "DONG" ? "is-current" : null)" href="@Model.ListUrl(page: 1, status: "DONG")">
            <span class="cms-posts-kpi-icon" aria-hidden="true"><span class="material-symbols-outlined">keep</span></span>
            <span><span class="cms-posts-kpi-label">Đóng</span><strong>@Model.TotalClosed.ToString("N0")</strong></span>
        </a>
    </section>

    <section class="cms-posts-list" aria-labelledby="class-table-title">
        <header class="cms-posts-list-heading">
            <div>
                <h2 id="class-table-title">Danh sách lớp</h2>
                <p>@Model.Total.ToString("N0") lớp</p>
            </div>
            <div class="cms-posts-list-actions">
                @if (Model.CanManage)
                {
                    <a class="crm-primary-button cms-posts-create" href="/admin/lop-hoc?create=true"><span class="material-symbols-outlined" aria-hidden="true">add</span> Tạo lớp</a>
                }
            </div>
        </header>
        @if (Model.Items.Count == 0)
        {
            <div class="cms-posts-empty">
                <span class="material-symbols-outlined" aria-hidden="true">school</span>
                <strong>@(Model.FiltersActive ? "Không tìm thấy lớp phù hợp" : "Chưa có lớp học")</strong>
                <p>@(Model.FiltersActive ? "Thử xóa bộ lọc hoặc đổi từ khóa." : "Tạo lớp dự kiến rồi mở đăng ký khi sẵn sàng.")</p>
            </div>
        }
        else
        {
            <div class="cms-posts-table-scroll">
                <table class="cms-posts-table">
                    <thead>
                        <tr>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "code", Model.Dir)" href="@Model.SortUrl("code")">Mã <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "code", Model.Dir)</span></a></th>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "name", Model.Dir)" href="@Model.SortUrl("name")">Tên lớp <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "name", Model.Dir)</span></a></th>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "status", Model.Dir)" href="@Model.SortUrl("status")">Trạng thái <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "status", Model.Dir)</span></a></th>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "capacity", Model.Dir)" href="@Model.SortUrl("capacity")">Sĩ số <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "capacity", Model.Dir)</span></a></th>
                            <th class="cms-posts-actions-col" scope="col">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var statusClass = item.Status switch
                        {
                            "MO_DANG_KY" or "DANG_HOC" => "published",
                            "DU_KIEN" => "draft",
                            "DONG" => "archived",
                            _ => "cancelled"
                        };
                        <tr>
                            <td><span class="cms-posts-category">@item.Code</span></td>
                            <td class="cms-posts-title-cell"><strong>@item.Name</strong></td>
                            <td><span class="cms-posts-status is-@statusClass"><i aria-hidden="true"></i>@EducationUi.Status(item.Status)</span></td>
                            <td>@item.Capacity.ToString("N0")</td>
                            <td class="cms-posts-actions-col">
                                <details class="cms-posts-row-menu">
                                    <summary aria-label="Thao tác @item.Name"><span class="material-symbols-outlined" aria-hidden="true">more_horiz</span></summary>
                                    <div class="cms-posts-row-panel" role="menu">
                                        <a role="menuitem" href="/admin/lop-hoc/@item.Id">Chi tiết</a>
                                    </div>
                                </details>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        <footer class="cms-posts-pager">
            <p class="cms-posts-pager-summary">
                @(Model.Total == 0 ? "Không có lớp học" : $"Hiển thị {Model.FromItem} - {Model.ToItem} của {Model.Total} lớp")
            </p>
            <div class="cms-posts-pager-controls">
                <form method="get" action="/admin/lop-hoc" class="cms-posts-pagesize">
                    @if (!string.IsNullOrWhiteSpace(Model.Query)) { <input type="hidden" name="q" value="@Model.Query" /> }
                    @if (!string.IsNullOrWhiteSpace(Model.StatusFilter)) { <input type="hidden" name="status" value="@Model.StatusFilter" /> }
                    @if (Model.ProgramFilter is Guid programId) { <input type="hidden" name="programId" value="@programId" /> }
                    @await Html.PartialAsync("Shared/_CmsSortHidden", (Model.Sort, Model.Dir))
                    <label>
                        <span class="visually-hidden">Số lớp mỗi trang</span>
                        <select name="pageSize" data-cms-posts-pagesize>
                            <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10 / trang</option>
                            <option value="20" selected="@(Model.PageSize == 20 ? "selected" : null)">20 / trang</option>
                            <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50 / trang</option>
                        </select>
                    </label>
                </form>
                <nav class="cms-posts-pages" aria-label="Phân trang lớp học">
                    @if (Model.CurrentPage > 1)
                    {
                        <a class="cms-posts-page-btn" href="@Model.ListUrl(page: Model.CurrentPage - 1)" rel="prev" aria-label="Trang trước"><span class="material-symbols-outlined" aria-hidden="true">chevron_left</span></a>
                    }
                    else
                    {
                        <span class="cms-posts-page-btn is-disabled" aria-hidden="true"><span class="material-symbols-outlined">chevron_left</span></span>
                    }
                    @for (var pageNumber = firstPage; pageNumber <= lastPage; pageNumber++)
                    {
                        if (pageNumber == Model.CurrentPage)
                        {
                            <span class="cms-posts-page-btn is-current" aria-current="page">@pageNumber</span>
                        }
                        else
                        {
                            <a class="cms-posts-page-btn" href="@Model.ListUrl(page: pageNumber)">@pageNumber</a>
                        }
                    }
                    @if (Model.CurrentPage < Model.PageCount)
                    {
                        <a class="cms-posts-page-btn" href="@Model.ListUrl(page: Model.CurrentPage + 1)" rel="next" aria-label="Trang sau"><span class="material-symbols-outlined" aria-hidden="true">chevron_right</span></a>
                    }
                    else
                    {
                        <span class="cms-posts-page-btn is-disabled" aria-hidden="true"><span class="material-symbols-outlined">chevron_right</span></span>
                    }
                </nav>
            </div>
        </footer>
    </section>
</section>

@if (Model.ShowModal && Model.CanManage)
{
    <dialog class="crm-modal" open data-close-href="/admin/lop-hoc" aria-labelledby="class-modal-title">
        <div class="crm-modal-backdrop"></div>
        <section class="crm-modal-panel">
            <header class="crm-modal-heading">
                <div><p class="crm-eyebrow">Đào tạo</p><h2 id="class-modal-title">Tạo lớp (Dự kiến)</h2></div>
                <a class="crm-modal-close" href="/admin/lop-hoc" aria-label="Đóng">×</a>
            </header>
            <form method="post" class="crm-modal-body">
                @Html.AntiForgeryToken()
                <p class="education-field-hint">Mã lớp do hệ thống tự cấp khi tạo.</p>
                <div class="education-form-field">
                    <label for="programId">Chương trình <span>*</span></label>
                    <select id="programId" name="ProgramId" required>
                        <option value="">Chọn chương trình</option>
                        @foreach (var program in Model.Programs)
                        {
                            <option value="@program.Id" selected="@(Model.ProgramId == program.Id ? "selected" : null)">@program.Code — @program.Name</option>
                        }
                    </select>
                </div>
                <div class="education-form-field">
                    <label for="roomId">Phòng</label>
                    <select id="roomId" name="RoomId">
                        <option value="">Không gán phòng</option>
                        @foreach (var room in Model.Rooms)
                        {
                            <option value="@room.Id" selected="@(Model.RoomId == room.Id ? "selected" : null)">@room.Code — @room.Name</option>
                        }
                    </select>
                </div>
                <div class="education-form-field">
                    <label for="clubId">Câu lạc bộ (nếu có)</label>
                    <select id="clubId" name="ClubId">
                        <option value="">Không thuộc câu lạc bộ</option>
                        @foreach (var club in Model.Clubs)
                        {
                            <option value="@club.Id" selected="@(Model.ClubId == club.Id ? "selected" : null)">@club.Code — @club.Name</option>
                        }
                    </select>
                </div>
                <div class="education-form-field"><label for="name">Tên lớp <span>*</span></label><input id="name" name="Name" value="@Model.Name" required maxlength="250" /></div>
                <div class="education-form-field"><label for="startDate">Ngày bắt đầu <span>*</span></label><input id="startDate" name="StartDate" type="date" value="@Model.StartDate?.ToString("yyyy-MM-dd")" required /></div>
                <div class="education-form-field"><label for="endDate">Ngày kết thúc <span>*</span></label><input id="endDate" name="EndDate" type="date" value="@Model.EndDate?.ToString("yyyy-MM-dd")" required /></div>
                <div class="education-form-field"><label for="capacity">Sĩ số tối đa <span>*</span></label><input id="capacity" name="Capacity" type="number" min="1" value="@Model.Capacity" required /></div>
                <footer class="crm-modal-actions">
                    <a class="education-cancel-button" href="/admin/lop-hoc">Hủy</a>
                    <button class="crm-primary-button" type="submit">Tạo lớp</button>
                </footer>
            </form>
        </section>
    </dialog>
}

<script src="~/js/admin-cms-list.js" asp-append-version="true" defer></script>
