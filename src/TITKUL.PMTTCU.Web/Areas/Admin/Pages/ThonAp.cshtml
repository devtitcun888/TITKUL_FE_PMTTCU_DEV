@page "/admin/thon-ap"
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.ThonApModel
@{
    ViewData["Title"] = "Thôn/ấp";
}

<section class="card stack">
    <h1>Thôn/ấp</h1>
    <p>Danh mục vận hành. Tên chính thức của Trung tâm (D-04) sẽ được cập nhật khi có.</p>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="alert" role="alert">@Model.ErrorMessage</p>
    }
    @if (Model.CanManage)
    {
        <form method="post" class="stack">
            <div>
                <label for="code">Mã</label>
                <input id="code" name="Code" value="@Model.Code" required maxlength="30" autocomplete="off" />
            </div>
            <div>
                <label for="name">Tên</label>
                <input id="name" name="Name" value="@Model.Name" required maxlength="150" />
            </div>
            <button type="submit">Thêm thôn/ấp</button>
        </form>
    }
    @if (Model.Items.Count == 0)
    {
        <p class="empty">Chưa có thôn/ấp.</p>
    }
    else
    {
        <div class="table-scroll">
            <table>
                <caption>Danh sách thôn/ấp</caption>
                <thead>
                    <tr>
                        <th scope="col">Mã</th>
                        <th scope="col">Tên</th>
                        <th scope="col">Hiệu lực</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Code</td>
                        <td>@item.Name</td>
                        <td>@(item.Active ? "Đang dùng" : "Ngưng")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
