@page "/admin/dieu-tra-nhu-cau"
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.DieuTraNhuCauModel
@{
    ViewData["Title"] = "Điều tra nhu cầu học tập";
}

<section class="card stack admin-education-page">
    <h1>Điều tra nhu cầu học tập</h1>
    <p>Quản lý đợt điều tra, nhập workbook nhiều sheet và giữ nguyên địa bàn nguồn. Tên/số nhà không dùng làm khóa để tự gộp người.</p>
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <p class="alert" role="alert">@Model.ErrorMessage</p> }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) { <p class="status-note" role="status">@Model.SuccessMessage</p> }

    <section class="card stack">
        <h2>Tạo đợt điều tra</h2>
        <form method="post" asp-page-handler="CreateRound" class="row-actions">
            <div><label for="year">Năm</label><input id="year" name="Year" type="number" min="1" max="9999" value="@Model.Year" /></div>
            <div><label for="roundTitle">Tên đợt</label><input id="roundTitle" name="RoundTitle" maxlength="240" required placeholder="Điều tra nhu cầu học tập năm ..." /></div>
            <button type="submit">Tạo đợt</button>
        </form>
    </section>

    <div class="table-scroll">
        <table>
            <caption>Các đợt điều tra</caption>
            <thead><tr><th scope="col">Năm</th><th scope="col">Tên đợt</th><th scope="col">Ngày tạo</th><th scope="col">Thao tác</th></tr></thead>
            <tbody>
                @if (Model.Rounds.Count == 0) { <tr><td colspan="4">Chưa có đợt điều tra.</td></tr> }
                @foreach (var round in Model.Rounds)
                {
                    <tr><td>@round.Year</td><td>@round.Title</td><td>@round.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td><a href="/admin/dieu-tra-nhu-cau?id=@round.Id">Mở</a></td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.SelectedRound is not null && Model.Summary is not null)
    {
        <section class="card stack">
            <div class="row-actions">
                <div><h2>@Model.SelectedRound.Title (@Model.SelectedRound.Year)</h2><p>Địa bàn giữ theo tên trong file; chưa ánh xạ sang mã xã/ấp.</p></div>
                <a class="button button-quiet" href="/admin/dieu-tra-nhu-cau?handler=Export&amp;id=@Model.SelectedRound.Id">Xuất Excel theo địa bàn nguồn</a>
            </div>
            <div class="row-actions" aria-label="Tổng hợp nhu cầu">
                <p><strong>@Model.Summary.Total</strong> phiếu</p>
                <p><strong>@Model.Summary.FemaleCount</strong> nữ</p>
                <p><strong>@Model.Summary.RiceNeedCount</strong> nhu cầu trồng lúa</p>
                <p><strong>@Model.Summary.LivestockNeedCount</strong> nhu cầu chăn nuôi</p>
                <p><strong>@Model.Summary.OtherNeedCount</strong> nghề khác</p>
            </div>
            <div class="table-scroll">
                <table>
                    <caption>Tổng hợp theo địa bàn được nhập</caption>
                    <thead><tr><th scope="col">Địa bàn nguồn</th><th scope="col">Số phiếu</th><th scope="col">Trồng lúa</th><th scope="col">Chăn nuôi</th><th scope="col">Nghề khác</th></tr></thead>
                    <tbody>
                        @foreach (var location in Model.Summary.Locations)
                        {
                            <tr><td>@location.LocationLabel</td><td>@location.Total</td><td>@location.RiceNeedCount</td><td>@location.LivestockNeedCount</td><td>@location.OtherNeedCount</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="card stack">
            <h2>Nhập phiếu Excel nhiều sheet</h2>
            <p>Nhận các cột của biểu mẫu; các dòng chuẩn bị sẵn chỉ có STT sẽ được bỏ qua. Không kiểm tra trùng tên/địa chỉ.</p>
            <form method="post" enctype="multipart/form-data" asp-page-handler="Import" asp-route-id="@Model.SelectedRound.Id" class="row-actions">
                <label for="importFile">Workbook .xlsx</label>
                <input id="importFile" name="ImportFile" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required />
                <button type="submit">Nhập dữ liệu</button>
            </form>
        </section>

        <section class="card stack">
            <h2>Phiếu trong đợt</h2>
            <details class="stack" open="@(Model.EntryId.HasValue ? "open" : null)">
                <summary>@(Model.EntryId.HasValue ? "Sửa phiếu" : "Thêm phiếu thủ công")</summary>
                <form method="post" asp-page-handler="SaveEntry" asp-route-id="@Model.SelectedRound.Id" class="stack">
                    @if (Model.EntryId is Guid entryId) { <input type="hidden" name="EntryId" value="@entryId" /> }
                    <div class="row-actions">
                        <div><label for="sourceSheet">Sheet nguồn</label><input id="sourceSheet" name="SourceSheet" value="@Model.SourceSheet" placeholder="BD / BH / BT / MANUAL" maxlength="100" /></div>
                        <div><label for="sequence">STT</label><input id="sequence" name="Sequence" type="number" min="0" value="@Model.Sequence" /></div>
                        <div><label for="locationLabel">Ấp / địa bàn như trong biểu mẫu</label><input id="locationLabel" name="LocationLabel" value="@Model.LocationLabel" /></div>
                    </div>
                    <div class="row-actions">
                        <div><label for="fullName">Họ và tên</label><input id="fullName" name="FullName" value="@Model.FullName" maxlength="180" /></div>
                        <div><label for="female">Nữ</label><select id="female" name="Female"><option value="false" selected="@(!Model.Female ? "selected" : null)">Không</option><option value="true" selected="@(Model.Female ? "selected" : null)">Có</option></select></div>
                        <div><label for="birthYear">Năm sinh</label><input id="birthYear" name="BirthYear" type="number" value="@Model.BirthYear" /></div>
                        <div><label for="houseNumber">Số nhà</label><input id="houseNumber" name="HouseNumber" value="@Model.HouseNumber" maxlength="120" /></div>
                    </div>
                    <div class="row-actions">
                        <div><label for="educationLevel">Trình độ văn hóa</label><input id="educationLevel" name="EducationLevel" value="@Model.EducationLevel" maxlength="240" /></div>
                        <div><label for="occupation">Nghề nghiệp</label><input id="occupation" name="Occupation" value="@Model.Occupation" maxlength="240" /></div>
                        <div><label for="wantsRice">Nhu cầu trồng lúa</label><select id="wantsRice" name="WantsRice"><option value="false" selected="@(!Model.WantsRice ? "selected" : null)">Không</option><option value="true" selected="@(Model.WantsRice ? "selected" : null)">Có</option></select></div>
                        <div><label for="wantsLivestock">Nhu cầu chăn nuôi</label><select id="wantsLivestock" name="WantsLivestock"><option value="false" selected="@(!Model.WantsLivestock ? "selected" : null)">Không</option><option value="true" selected="@(Model.WantsLivestock ? "selected" : null)">Có</option></select></div>
                    </div>
                    <div><label for="otherNeed">Nhu cầu nghề khác</label><textarea id="otherNeed" name="OtherNeed" rows="2">@Model.OtherNeed</textarea></div>
                    <button type="submit">@(Model.EntryId.HasValue ? "Lưu phiếu" : "Thêm phiếu")</button>
                </form>
            </details>
            <div class="table-scroll">
                <table>
                    <caption>@Model.Entries.Count phiếu đã nhập</caption>
                    <thead><tr><th scope="col">Nguồn</th><th scope="col">Địa bàn</th><th scope="col">STT</th><th scope="col">Họ và tên</th><th scope="col">Nữ</th><th scope="col">Năm sinh</th><th scope="col">Số nhà</th><th scope="col">Trình độ</th><th scope="col">Nghề nghiệp</th><th scope="col">Trồng lúa</th><th scope="col">Chăn nuôi</th><th scope="col">Nghề khác</th><th scope="col">Thao tác</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model.Entries)
                        {
                            <tr>
                                <td>@item.SourceSheet</td><td>@item.LocationLabel</td><td>@item.Sequence</td><td>@item.FullName</td><td>@(item.Female ? "X" : "")</td><td>@item.BirthYear</td><td>@item.HouseNumber</td><td>@item.EducationLevel</td><td>@item.Occupation</td><td>@(item.WantsRice ? "X" : "")</td><td>@(item.WantsLivestock ? "X" : "")</td><td>@item.OtherNeed</td>
                                <td class="row-actions"><a href="/admin/dieu-tra-nhu-cau?id=@item.RoundId&amp;entryId=@item.Id">Sửa</a><form method="post" asp-page-handler="DeleteEntry" asp-route-id="@item.RoundId"><input type="hidden" name="entryId" value="@item.Id" /><button type="submit" class="button-quiet">Xóa</button></form></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</section>
