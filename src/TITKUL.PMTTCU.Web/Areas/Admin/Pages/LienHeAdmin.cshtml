@page "/admin/lien-he"
@using TITKUL.PMTTCU.Web.Areas.Admin
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.LienHeAdminModel
@{
    ViewData["Title"] = "Phản ánh";
}
<section class="card stack">
    <h1>Phản ánh</h1>
    <form class="public-filter" method="get" action="/admin/lien-he">
        <label for="contact-status">Lọc theo trạng thái</label>
        <div><select id="contact-status" name="status"><option value="">Tất cả</option><option value="NEW" selected="@(Model.Status == "NEW")">Mới</option><option value="PROCESSING" selected="@(Model.Status == "PROCESSING")">Đang xử lý</option><option value="CLOSED" selected="@(Model.Status == "CLOSED")">Đã đóng</option><option value="SPAM" selected="@(Model.Status == "SPAM")">Spam</option></select><button class="button" type="submit">Lọc</button></div>
    </form>
    @if (Model.Items.Count == 0)
    {
        <p class="empty">Chưa có phản ánh.</p>
    }
    else
    {
        <div class="table-scroll">
            <table>
                <caption>Danh sách phản ánh</caption>
                <thead><tr><th scope="col">Người gửi</th><th scope="col">Nội dung</th><th scope="col">Trạng thái</th><th scope="col"></th></tr></thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Name<br />@item.Phone</td>
                        <td><a asp-page="/LienHeChiTiet" asp-route-id="@item.Id"><strong>@item.Title</strong></a><p>@item.Body</p></td>
                        <td>@EducationUi.Status(item.Status)</td>
                        <td>
                            @if (Model.CanEdit)
                            {
                                <form method="post" asp-page-handler="Status" asp-route-id="@item.Id">
                                    <input type="hidden" name="status" value="PROCESSING" />
                                    <button type="submit">Đang xử lý</button>
                                </form>
                                <form method="post" asp-page-handler="Status" asp-route-id="@item.Id">
                                    <input type="hidden" name="status" value="CLOSED" />
                                    <button type="submit">Đóng</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
@await Html.PartialAsync("/Pages/Shared/_PublicPager.cshtml", new TITKUL.PMTTCU.Web.Pages.PublicPagerModel(Model.CurrentPage, Model.PageSize, Model.Total))
