@page "/admin/cms/su-kien"
@using TITKUL.PMTTCU.Web.Areas.Admin
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.CmsSuKienModel
@{
    ViewData["Title"] = "Sự kiện";
}

<section class="card stack">
    <h1>Sự kiện</h1>
    @if (Model.CanEdit)
    {
        <p><a class="button" href="/admin/cms/su-kien/sua">Tạo sự kiện</a></p>
    }
    @if (Model.Items.Count == 0)
    {
        <p class="empty">Chưa có sự kiện.</p>
    }
    else
    {
        <div class="table-scroll">
            <table>
                <caption>Danh sách sự kiện</caption>
                <thead>
                    <tr>
                        <th scope="col">Tiêu đề</th>
                        <th scope="col">Thời gian</th>
                        <th scope="col">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><a href="/admin/cms/su-kien/sua/@item.Id">@item.Title</a></td>
                        <td>@item.StartAt.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM HH:mm")–@item.EndAt.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm")</td>
                        <td>@EducationUi.Status(item.Status)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
