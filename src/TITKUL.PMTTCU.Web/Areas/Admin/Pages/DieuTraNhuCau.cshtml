@page "/admin/dieu-tra-nhu-cau"
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.DieuTraNhuCauModel
@{
    ViewData["Title"] = "Điều tra nhu cầu học tập";
    var showCreate = Request.Query.ContainsKey("create");
    var showImport = Model.SelectedRound is not null && Request.Query.ContainsKey("import");
    var showEntry = Model.SelectedRound is not null && (Model.EntryId.HasValue || Request.Query.ContainsKey("entry"));
}

<section class="crm-page">
    <header class="crm-page-heading">
        <div>
            <p class="crm-eyebrow">Khảo sát &amp; báo cáo</p>
            <h1>Điều tra nhu cầu học tập</h1>
            <p class="crm-page-description">Quản lý đợt điều tra, nhập workbook nhiều sheet. Tên/số nhà không dùng làm khóa để tự gộp người.</p>
        </div>
        <a class="crm-primary-button" href="/admin/dieu-tra-nhu-cau?create=true"><span aria-hidden="true">＋</span> Tạo đợt</a>
    </header>
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <p class="crm-alert" role="alert">@Model.ErrorMessage</p> }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) { <p class="crm-ok" role="status">@Model.SuccessMessage</p> }

    <section class="crm-table-card" aria-labelledby="need-round-title">
        <header class="crm-table-heading">
            <div>
                <h2 id="need-round-title">Các đợt điều tra</h2>
                <p>@Model.Rounds.Count đợt</p>
            </div>
        </header>
        @if (Model.Rounds.Count == 0)
        {
            <div class="crm-empty"><strong>Chưa có đợt điều tra</strong><p>Tạo đợt để nhập phiếu Excel hoặc thêm phiếu thủ công.</p></div>
        }
        else
        {
            <div class="crm-table-scroll">
                <table class="crm-table">
                    <thead><tr><th scope="col">Năm</th><th scope="col">Tên đợt</th><th scope="col">Ngày tạo</th><th scope="col" class="education-actions-cell">Thao tác</th></tr></thead>
                    <tbody>
                    @foreach (var round in Model.Rounds)
                    {
                        <tr>
                            <td>@round.Year</td>
                            <td><strong>@round.Title</strong></td>
                            <td>@round.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td class="education-actions-cell"><a class="education-edit-button" href="/admin/dieu-tra-nhu-cau?id=@round.Id">Mở</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (Model.SelectedRound is not null && Model.Summary is not null)
    {
        <section class="crm-kpi-grid" aria-label="Tổng hợp nhu cầu">
            <article class="crm-kpi"><span>Phiếu</span><strong>@Model.Summary.Total</strong></article>
            <article class="crm-kpi"><span>Nữ</span><strong>@Model.Summary.FemaleCount</strong></article>
            <article class="crm-kpi"><span>Trồng lúa</span><strong>@Model.Summary.RiceNeedCount</strong></article>
            <article class="crm-kpi"><span>Chăn nuôi</span><strong>@Model.Summary.LivestockNeedCount</strong></article>
            <article class="crm-kpi"><span>Nghề khác</span><strong>@Model.Summary.OtherNeedCount</strong></article>
        </section>

        <section class="crm-table-card">
            <header class="crm-table-heading">
                <div>
                    <h2>@Model.SelectedRound.Title (@Model.SelectedRound.Year)</h2>
                    <p>Địa bàn giữ theo tên trong file; chưa ánh xạ sang mã xã/ấp.</p>
                </div>
                <a class="education-cancel-button" href="/admin/dieu-tra-nhu-cau?handler=Export&amp;id=@Model.SelectedRound.Id">Xuất Excel</a>
            </header>
            <div class="crm-table-scroll">
                <table class="crm-table">
                    <thead><tr><th scope="col">Địa bàn nguồn</th><th scope="col">Số phiếu</th><th scope="col">Trồng lúa</th><th scope="col">Chăn nuôi</th><th scope="col">Nghề khác</th></tr></thead>
                    <tbody>
                    @foreach (var location in Model.Summary.Locations)
                    {
                        <tr><td>@location.LocationLabel</td><td>@location.Total</td><td>@location.RiceNeedCount</td><td>@location.LivestockNeedCount</td><td>@location.OtherNeedCount</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="crm-table-card" aria-labelledby="need-entry-title">
            <header class="crm-table-heading">
                <div>
                    <h2 id="need-entry-title">Phiếu trong đợt</h2>
                    <p>@Model.Entries.Count phiếu đã nhập</p>
                </div>
                <div class="crm-heading-actions">
                    <a class="education-cancel-button" href="/admin/dieu-tra-nhu-cau?id=@Model.SelectedRound.Id&amp;import=true">Nhập Excel</a>
                    <a class="crm-primary-button" href="/admin/dieu-tra-nhu-cau?id=@Model.SelectedRound.Id&amp;entry=true"><span aria-hidden="true">＋</span> Thêm phiếu</a>
                </div>
            </header>
            @if (Model.Entries.Count == 0)
            {
                <div class="crm-empty"><strong>Chưa có phiếu</strong><p>Nhập workbook nhiều sheet hoặc thêm phiếu thủ công.</p></div>
            }
            else
            {
                <div class="crm-table-scroll">
                    <table class="crm-table">
                        <thead><tr><th scope="col">Nguồn</th><th scope="col">Địa bàn</th><th scope="col">STT</th><th scope="col">Họ và tên</th><th scope="col">Nữ</th><th scope="col">Năm sinh</th><th scope="col">Số nhà</th><th scope="col">Trình độ</th><th scope="col">Nghề nghiệp</th><th scope="col">Trồng lúa</th><th scope="col">Chăn nuôi</th><th scope="col">Nghề khác</th><th scope="col" class="education-actions-cell">Thao tác</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.Entries)
                        {
                            <tr>
                                <td>@item.SourceSheet</td><td>@item.LocationLabel</td><td>@item.Sequence</td><td>@item.FullName</td><td>@(item.Female ? "X" : "")</td><td>@item.BirthYear</td><td>@item.HouseNumber</td><td>@item.EducationLevel</td><td>@item.Occupation</td><td>@(item.WantsRice ? "X" : "")</td><td>@(item.WantsLivestock ? "X" : "")</td><td>@item.OtherNeed</td>
                                <td class="crm-row-actions">
                                    <a class="education-edit-button" href="/admin/dieu-tra-nhu-cau?id=@item.RoundId&amp;entryId=@item.Id">Sửa</a>
                                    <form method="post" asp-page-handler="DeleteEntry" asp-route-id="@item.RoundId">
                                        <input type="hidden" name="entryId" value="@item.Id" />
                                        <button type="submit" class="button-quiet">Xóa</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</section>

@if (showCreate)
{
    <dialog class="crm-modal" open data-close-href="/admin/dieu-tra-nhu-cau" aria-labelledby="need-create-title">
        <div class="crm-modal-backdrop"></div>
        <section class="crm-modal-panel">
            <header class="crm-modal-heading">
                <div><p class="crm-eyebrow">Điều tra nhu cầu</p><h2 id="need-create-title">Tạo đợt điều tra</h2></div>
                <a class="crm-modal-close" href="/admin/dieu-tra-nhu-cau" aria-label="Đóng">×</a>
            </header>
            <form method="post" asp-page-handler="CreateRound" class="crm-modal-body">
                <label for="year">Năm<input id="year" name="Year" type="number" min="1" max="9999" value="@Model.Year" /></label>
                <label for="roundTitle">Tên đợt<input id="roundTitle" name="RoundTitle" maxlength="240" required placeholder="Điều tra nhu cầu học tập năm ..." /></label>
                <footer class="crm-modal-actions">
                    <a class="education-cancel-button" href="/admin/dieu-tra-nhu-cau">Hủy</a>
                    <button class="crm-primary-button" type="submit">Tạo đợt</button>
                </footer>
            </form>
        </section>
    </dialog>
}

@if (showImport && Model.SelectedRound is not null)
{
    <dialog class="crm-modal" open data-close-href="/admin/dieu-tra-nhu-cau?id=@Model.SelectedRound.Id" aria-labelledby="need-import-title">
        <div class="crm-modal-backdrop"></div>
        <section class="crm-modal-panel">
            <header class="crm-modal-heading">
                <div><p class="crm-eyebrow">Nhập liệu</p><h2 id="need-import-title">Nhập phiếu Excel nhiều sheet</h2></div>
                <a class="crm-modal-close" href="/admin/dieu-tra-nhu-cau?id=@Model.SelectedRound.Id" aria-label="Đóng">×</a>
            </header>
            <form method="post" enctype="multipart/form-data" asp-page-handler="Import" asp-route-id="@Model.SelectedRound.Id" class="crm-modal-body">
                <p>Nhận các cột của biểu mẫu; các dòng chuẩn bị sẵn chỉ có STT sẽ được bỏ qua. Không kiểm tra trùng tên/địa chỉ.</p>
                <label for="importFile">Workbook .xlsx<input id="importFile" name="ImportFile" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required /></label>
                <footer class="crm-modal-actions">
                    <a class="education-cancel-button" href="/admin/dieu-tra-nhu-cau?id=@Model.SelectedRound.Id">Hủy</a>
                    <button class="crm-primary-button" type="submit">Nhập dữ liệu</button>
                </footer>
            </form>
        </section>
    </dialog>
}

@if (showEntry && Model.SelectedRound is not null)
{
    <dialog class="crm-modal" open data-close-href="/admin/dieu-tra-nhu-cau?id=@Model.SelectedRound.Id" aria-labelledby="need-entry-modal">
        <div class="crm-modal-backdrop"></div>
        <section class="crm-modal-panel crm-modal-wide">
            <header class="crm-modal-heading">
                <div><p class="crm-eyebrow">Phiếu điều tra</p><h2 id="need-entry-modal">@(Model.EntryId.HasValue ? "Sửa phiếu" : "Thêm phiếu thủ công")</h2></div>
                <a class="crm-modal-close" href="/admin/dieu-tra-nhu-cau?id=@Model.SelectedRound.Id" aria-label="Đóng">×</a>
            </header>
            <form method="post" asp-page-handler="SaveEntry" asp-route-id="@Model.SelectedRound.Id" class="crm-modal-body">
                @if (Model.EntryId is Guid entryId) { <input type="hidden" name="EntryId" value="@entryId" /> }
                <div class="crm-form-grid" style="padding:0">
                    <label for="sourceSheet">Sheet nguồn<input id="sourceSheet" name="SourceSheet" value="@Model.SourceSheet" placeholder="BD / BH / BT / MANUAL" maxlength="100" /></label>
                    <label for="sequence">STT<input id="sequence" name="Sequence" type="number" min="0" value="@Model.Sequence" /></label>
                    <label class="crm-field-wide" for="locationLabel">Ấp / địa bàn như trong biểu mẫu<input id="locationLabel" name="LocationLabel" value="@Model.LocationLabel" /></label>
                    <label for="fullName">Họ và tên<input id="fullName" name="FullName" value="@Model.FullName" maxlength="180" /></label>
                    <label for="female">Nữ<select id="female" name="Female"><option value="false" selected="@(!Model.Female ? "selected" : null)">Không</option><option value="true" selected="@(Model.Female ? "selected" : null)">Có</option></select></label>
                    <label for="birthYear">Năm sinh<input id="birthYear" name="BirthYear" type="number" value="@Model.BirthYear" /></label>
                    <label for="houseNumber">Số nhà<input id="houseNumber" name="HouseNumber" value="@Model.HouseNumber" maxlength="120" /></label>
                    <label for="educationLevel">Trình độ văn hóa<input id="educationLevel" name="EducationLevel" value="@Model.EducationLevel" maxlength="240" /></label>
                    <label for="occupation">Nghề nghiệp<input id="occupation" name="Occupation" value="@Model.Occupation" maxlength="240" /></label>
                    <label for="wantsRice">Nhu cầu trồng lúa<select id="wantsRice" name="WantsRice"><option value="false" selected="@(!Model.WantsRice ? "selected" : null)">Không</option><option value="true" selected="@(Model.WantsRice ? "selected" : null)">Có</option></select></label>
                    <label for="wantsLivestock">Nhu cầu chăn nuôi<select id="wantsLivestock" name="WantsLivestock"><option value="false" selected="@(!Model.WantsLivestock ? "selected" : null)">Không</option><option value="true" selected="@(Model.WantsLivestock ? "selected" : null)">Có</option></select></label>
                    <label class="crm-field-wide" for="otherNeed">Nhu cầu nghề khác<textarea id="otherNeed" name="OtherNeed" rows="2">@Model.OtherNeed</textarea></label>
                </div>
                <footer class="crm-modal-actions">
                    <a class="education-cancel-button" href="/admin/dieu-tra-nhu-cau?id=@Model.SelectedRound.Id">Hủy</a>
                    <button class="crm-primary-button" type="submit">@(Model.EntryId.HasValue ? "Lưu phiếu" : "Thêm phiếu")</button>
                </footer>
            </form>
        </section>
    </dialog>
}
