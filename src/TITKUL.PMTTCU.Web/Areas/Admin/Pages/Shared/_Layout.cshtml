@using TITKUL.PMTTCU.Web.ApiClients
@{
    var profile = Context.Items["StaffProfile"] as StaffProfile;
    var permissions = profile?.Permissions ?? [];
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị PMTTCU</title>
    <link rel="stylesheet" href="~/css/pmttcu.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#noi-dung">Đi tới nội dung</a>
    <div class="admin-shell">
        <nav class="side-nav" aria-label="Quản trị">
            <a href="/admin">Tổng quan</a>
            @if (permissions.Contains("education.manage") || permissions.Contains("education.view"))
            {
                <a href="/admin/chuong-trinh">Chương trình</a>
                <a href="/admin/doi-tuong">Đối tượng</a>
                <a href="/admin/thon-ap">Thôn/ấp</a>
                <a href="/admin/phong-hoc">Phòng học</a>
            }
            @if (permissions.Contains("education.manage") || permissions.Contains("education.view") || permissions.Contains("report.own_classes.view"))
            {
                <a href="/admin/lop-hoc">Lớp học</a>
                <a href="/admin/lich-hoc">Lịch học</a>
            }
            @if (permissions.Contains("learner.view") || permissions.Contains("learner.manage"))
            {
                <a href="/admin/hoc-vien">Học viên</a>
            }
            @if (permissions.Contains("cms.view") || permissions.Contains("cms.create"))
            {
                <a href="/admin/cms/chuyen-muc">Chuyên mục</a>
                <a href="/admin/cms/bai-viet">Bài viết</a>
                <a href="/admin/cms/su-kien">Sự kiện</a>
                <a href="/admin/cms/thong-bao">Thông báo</a>
                <a href="/admin/cms/van-ban">Văn bản</a>
                <a href="/admin/cms/bieu-mau">Biểu mẫu</a>
                <a href="/admin/cms/album">Thư viện</a>
                <a href="/admin/cau-hinh">Cấu hình</a>
                <a href="/admin/lien-he">Phản ánh</a>
            }
            @if (permissions.Contains("audit.view"))
            {
                <a href="/admin/nhat-ky">Nhật ký</a>
            }
            <a href="/admin/dang-xuat">Đăng xuất</a>
        </nav>
        <div>
            <header class="admin-topbar">
                <div class="admin-topbar-inner wrap">
                    <strong>Quản trị PMTTCU</strong>
                    <span>@(profile?.Roles?.FirstOrDefault() ?? "Đã đăng nhập")</span>
                    <a href="/">Về cổng thông tin</a>
                </div>
            </header>
            <main id="noi-dung" class="admin-main">
                @RenderBody()
            </main>
        </div>
    </div>
</body>
</html>
