@page "/admin/diem-danh/{buoiId:guid}"
@using TITKUL.PMTTCU.Web.Areas.Admin
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.DiemDanhModel
@{
    ViewData["Title"] = "Điểm danh";
}

<section class="crm-page">
    <header class="crm-page-heading">
        <div>
            <p class="crm-eyebrow">Đào tạo &amp; người học</p>
            <h1>Điểm danh</h1>
            <p class="crm-page-description">Ghi có mặt, vắng, phép. Thanh lưu dính cuối trang.</p>
        </div>
    </header>
    @if (Model.Item is not null)
    {
        <div class="crm-heading-actions" style="justify-content:flex-start">
            <a class="education-cancel-button" href="/admin/lop-hoc/@Model.Item.ClassId">Về lớp @Model.Item.ClassName</a>
        </div>
        <p><strong>@Model.Item.SessionTitle</strong> · @Model.Item.StartAt.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM HH:mm")–@Model.Item.EndAt.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm") · @EducationUi.Status(Model.Item.SessionStatus)</p>
        <section class="crm-kpi-grid" aria-label="Tóm tắt điểm danh">
            <article class="crm-kpi"><span>Có mặt</span><strong>@Model.Item.Present</strong></article>
            <article class="crm-kpi"><span>Vắng</span><strong>@Model.Item.Absent</strong></article>
            <article class="crm-kpi"><span>Phép</span><strong>@Model.Item.Excused</strong></article>
        </section>
        <section class="crm-panel">
            <header class="crm-panel-heading"><h2>QR và link (học trực tiếp hoặc Meet)</h2></header>
            <div class="crm-form-grid">
                <p class="crm-field-wide">Học viên quét mã hoặc mở link, nhập SĐT đã đăng ký và mã 6 số. Mã buổi: <strong>@Model.Item.Pin</strong></p>
                <p><img src="/admin/diem-danh/@Model.Item.SessionId?handler=Qr" alt="Mã QR điểm danh" width="180" height="180" /></p>
                <p class="crm-form-actions crm-field-wide"><a class="crm-primary-button" href="@Model.Item.CheckInUrl">Mở link điểm danh</a></p>
                <p class="crm-field-wide">Cửa sổ tự điểm danh: 15 phút trước giờ học đến 30 phút sau khi kết thúc. Dán link vào chat Meet khi dạy online.</p>
                @if (!Model.Item.CheckInOpen)
                {
                    <p class="crm-field-wide">Ngoài cửa sổ: học viên chưa tự điểm danh được. Cán bộ vẫn chấm tay sau giờ học.</p>
                }
            </div>
        </section>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="alert" role="alert">@Model.ErrorMessage</p>
    }
    @if (Model.Item is not null)
    {
        <section class="crm-toolbar" aria-label="Tìm học viên">
            <form method="get" action="/admin/diem-danh/@Model.Item.SessionId" class="crm-filter">
                <label class="crm-search" for="q">
                    <span aria-hidden="true">⌕</span>
                    <span class="visually-hidden">Tìm học viên</span>
                    <input id="q" name="q" value="@Model.Query" autocomplete="off" placeholder="Tìm học viên" />
                </label>
                <button class="crm-primary-button" type="submit">Tìm</button>
            </form>
        </section>
        @if (Model.Item.CanEdit)
        {
            <p class="row-actions">
                <form method="post" asp-page-handler="Fill">
                    <input type="hidden" name="fill" value="CO_MAT" />
                    <button type="submit" class="button-quiet">Tất cả có mặt</button>
                </form>
                <form method="post" asp-page-handler="Fill">
                    <input type="hidden" name="fill" value="VANG" />
                    <button type="submit" class="button-quiet">Tất cả vắng</button>
                </form>
                <form method="post" asp-page-handler="Fill">
                    <input type="hidden" name="fill" value="PHEP" />
                    <button type="submit" class="button-quiet">Tất cả phép</button>
                </form>
            </p>
        }
        @if (Model.Item.Items.Count == 0)
        {
            <p class="empty">Chưa có học viên hoặc không khớp tìm kiếm.</p>
        }
        else if (Model.Item.CanEdit)
        {
            <form method="post" class="stack">
                @for (var i = 0; i < Model.Marks.Count; i++)
                {
                    var line = Model.Item.Items.ElementAtOrDefault(i);
                    if (line is null) { continue; }
                    <div class="attend-row">
                        <input type="hidden" name="Marks[@i].EnrollmentId" value="@Model.Marks[i].EnrollmentId" />
                        <strong>@line.FullName</strong>
                        <div class="attend-choices">
                            <label>
                                <input type="radio" name="Marks[@i].Status" value="CO_MAT" checked="@(Model.Marks[i].Status == "CO_MAT" ? "checked" : null)" />
                                Có mặt
                            </label>
                            <label>
                                <input type="radio" name="Marks[@i].Status" value="VANG" checked="@(Model.Marks[i].Status == "VANG" ? "checked" : null)" />
                                Vắng
                            </label>
                            <label>
                                <input type="radio" name="Marks[@i].Status" value="PHEP" checked="@(Model.Marks[i].Status == "PHEP" ? "checked" : null)" />
                                Phép
                            </label>
                        </div>
                    </div>
                }
                <div class="attend-save">
                    <button type="submit">Lưu điểm danh</button>
                </div>
            </form>
        }
        else
        {
            <ul>
                @foreach (var line in Model.Item.Items)
                {
                    <li class="attend-row"><strong>@line.FullName</strong> <span>@EducationUi.Status(line.Status ?? "")</span></li>
                }
            </ul>
            <p class="status-note">Buổi chưa đến giờ, đã hủy, hoặc bạn chỉ được xem.</p>
        }
    }
</section>
