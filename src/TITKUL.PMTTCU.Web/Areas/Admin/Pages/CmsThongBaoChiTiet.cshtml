@page "/admin/cms/thong-bao/sua/{id:guid?}"
@using TITKUL.PMTTCU.Web.Areas.Admin
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.CmsThongBaoChiTietModel
@{
    ViewData["Title"] = Model.NoticeId is null ? "Thông báo mới" : "Biên tập thông báo";
}

<section class="card stack">
    <h1>@(Model.NoticeId is null ? "Thông báo mới" : "Biên tập thông báo")</h1>
    <p><a href="/admin/cms/thong-bao">Về danh sách</a></p>
    @if (!string.IsNullOrEmpty(Model.Status))
    {
        <p>Trạng thái: @EducationUi.Status(Model.Status)</p>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="alert" role="alert">@Model.ErrorMessage</p>
    }
    @if (Model.CanEdit)
    {
        <form method="post" asp-page-handler="Save" class="stack">
            <div>
                <label for="title">Tiêu đề</label>
                <input id="title" name="Title" value="@Model.Title" required maxlength="250" />
            </div>
            <div>
                <label for="slug">Đường dẫn</label>
                <input id="slug" name="Slug" value="@Model.Slug" maxlength="280" />
            </div>
            <div>
                <label for="level">Mức</label>
                <select id="level" name="Level">
                    <option value="NORMAL" selected="@(Model.Level == "NORMAL" ? "selected" : null)">Thường</option>
                    <option value="URGENT" selected="@(Model.Level == "URGENT" ? "selected" : null)">Khẩn</option>
                </select>
            </div>
            <div>
                <label for="visibleFrom">Hiện từ (để trống = luôn)</label>
                <input id="visibleFrom" name="VisibleFrom" type="datetime-local" value="@Model.VisibleFrom" />
            </div>
            <div>
                <label for="visibleTo">Hiện đến</label>
                <input id="visibleTo" name="VisibleTo" type="datetime-local" value="@Model.VisibleTo" />
            </div>
            <div>
                <label for="html">Nội dung HTML</label>
                <textarea id="html" name="Html" rows="8" required>@Model.Html</textarea>
            </div>
            <button type="submit">Lưu nháp</button>
        </form>
        @if (Model.NoticeId is Guid noticeId)
        {
            <p class="row-actions">
                @if (Model.Status != "PUBLISHED")
                {
                    <form method="post" asp-page-handler="Publish">
                        <button type="submit">Đăng thông báo</button>
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="Archive">
                        <button type="submit" class="button-quiet">Lưu trữ</button>
                    </form>
                    <a class="button" href="/thong-bao/@Model.Slug">Xem trên Portal</a>
                }
            </p>
        }
    }
    @if (!string.IsNullOrEmpty(Model.Html))
    {
        <h2>Xem trước</h2>
        <article class="card">
            <h3>@Model.Title</h3>
            @Html.Raw(Model.Html)
        </article>
    }
</section>
