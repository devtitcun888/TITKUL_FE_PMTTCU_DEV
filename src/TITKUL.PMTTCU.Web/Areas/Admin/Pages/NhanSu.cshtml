@page "/admin/nhan-su"
@using TITKUL.PMTTCU.Web.Areas.Admin
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.NhanSuModel
@{
    ViewData["Title"] = "Nhân sự, cộng tác viên";
    var firstPage = Math.Max(1, Model.CurrentPage - 2);
    var lastPage = Math.Min(Model.PageCount, Model.CurrentPage + 2);
}

<section class="crm-page cms-posts-page cms-list-page">

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) { <p class="crm-ok" role="status">@Model.SuccessMessage</p> }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <p class="crm-alert" role="alert">@Model.ErrorMessage</p> }

    <form class="cms-posts-toolbar" method="get" action="/admin/nhan-su" role="search" data-cms-autofilter data-cols="2">
        @await Html.PartialAsync("Shared/_CmsSortHidden", (Model.Sort, Model.Dir))
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
        <button class="cms-posts-filter-toggle @(Model.FiltersActive ? "has-active-filters" : null)" type="button" aria-label="Bộ lọc" aria-expanded="false" aria-controls="edu-staff-filter-fields" data-cms-filter-toggle>
            <svg class="cms-posts-filter-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M4 5h16l-6.5 7.5v5l-3 1.5v-6.5L4 5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
        <div class="cms-posts-filter-fields" id="edu-staff-filter-fields">
            <label class="cms-posts-field">
                <span>Từ khóa</span>
                <span class="cms-posts-search">
                    <span class="material-symbols-outlined" aria-hidden="true">search</span>
                    <input name="q" type="search" value="@Model.Query" placeholder="Họ tên, đơn vị, chức vụ, số điện thoại" />
                </span>
            </label>
            <div class="cms-posts-toolbar-actions">
                <a class="cms-posts-reset" href="/admin/nhan-su">
                    <span class="material-symbols-outlined" aria-hidden="true">restart_alt</span>
                    Xóa lọc
                </a>
            </div>
        </div>
    </form>

    <section class="cms-posts-list" aria-labelledby="staff-table-title">
        <header class="cms-posts-list-heading">
            <div>
                <h2 id="staff-table-title">Danh sách cộng tác viên và giáo viên</h2>
                <p>@Model.Total.ToString("N0") hồ sơ</p>
            </div>
            <div class="cms-posts-list-actions">
                <a class="cms-posts-ghost" href="/admin/nhan-su?handler=Export"><span class="material-symbols-outlined" aria-hidden="true">download</span> Xuất Excel</a>
                <a class="cms-posts-ghost" href="/admin/nhan-su?import=true"><span class="material-symbols-outlined" aria-hidden="true">cloud_upload</span> Nhập Excel</a>
                <a class="crm-primary-button cms-posts-create" href="/admin/nhan-su?create=true"><span class="material-symbols-outlined" aria-hidden="true">add</span> Thêm hồ sơ</a>
            </div>
        </header>
        @if (Model.Items.Count == 0)
        {
            <div class="cms-posts-empty">
                <span class="material-symbols-outlined" aria-hidden="true">article</span>
                <strong>@(Model.FiltersActive ? "Không tìm thấy hồ sơ phù hợp" : "Chưa có hồ sơ")</strong>
                <p>@(Model.FiltersActive ? "Thử xóa bộ lọc hoặc đổi từ khóa." : "Thêm hồ sơ hoặc nhập từ file Excel theo mẫu.")</p>
            </div>
        }
        else
        {
            <div class="cms-posts-table-scroll">
                <table class="cms-posts-table cms-posts-table-wide">
                    <thead>
                        <tr>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "name", Model.Dir)" href="@Model.SortUrl("name")">Họ và tên <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "name", Model.Dir)</span></a></th>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "gender", Model.Dir)" href="@Model.SortUrl("gender")">Nữ <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "gender", Model.Dir)</span></a></th>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "year", Model.Dir)" href="@Model.SortUrl("year")">Năm sinh <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "year", Model.Dir)</span></a></th>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "unit", Model.Dir)" href="@Model.SortUrl("unit")">Đơn vị công tác <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "unit", Model.Dir)</span></a></th>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "position", Model.Dir)" href="@Model.SortUrl("position")">Chức vụ <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "position", Model.Dir)</span></a></th>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "phone", Model.Dir)" href="@Model.SortUrl("phone")">Số ĐT <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "phone", Model.Dir)</span></a></th>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "account", Model.Dir)" href="@Model.SortUrl("account")">Tài khoản <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "account", Model.Dir)</span></a></th>
                            <th scope="col">Ghi chú</th>
                            <th class="cms-posts-actions-col" scope="col">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="cms-posts-title-cell"><strong>@item.FullName</strong></td>
                            <td>@(item.Female ? "X" : "")</td>
                            <td>@(item.BirthYear?.ToString() ?? "—")</td>
                            <td>@(item.WorkUnit ?? "—")</td>
                            <td>@(item.Position ?? "—")</td>
                            <td>@(item.Phone ?? "—")</td>
                            <td>@(item.LinkedUsername ?? "Không liên kết")</td>
                            <td>@(item.Note ?? "—")</td>
                            <td class="cms-posts-actions-col">
                                <details class="cms-posts-row-menu">
                                    <summary aria-label="Thao tác @item.FullName"><span class="material-symbols-outlined" aria-hidden="true">more_horiz</span></summary>
                                    <div class="cms-posts-row-panel" role="menu">
                                        <a role="menuitem" href="/admin/nhan-su?id=@item.Id">Sửa</a>
                                    </div>
                                </details>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        <footer class="cms-posts-pager">
            <p class="cms-posts-pager-summary">
                @(Model.Total == 0 ? "Không có hồ sơ" : $"Hiển thị {Model.FromItem} - {Model.ToItem} của {Model.Total} hồ sơ")
            </p>
            <div class="cms-posts-pager-controls">
                <form method="get" action="/admin/nhan-su" class="cms-posts-pagesize">
                    @if (!string.IsNullOrWhiteSpace(Model.Query)) { <input type="hidden" name="q" value="@Model.Query" /> }
                    @await Html.PartialAsync("Shared/_CmsSortHidden", (Model.Sort, Model.Dir))
                    <label>
                        <span class="visually-hidden">Số hồ sơ mỗi trang</span>
                        <select name="pageSize" data-cms-posts-pagesize>
                            <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10 / trang</option>
                            <option value="20" selected="@(Model.PageSize == 20 ? "selected" : null)">20 / trang</option>
                            <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50 / trang</option>
                        </select>
                    </label>
                </form>
                <nav class="cms-posts-pages" aria-label="Phân trang nhân sự">
                    @if (Model.CurrentPage > 1)
                    {
                        <a class="cms-posts-page-btn" href="@Model.ListUrl(page: Model.CurrentPage - 1)" rel="prev" aria-label="Trang trước"><span class="material-symbols-outlined" aria-hidden="true">chevron_left</span></a>
                    }
                    else
                    {
                        <span class="cms-posts-page-btn is-disabled" aria-hidden="true"><span class="material-symbols-outlined">chevron_left</span></span>
                    }
                    @for (var pageNumber = firstPage; pageNumber <= lastPage; pageNumber++)
                    {
                        if (pageNumber == Model.CurrentPage)
                        {
                            <span class="cms-posts-page-btn is-current" aria-current="page">@pageNumber</span>
                        }
                        else
                        {
                            <a class="cms-posts-page-btn" href="@Model.ListUrl(page: pageNumber)">@pageNumber</a>
                        }
                    }
                    @if (Model.CurrentPage < Model.PageCount)
                    {
                        <a class="cms-posts-page-btn" href="@Model.ListUrl(page: Model.CurrentPage + 1)" rel="next" aria-label="Trang sau"><span class="material-symbols-outlined" aria-hidden="true">chevron_right</span></a>
                    }
                    else
                    {
                        <span class="cms-posts-page-btn is-disabled" aria-hidden="true"><span class="material-symbols-outlined">chevron_right</span></span>
                    }
                </nav>
            </div>
        </footer>
    </section>
</section>

@if (Model.ShowImport)
{
    <dialog class="crm-modal" open data-close-href="/admin/nhan-su" aria-labelledby="staff-import-title">
        <div class="crm-modal-backdrop"></div>
        <section class="crm-modal-panel">
            <header class="crm-modal-heading">
                <div><p class="crm-eyebrow">Nhân sự</p><h2 id="staff-import-title">Nhập danh sách từ Excel</h2></div>
                <a class="crm-modal-close" href="/admin/nhan-su" aria-label="Đóng">×</a>
            </header>
            <form method="post" enctype="multipart/form-data" asp-page-handler="Import" class="crm-modal-body">
                <p class="education-field-hint">Nhập một sheet có tiêu đề cột theo mẫu “CỘNG TÁC VIÊN, GV”. Hồ sơ trống được bỏ qua; file có dòng thiếu họ tên hoặc năm sinh không hợp lệ sẽ bị từ chối.</p>
                <div class="education-form-field"><label for="importFile">File Excel .xlsx <span>*</span></label><input id="importFile" name="ImportFile" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required /></div>
                <footer class="crm-modal-actions">
                    <a class="education-cancel-button" href="/admin/nhan-su">Hủy</a>
                    <button class="crm-primary-button" type="submit">Nhập danh sách</button>
                </footer>
            </form>
        </section>
    </dialog>
}
else if (Model.ShowModal)
{
    <dialog class="crm-modal" open data-close-href="/admin/nhan-su" aria-labelledby="staff-modal-title">
        <div class="crm-modal-backdrop"></div>
        <section class="crm-modal-panel">
            <header class="crm-modal-heading">
                <div><p class="crm-eyebrow">Nhân sự</p><h2 id="staff-modal-title">@(Model.EditingItem is not null ? "Sửa hồ sơ" : "Thêm hồ sơ")</h2></div>
                <a class="crm-modal-close" href="/admin/nhan-su" aria-label="Đóng">×</a>
            </header>
            <form method="post" class="crm-modal-body">
                @if (Model.Id is Guid id) { <input type="hidden" name="Id" value="@id" /> }
                <div class="education-form-field"><label for="fullName">Họ và tên <span>*</span></label><input id="fullName" name="FullName" value="@Model.FullName" maxlength="180" required autocomplete="name" /></div>
                <div class="education-form-field">
                    <label for="female">Giới tính</label>
                    <select id="female" name="Female">
                        <option value="false" selected="@(!Model.Female ? "selected" : null)">Nam</option>
                        <option value="true" selected="@(Model.Female ? "selected" : null)">Nữ</option>
                    </select>
                </div>
                <div class="education-form-field"><label for="birthYear">Năm sinh</label><input id="birthYear" name="BirthYear" type="number" min="1" max="9999" value="@Model.BirthYear" /></div>
                <div class="education-form-field"><label for="workUnit">Đơn vị công tác</label><input id="workUnit" name="WorkUnit" value="@Model.WorkUnit" maxlength="240" /></div>
                <div class="education-form-field"><label for="position">Chức vụ</label><input id="position" name="Position" value="@Model.Position" maxlength="180" /></div>
                <div class="education-form-field"><label for="phone">Số điện thoại</label><input id="phone" name="Phone" value="@Model.Phone" maxlength="40" autocomplete="tel" /></div>
                <div class="education-form-field">
                    <label for="linkedUserId">Tài khoản đăng nhập (tùy chọn)</label>
                    <select id="linkedUserId" name="LinkedUserId">
                        <option value="">Không liên kết tài khoản</option>
                        @foreach (var staff in Model.Staff)
                        {
                            <option value="@staff.Id" selected="@(Model.LinkedUserId == staff.Id ? "selected" : null)">@staff.Username</option>
                        }
                    </select>
                    <p class="education-field-hint">Liên kết hồ sơ không tự tạo tài khoản hoặc cấp quyền đăng nhập.</p>
                </div>
                <div class="education-form-field"><label for="note">Ghi chú</label><textarea id="note" name="Note" maxlength="1000" rows="3">@Model.Note</textarea></div>
                <footer class="crm-modal-actions">
                    <a class="education-cancel-button" href="/admin/nhan-su">Hủy</a>
                    <button class="crm-primary-button" type="submit">@(Model.EditingItem is not null ? "Lưu hồ sơ" : "Thêm hồ sơ")</button>
                </footer>
            </form>
        </section>
    </dialog>
}

<script src="~/js/admin-cms-list.js" asp-append-version="true" defer></script>
