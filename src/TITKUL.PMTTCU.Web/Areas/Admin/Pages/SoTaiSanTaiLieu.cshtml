@page "/admin/so-tai-san-tai-lieu"
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.SoTaiSanTaiLieuModel
@{
    ViewData["Title"] = "Sổ tài sản, tài liệu và mượn–trả";
}
<section class="card stack admin-education-page">
    <h1>Sổ tài sản, tài liệu và mượn–trả</h1>
    <p>Quản lý theo các cột trong biểu mẫu khách hàng gửi. Thành tiền được tính từ đơn giá × số lượng; ngày trả và thông tin ký nhận được ghi khi có dữ liệu.</p>
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <p class="alert" role="alert">@Model.ErrorMessage</p> }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage)) { <p class="status-note" role="status">@Model.SuccessMessage</p> }
    <div class="row-actions"><a class="button button-quiet" href="/admin/so-tai-san-tai-lieu?handler=Export">Xuất cả ba sổ ra Excel</a></div>

    <section class="card stack">
        <h2>Sổ tài sản</h2>
        <form method="post" enctype="multipart/form-data" asp-page-handler="ImportAssets" class="row-actions"><label for="assetFile">Nhập workbook Sổ tài sản</label><input id="assetFile" name="ImportFile" type="file" accept=".xlsx" required /><button type="submit">Nhập sổ tài sản</button></form>
        <details class="stack" open="@(Model.AssetId.HasValue ? "open" : null)"><summary>@(Model.AssetId.HasValue ? "Sửa tài sản" : "Thêm tài sản")</summary>
            <form method="post" asp-page-handler="SaveAsset" class="stack">
                @if (Model.AssetId is Guid assetId) { <input type="hidden" name="AssetId" value="@assetId" /> }
                <div class="row-actions">
                    <div><label for="assetSequence">STT</label><input id="assetSequence" name="Sequence" type="number" min="0" value="@(Model.AssetId.HasValue ? Model.Sequence : null)" /></div>
                    <div><label for="assetName">Tên tài sản</label><input id="assetName" name="Name" value="@(Model.AssetId.HasValue ? Model.Name : null)" maxlength="300" /></div>
                    <div><label for="brand">Nhãn hiệu</label><input id="brand" name="Brand" value="@Model.Brand" maxlength="180" /></div>
                    <div><label for="country">Nước sản xuất</label><input id="country" name="Country" value="@Model.Country" maxlength="180" /></div>
                    <div><label for="assetPrice">Đơn giá</label><input id="assetPrice" name="UnitPrice" type="number" min="0" step="0.01" value="@(Model.AssetId.HasValue ? Model.UnitPrice : null)" /></div>
                    <div><label for="assetQuantity">Số lượng</label><input id="assetQuantity" name="Quantity" type="number" min="0" value="@Model.AssetId.HasValue ? Model.Quantity : null" /></div>
                </div>
                <div class="row-actions"><div><label for="assetSupplier">Nguồn cung cấp</label><input id="assetSupplier" name="Supplier" value="@(Model.AssetId.HasValue ? Model.Supplier : null)" maxlength="240" /></div><div><label for="assetNote">Ghi chú</label><input id="assetNote" name="Note" value="@(Model.AssetId.HasValue ? Model.Note : null)" /></div></div>
                <button type="submit">@(Model.AssetId.HasValue ? "Lưu tài sản" : "Thêm tài sản")</button>
            </form>
        </details>
        <div class="table-scroll"><table><caption>@Model.Assets.Count dòng sổ tài sản</caption><thead><tr><th>STT</th><th>Tên tài sản</th><th>Nhãn hiệu</th><th>Nước sản xuất</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th><th>Nguồn cung cấp</th><th>Ghi chú</th><th>Thao tác</th></tr></thead><tbody>
            @if (Model.Assets.Count == 0) { <tr><td colspan="10">Chưa có tài sản.</td></tr> }
            @foreach (var x in Model.Assets) { <tr><td>@x.Sequence</td><td>@x.Name</td><td>@x.Brand</td><td>@x.Country</td><td>@x.UnitPrice</td><td>@x.Quantity</td><td>@x.TotalAmount</td><td>@x.Supplier</td><td>@x.Note</td><td class="row-actions"><a href="/admin/so-tai-san-tai-lieu?assetId=@x.Id">Sửa</a><form method="post" asp-page-handler="DeleteAsset"><input type="hidden" name="assetId" value="@x.Id" /><button class="button-quiet" type="submit">Xóa</button></form></td></tr> }
        </tbody></table></div>
    </section>

    <section class="card stack">
        <h2>Danh mục tài liệu, sách, báo và đồ dùng dạy học</h2>
        <form method="post" enctype="multipart/form-data" asp-page-handler="ImportCatalog" class="row-actions"><label for="catalogFile">Nhập workbook Tài liệu, mượn tài liệu</label><input id="catalogFile" name="ImportFile" type="file" accept=".xlsx" required /><button type="submit">Nhập danh mục</button></form>
        <details class="stack" open="@(Model.CatalogId.HasValue ? "open" : null)"><summary>@(Model.CatalogId.HasValue ? "Sửa tài liệu" : "Thêm tài liệu")</summary>
            <form method="post" asp-page-handler="SaveCatalog" class="stack">
                @if (Model.CatalogId is Guid catalogId) { <input type="hidden" name="CatalogId" value="@catalogId" /> }
                <div class="row-actions"><div><label for="catalogSequence">STT</label><input id="catalogSequence" name="Sequence" type="number" min="0" value="@(Model.CatalogId.HasValue ? Model.Sequence : null)" /></div><div><label for="receivedOn">Ngày nhận</label><input id="receivedOn" name="ReceivedOn" type="date" value="@(Model.CatalogId.HasValue ? Model.ReceivedOn?.ToString("yyyy-MM-dd") : null)" /></div><div><label for="catalogName">Tài liệu, sách, báo, tài sản, đồ dùng dạy học</label><input id="catalogName" name="Name" value="@(Model.CatalogId.HasValue ? Model.Name : null)" maxlength="500" /></div><div><label for="catalogPrice">Đơn giá</label><input id="catalogPrice" name="UnitPrice" type="number" min="0" step="0.01" value="@(Model.CatalogId.HasValue ? Model.UnitPrice : null)" /></div><div><label for="catalogQuantity">Số lượng</label><input id="catalogQuantity" name="Quantity" type="number" min="0" value="@(Model.CatalogId.HasValue ? Model.Quantity : null)" /></div></div>
                <div class="row-actions"><div><label for="catalogSupplier">Nguồn cấp</label><input id="catalogSupplier" name="Supplier" value="@(Model.CatalogId.HasValue ? Model.Supplier : null)" maxlength="240" /></div><div><label for="catalogNote">Ghi chú</label><input id="catalogNote" name="Note" value="@(Model.CatalogId.HasValue ? Model.Note : null)" /></div></div>
                <button type="submit">@(Model.CatalogId.HasValue ? "Lưu tài liệu" : "Thêm tài liệu")</button>
            </form>
        </details>
        <div class="table-scroll"><table><caption>@Model.Catalog.Count dòng danh mục</caption><thead><tr><th>STT</th><th>Ngày nhận</th><th>Tài liệu/sách/báo/tài sản/đồ dùng</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th><th>Nguồn cấp</th><th>Ghi chú</th><th>Thao tác</th></tr></thead><tbody>
            @if (Model.Catalog.Count == 0) { <tr><td colspan="9">Chưa có danh mục.</td></tr> }
            @foreach (var x in Model.Catalog) { <tr><td>@x.Sequence</td><td>@x.ReceivedOn</td><td>@x.Name</td><td>@x.UnitPrice</td><td>@x.Quantity</td><td>@x.TotalAmount</td><td>@x.Supplier</td><td>@x.Note</td><td class="row-actions"><a href="/admin/so-tai-san-tai-lieu?catalogId=@x.Id">Sửa</a><form method="post" asp-page-handler="DeleteCatalog"><input type="hidden" name="catalogId" value="@x.Id" /><button class="button-quiet" type="submit">Xóa</button></form></td></tr> }
        </tbody></table></div>
    </section>

    <section class="card stack">
        <h2>Theo dõi mượn và trả</h2>
        <p>Tình trạng và ký mượn/trả được lưu như nội dung ghi sổ trong biểu mẫu.</p>
        <form method="post" enctype="multipart/form-data" asp-page-handler="ImportLoans" class="row-actions"><label for="loanFile">Nhập workbook (sheet MƯỢN)</label><input id="loanFile" name="ImportFile" type="file" accept=".xlsx" required /><button type="submit">Nhập mượn–trả</button></form>
        <details class="stack" open="@(Model.LoanId.HasValue ? "open" : null)"><summary>@(Model.LoanId.HasValue ? "Sửa dòng mượn–trả" : "Thêm dòng mượn–trả")</summary>
            <form method="post" asp-page-handler="SaveLoan" class="stack">
                @if (Model.LoanId is Guid loanId) { <input type="hidden" name="LoanId" value="@loanId" /> }
                <div class="row-actions"><div><label for="loanSequence">STT</label><input id="loanSequence" name="Sequence" type="number" min="0" value="@(Model.LoanId.HasValue ? Model.Sequence : null)" /></div><div><label for="borrowerName">Họ tên người mượn</label><input id="borrowerName" name="BorrowerName" value="@Model.BorrowerName" maxlength="240" /></div><div><label for="materialName">Tên tài liệu, sách, ...</label><input id="materialName" name="MaterialName" value="@Model.MaterialName" maxlength="500" /></div><div><label for="borrowedOn">Ngày mượn</label><input id="borrowedOn" name="BorrowedOn" type="date" value="@Model.BorrowedOn?.ToString("yyyy-MM-dd")" /></div></div>
                <div class="row-actions"><div><label for="borrowCondition">Tình trạng lúc mượn</label><input id="borrowCondition" name="BorrowCondition" value="@Model.BorrowCondition" maxlength="240" /></div><div><label for="borrowedQuantity">Số lượng mượn</label><input id="borrowedQuantity" name="BorrowedQuantity" type="number" min="0" value="@Model.BorrowedQuantity" /></div><div><label for="borrowSignature">Ký mượn</label><input id="borrowSignature" name="BorrowSignature" value="@Model.BorrowSignature" maxlength="240" /></div></div>
                <div class="row-actions"><div><label for="returnedOn">Ngày trả</label><input id="returnedOn" name="ReturnedOn" type="date" value="@Model.ReturnedOn?.ToString("yyyy-MM-dd")" /></div><div><label for="returnCondition">Tình trạng lúc trả</label><input id="returnCondition" name="ReturnCondition" value="@Model.ReturnCondition" maxlength="240" /></div><div><label for="returnedQuantity">Số lượng trả</label><input id="returnedQuantity" name="ReturnedQuantity" type="number" min="0" value="@Model.ReturnedQuantity" /></div><div><label for="returnSignature">Ký trả</label><input id="returnSignature" name="ReturnSignature" value="@Model.ReturnSignature" maxlength="240" /></div></div>
                <button type="submit">@(Model.LoanId.HasValue ? "Lưu dòng" : "Thêm dòng")</button>
            </form>
        </details>
        <div class="table-scroll"><table><caption>@Model.Loans.Count dòng mượn–trả</caption><thead><tr><th>STT</th><th>Họ tên người mượn</th><th>Tên tài liệu</th><th>Ngày mượn</th><th>Tình trạng mượn</th><th>Số lượng mượn</th><th>Ký mượn</th><th>Ngày trả</th><th>Tình trạng trả</th><th>Số lượng trả</th><th>Ký trả</th><th>Thao tác</th></tr></thead><tbody>
            @if (Model.Loans.Count == 0) { <tr><td colspan="12">Chưa có giao dịch mượn–trả.</td></tr> }
            @foreach (var x in Model.Loans) { <tr><td>@x.Sequence</td><td>@x.BorrowerName</td><td>@x.MaterialName</td><td>@x.BorrowedOn</td><td>@x.BorrowCondition</td><td>@x.BorrowedQuantity</td><td>@x.BorrowSignature</td><td>@x.ReturnedOn</td><td>@x.ReturnCondition</td><td>@x.ReturnedQuantity</td><td>@x.ReturnSignature</td><td class="row-actions"><a href="/admin/so-tai-san-tai-lieu?loanId=@x.Id">Sửa</a><form method="post" asp-page-handler="DeleteLoan"><input type="hidden" name="loanId" value="@x.Id" /><button class="button-quiet" type="submit">Xóa</button></form></td></tr> }
        </tbody></table></div>
    </section>
</section>
