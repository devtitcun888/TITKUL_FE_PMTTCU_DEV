@page "/hoc-lieu/{slug}"
@model TITKUL.PMTTCU.Web.Pages.HocLieuChiTietModel
@{
    if (Model.Item is null) ViewData["Title"] = "Học liệu số";
}
<section class="card stack public-detail-page">
    <p class="public-detail-back"><a href="/hoc-lieu"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span> Về học liệu chung</a></p>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <h1>@(Model.ResourceNotFound ? "Không tìm thấy học liệu" : "Chưa tải được học liệu")</h1>
        <p class="@(Model.ResourceNotFound ? "empty" : "alert")" role="@(Model.ResourceNotFound ? "status" : "alert")">@Model.ErrorMessage</p>
    }
    @if (Model.Item is not null)
    {
        <h1>@Model.Item.Title</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Item.Summary)) { <p class="article-summary">@Model.Item.Summary</p> }
        @if (Model.Media.Count == 0)
        {
            <p class="empty">Album chưa có tệp.</p>
        }
        else
        {
            <ul class="stack">
                @foreach (var file in Model.Media)
                {
                    @if (file.FileId is Guid id)
                    {
                        <li>
                            @if (file.MimeType == "application/pdf" && file.ViewMode != "DOWNLOAD_ONLY")
                            {
                                <h2>@(file.Title ?? "Tài liệu PDF")</h2>
                                <iframe class="public-document-inline-frame" src="@HostFile.Href(file.FileUrl, "/hoc-lieu/" + Uri.EscapeDataString(Model.Item.Slug) + "?handler=Xem&id=" + id)" title="PDF: @(file.Title ?? Model.Item.Title)" loading="lazy"></iframe>
                            }
                            <a class="button" href="@HostFile.Href(file.FileUrl, "/hoc-lieu/" + Uri.EscapeDataString(Model.Item.Slug) + "?handler=Tai&id=" + id)">Tải @(file.Title ?? "tệp")</a>
                            <small>@HocLieuChiTietModel.FileType(file.MimeType)@if (file.Size is long size) { <span> · @HocLieuChiTietModel.FileSize(size)</span> }</small>
                        </li>
                    }
                }
            </ul>
        }
    }
</section>
