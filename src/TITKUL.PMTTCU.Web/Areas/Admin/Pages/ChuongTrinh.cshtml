@page "/admin/chuong-trinh"
@using TITKUL.PMTTCU.Web.Areas.Admin
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.ChuongTrinhModel
@{
    ViewData["Title"] = "Chương trình";
}

<section class="crm-page cms-posts-page cms-list-page">

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="crm-alert" role="alert">@Model.ErrorMessage</p>
    }

    <form class="cms-posts-toolbar" method="get" action="/admin/chuong-trinh" role="search" data-cms-autofilter data-cols="2">
        @await Html.PartialAsync("Shared/_CmsSortHidden", (Model.Sort, Model.Dir))
        <button class="cms-posts-filter-toggle @(Model.FiltersActive ? "has-active-filters" : null)" type="button" aria-label="Bộ lọc" aria-expanded="false" aria-controls="edu-program-filter-fields" data-cms-filter-toggle>
            <svg class="cms-posts-filter-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M4 5h16l-6.5 7.5v5l-3 1.5v-6.5L4 5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
        <div class="cms-posts-filter-fields" id="edu-program-filter-fields">
            <label class="cms-posts-field">
                <span>Từ khóa</span>
                <span class="cms-posts-search">
                    <span class="material-symbols-outlined" aria-hidden="true">search</span>
                    <input name="q" type="search" value="@Model.Query" placeholder="Mã hoặc tên chương trình" />
                </span>
            </label>
            <label class="cms-posts-field">
                <span>Trạng thái</span>
                <select name="status" data-cms-filter>
                    <option value="">Tất cả trạng thái</option>
                    <option value="ACTIVE" selected="@(Model.StatusFilter == "ACTIVE" ? "selected" : null)">Đang dùng</option>
                    <option value="DRAFT" selected="@(Model.StatusFilter == "DRAFT" ? "selected" : null)">Nháp</option>
                    <option value="INACTIVE" selected="@(Model.StatusFilter == "INACTIVE" ? "selected" : null)">Ngưng</option>
                </select>
            </label>
            <div class="cms-posts-toolbar-actions">
                <a class="cms-posts-reset" href="/admin/chuong-trinh">
                    <span class="material-symbols-outlined" aria-hidden="true">restart_alt</span>
                    Xóa lọc
                </a>
            </div>
        </div>
    </form>

    <section class="cms-posts-kpis" data-cols="4" aria-label="Thống kê chương trình">
        <a class="cms-posts-kpi is-all @(Model.StatusFilter is null ? "is-current" : null)" href="@Model.ListUrl(status: "")">
            <span class="cms-posts-kpi-icon" aria-hidden="true"><span class="material-symbols-outlined">menu_book</span></span>
            <span><span class="cms-posts-kpi-label">Tất cả</span><strong>@Model.TotalAll.ToString("N0")</strong></span>
        </a>
        <a class="cms-posts-kpi is-published @(Model.StatusFilter == "ACTIVE" ? "is-current" : null)" href="@Model.ListUrl(status: "ACTIVE")">
            <span class="cms-posts-kpi-icon" aria-hidden="true"><span class="cms-posts-dot"></span></span>
            <span><span class="cms-posts-kpi-label">Đang dùng</span><strong>@Model.TotalActive.ToString("N0")</strong></span>
        </a>
        <a class="cms-posts-kpi is-draft @(Model.StatusFilter == "DRAFT" ? "is-current" : null)" href="@Model.ListUrl(status: "DRAFT")">
            <span class="cms-posts-kpi-icon" aria-hidden="true"><span class="material-symbols-outlined">description</span></span>
            <span><span class="cms-posts-kpi-label">Nháp</span><strong>@Model.TotalDraft.ToString("N0")</strong></span>
        </a>
        <a class="cms-posts-kpi is-cancelled @(Model.StatusFilter == "INACTIVE" ? "is-current" : null)" href="@Model.ListUrl(status: "INACTIVE")">
            <span class="cms-posts-kpi-icon" aria-hidden="true"><span class="material-symbols-outlined">keep</span></span>
            <span><span class="cms-posts-kpi-label">Ngưng</span><strong>@Model.TotalInactive.ToString("N0")</strong></span>
        </a>
    </section>

    <section class="cms-posts-list" aria-labelledby="program-table-title">
        <header class="cms-posts-list-heading">
            <div>
                <h2 id="program-table-title">Danh sách chương trình</h2>
                <p>@Model.Items.Count.ToString("N0") chương trình</p>
            </div>
            <div class="cms-posts-list-actions">
                @if (Model.CanManage)
                {
                    <a class="crm-primary-button cms-posts-create" href="/admin/chuong-trinh?create=true"><span class="material-symbols-outlined" aria-hidden="true">add</span> Thêm chương trình</a>
                }
            </div>
        </header>
        @if (Model.Items.Count == 0)
        {
            <div class="cms-posts-empty">
                <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
                <strong>@(Model.FiltersActive ? "Không tìm thấy chương trình phù hợp" : "Chưa có chương trình")</strong>
                <p>@(Model.FiltersActive ? "Thử xóa bộ lọc hoặc đổi từ khóa." : "Tạo chương trình đầu tiên để quản lý đào tạo.")</p>
            </div>
        }
        else
        {
            <div class="cms-posts-table-scroll">
                <table class="cms-posts-table">
                    <thead>
                        <tr>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "code", Model.Dir)" href="@Model.SortUrl("code")">Mã <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "code", Model.Dir)</span></a></th>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "name", Model.Dir)" href="@Model.SortUrl("name")">Tên chương trình <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "name", Model.Dir)</span></a></th>
                            <th scope="col">Nhóm khóa học</th>
                            <th scope="col">Hiển thị công khai</th>
                            <th scope="col"><a class="@EducationUi.SortClass(Model.Sort, "status", Model.Dir)" href="@Model.SortUrl("status")">Trạng thái <span class="material-symbols-outlined" aria-hidden="true">@EducationUi.SortIcon(Model.Sort, "status", Model.Dir)</span></a></th>
                            @if (Model.CanManage) { <th class="cms-posts-actions-col" scope="col">Thao tác</th> }
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var statusClass = item.Status == "ACTIVE" ? "published" : item.Status == "DRAFT" ? "draft" : "cancelled";
                        <tr>
                            <td><span class="cms-posts-category">@item.Code</span></td>
                            <td class="cms-posts-title-cell"><strong>@item.Name</strong></td>
                            <td>@Model.CategoryName(item.CategoryId)</td>
                            <td>@(item.Public ? "Đang công khai" : "Chưa công khai")</td>
                            <td><span class="cms-posts-status is-@statusClass"><i aria-hidden="true"></i>@EducationUi.Status(item.Status ?? "")</span></td>
                            @if (Model.CanManage)
                            {
                                <td class="cms-posts-actions-col">
                                    <details class="cms-posts-row-menu">
                                        <summary aria-label="Thao tác @item.Name"><span class="material-symbols-outlined" aria-hidden="true">more_horiz</span></summary>
                                        <div class="cms-posts-row-panel" role="menu">
                                            <a role="menuitem" href="/admin/chuong-trinh?id=@item.Id">Sửa</a>
                                            <button class="cms-posts-menu-btn" type="submit" form="edu-program-delete-@item.Id" role="menuitem">Xóa</button>
                                        </div>
                                    </details>
                                    <form id="edu-program-delete-@item.Id" method="post" asp-page-handler="Delete" hidden onsubmit="return confirm('Xóa chương trình này?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</section>

@if (Model.ShowModal && Model.CanManage)
{
    <dialog class="education-modal" open aria-labelledby="program-modal-title">
        <div class="education-modal-backdrop"></div>
        <section class="education-modal-panel" role="dialog" aria-modal="true" aria-labelledby="program-modal-title">
            <header class="education-modal-heading"><div><p class="education-eyebrow">THÔNG TIN ĐÀO TẠO</p><h2 id="program-modal-title">@(Model.Editing ? "Cập nhật chương trình" : "Thêm chương trình")</h2></div><a class="education-modal-close" href="/admin/chuong-trinh" aria-label="Đóng">×</a></header>
            <form method="post" class="education-program-form">
                @Html.AntiForgeryToken()
                @if (Model.Id is Guid editId) { <input type="hidden" name="Id" value="@editId" /> }
                @if (Model.Editing) { <input type="hidden" name="Code" value="@Model.Code" /> }
                <div class="education-form-field"><label for="program-code">Mã chương trình</label><p class="education-field-hint">Mã do hệ thống tự động tạo và không thay đổi sau khi lưu.</p><input id="program-code" class="education-readonly-field" value="@(Model.Editing ? Model.Code : "Tự động tạo sau khi lưu")" readonly aria-readonly="true" /></div>
                <div class="education-form-field"><label for="program-name">Tên chương trình <span>*</span></label><input id="program-name" name="Name" value="@Model.Name" placeholder="Nhập tên chương trình" required maxlength="250" autocomplete="off" /></div>
                <div class="education-form-field"><label for="program-category">Nhóm khóa học</label><select id="program-category" name="CategoryId"><option value="">Chọn nhóm</option>@foreach (var category in Model.Categories) { <option value="@category.Id" selected="@(Model.CategoryId == category.Id ? "selected" : null)">@category.Name</option> }</select></div>
                <div class="education-form-field"><label for="program-slug">Đường dẫn</label><input id="program-slug" name="Slug" value="@Model.Slug" maxlength="180" placeholder="Tự tạo từ tên nếu để trống" /></div>
                <div class="education-form-field"><label for="program-summary">Giới thiệu ngắn</label><textarea id="program-summary" name="Summary" rows="3" maxlength="500">@Model.Summary</textarea></div>
                <div class="education-form-field"><label for="program-goal">Mục tiêu <span>*</span></label><textarea id="program-goal" name="Goal" placeholder="Mô tả mục tiêu chương trình" rows="4" required>@Model.Goal</textarea></div>
                <div class="education-form-field"><label for="program-content">Nội dung chi tiết</label><textarea id="program-content" name="ContentHtml" rows="10" placeholder="Có thể nhập HTML nội dung. Hệ thống sẽ lọc HTML nguy hiểm trước khi hiển thị.">@Model.ContentHtml</textarea></div>
                <div class="education-form-field"><label for="program-cover">Khóa ảnh đại diện</label><input id="program-cover" name="CoverKey" value="@Model.CoverKey" maxlength="1000" /></div>
                <div class="education-form-field"><label for="program-status">Trạng thái <span>*</span></label><select id="program-status" name="Status"><option value="ACTIVE" selected="@(Model.Status == "ACTIVE" ? "selected" : null)">Đang dùng</option><option value="DRAFT" selected="@(Model.Status == "DRAFT" ? "selected" : null)">Nháp</option><option value="INACTIVE" selected="@(Model.Status == "INACTIVE" ? "selected" : null)">Ngưng</option></select></div>
                <div class="education-form-field"><label for="program-seo-title">Tiêu đề SEO</label><input id="program-seo-title" name="SeoTitle" value="@Model.SeoTitle" maxlength="70" /></div>
                <div class="education-form-field"><label for="program-seo-description">Mô tả SEO</label><textarea id="program-seo-description" name="SeoDescription" rows="2" maxlength="170">@Model.SeoDescription</textarea></div>
                <label class="education-form-field"><span><input type="checkbox" name="Public" value="true" checked="@(Model.Public ? "checked" : null)" /> Công khai trang chương trình</span><small>Chỉ hiện khi trạng thái là Đang dùng, đã chọn nhóm khóa học và có nội dung chi tiết.</small></label>
                <footer class="education-modal-actions"><a class="education-cancel-button" href="/admin/chuong-trinh">Hủy</a><button class="education-primary-button" type="submit">Lưu chương trình</button></footer>
            </form>
        </section>
    </dialog>
}

<script src="~/js/admin-education.js" asp-append-version="true" defer></script>
<script src="~/js/admin-cms-list.js" asp-append-version="true" defer></script>
