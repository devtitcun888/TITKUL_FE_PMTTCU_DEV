<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PMTTCU Tân Trụ</title>
    <link rel="stylesheet" href="~/css/pmttcu.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#noi-dung">Đi tới nội dung</a>
    <header class="portal-header">
        <div class="wrap">
            <a class="brand" asp-area="" asp-page="/Index">PMTTCU Tân Trụ</a>
            <nav aria-label="Chính">
                <ul class="nav-list">
                    <li><a asp-area="" asp-page="/Index">Trang chủ</a></li>
                    <li><a href="/lop-hoc">Lớp học</a></li>
                    <li><a asp-area="" asp-page="/Privacy">Thông tin</a></li>
                    <li><a href="/admin">Quản trị</a></li>
                </ul>
            </nav>
        </div>
    </header>
    <main id="noi-dung" class="page">
        <div class="wrap">
            @RenderBody()
        </div>
    </main>
    <footer class="portal-footer">
        <div class="wrap">
            <p>Trung tâm cung ứng dịch vụ sự nghiệp công xã Tân Trụ</p>
            <a asp-area="" asp-page="/Privacy">Thông tin</a>
        </div>
    </footer>
</body>
</html>
