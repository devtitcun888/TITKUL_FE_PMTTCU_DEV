<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PMTTCU Tân Trụ</title>
    @if (ViewData["Description"] is string description && description.Length > 0)
    {
        <meta name="description" content="@description" />
    }
    <link rel="stylesheet" href="~/css/pmttcu.css" asp-append-version="true" />
</head>
<body class="@(ViewData["BodyClass"] ?? string.Empty)">
    <a class="skip-link" href="#noi-dung">Đi tới nội dung</a>
    <header class="portal-header">
        <div class="utility-bar">
            <div class="wrap utility-inner">
                <span>Trung tâm cung ứng dịch vụ sự nghiệp công xã Tân Trụ</span>
                <div class="utility-links"><a href="tel:0942429989">☎ 0942 42 9989</a><a href="mailto:kinhdoanh@titkul.com">✉ Liên hệ hỗ trợ</a><a href="/admin">♙ Cổng quản trị cán bộ</a></div>
            </div>
        </div>
        <div class="wrap main-nav-row">
            <a class="brand" asp-area="" asp-page="/Index" aria-label="Trang chủ PMTTCU Tân Trụ"><span class="brand-mark" aria-hidden="true">✦</span><span><strong>Trung tâm dịch vụ<br />sự nghiệp công</strong><small>xã Tân Trụ</small></span></a>
            <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-navigation">Menu <span aria-hidden="true">☰</span></button>
            <nav id="main-navigation" aria-label="Chính">
                <ul class="nav-list">
                    <li><a asp-area="" asp-page="/Index">Trang chủ</a></li>
                    <li><a href="/gioi-thieu">Giới thiệu</a></li>
                    <li><a href="/lop-hoc">Lớp học</a></li>
                    <li><a href="/su-kien">Lịch hoạt động</a></li>
                    <li><a href="/tin-tuc">Tin tức</a></li>
                    <li><a href="/van-ban">Văn bản</a></li>
                    <li><a href="/hoc-lieu">Học liệu số</a></li>
                    <li><a href="/lien-he">Liên hệ</a></li>
                </ul>
            </nav>
            <a class="header-cta" href="/lop-hoc">Đăng ký lớp học <span aria-hidden="true">→</span></a>
        </div>
    </header>
    <main id="noi-dung" class="page">
        <div class="wrap">
            @RenderBody()
        </div>
    </main>
    <footer class="portal-footer">
        <div class="wrap footer-grid">
            <div><a class="footer-brand" asp-area="" asp-page="/Index"><span class="brand-mark" aria-hidden="true">✦</span><span><strong>Trung tâm dịch vụ sự nghiệp công</strong><small>xã Tân Trụ</small></span></a><p>Cổng thông tin và quản lý học tập cộng đồng vì một địa phương học tập suốt đời.</p></div>
            <div><h2>Liên kết nhanh</h2><a href="/lop-hoc">Lớp học</a><a href="/tin-tuc">Tin tức - Thông báo</a><a href="/hoc-lieu">Kho học liệu số</a></div>
            <div><h2>Liên hệ</h2><span>572/14B Âu Cơ, P. Bảy Hiền, TP.HCM</span><a href="tel:0942429989">0942 42 9989</a><a href="mailto:kinhdoanh@titkul.com">kinhdoanh@titkul.com</a></div>
        </div>
        <div class="wrap footer-bottom"><span>© 2026 Trung tâm dịch vụ sự nghiệp công xã Tân Trụ</span><a asp-area="" asp-page="/Privacy">Thông tin bảo mật</a></div>
    </footer>
    <script>
        document.querySelector('.nav-toggle')?.addEventListener('click', function () {
            const expanded = this.getAttribute('aria-expanded') === 'true';
            this.setAttribute('aria-expanded', String(!expanded));
            document.querySelector('#main-navigation')?.classList.toggle('is-open', !expanded);
        });
    </script>
</body>
</html>
