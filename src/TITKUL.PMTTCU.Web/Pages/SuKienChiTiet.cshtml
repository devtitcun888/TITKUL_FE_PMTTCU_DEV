@page "/su-kien/{slug}"
@model TITKUL.PMTTCU.Web.Pages.SuKienChiTietModel
@{
    if (Model.Item is null)
    {
        ViewData["Title"] = "Sự kiện";
    }
    var hasWideTable = PortalRichContent.ContainsTable(Model.Item?.Html);
}

<section class="card stack public-detail-page">
    <p class="public-detail-back"><a href="/su-kien"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span> Về lịch hoạt động</a></p>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <h1>@(Model.ResourceNotFound ? "Không tìm thấy sự kiện" : "Chưa tải được sự kiện")</h1>
        <p class="@(Model.ResourceNotFound ? "empty" : "alert")" role="@(Model.ResourceNotFound ? "status" : "alert")">@Model.ErrorMessage</p>
    }
    @if (Model.Item is not null)
    {
        <article class="stack public-detail-article">
            <header class="public-detail-heading">
                <p class="public-detail-eyebrow">Sự kiện của Trung tâm</p>
                <h1>@Model.Item.Title</h1>
                <div class="public-event-meta" aria-label="Thông tin sự kiện">
                    <div class="public-event-meta-item">
                        <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
                        <span class="public-event-meta-copy"><strong>Thời gian</strong><span><time datetime="@Model.Item.StartAt.ToString("O")">@Model.Item.StartAt.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</time> – <time datetime="@Model.Item.EndAt.ToString("O")">@Model.Item.EndAt.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm")</time></span></span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Item.Location))
                    {
                        <div class="public-event-meta-item">
                            <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
                            <span class="public-event-meta-copy"><strong>Địa điểm</strong><span>@Model.Item.Location</span></span>
                        </div>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Item.Summary)) { <p class="public-detail-lead">@Model.Item.Summary</p> }
            </header>
            @if (!string.IsNullOrWhiteSpace(Model.Item.Html))
            {
                @if (hasWideTable) { <p id="cms-table-scroll-hint" class="portal-table-hint">Nếu bảng rộng, vuốt ngang để xem đủ cột. Dùng phím Tab để chọn bảng, sau đó dùng phím mũi tên.</p> }
                <div class="portal-rich-content">@Html.Raw(PortalRichContent.WithScrollableTables(Model.Item.Html))</div>
            }
            <footer class="public-event-footer">
                <p class="status-note">Đây là sự kiện trên lịch công khai. Thông tin đăng ký (nếu có) do Ban tổ chức nêu trong nội dung sự kiện.</p>
                <a class="button button-quiet" href="/lien-he">Liên hệ Trung tâm</a>
            </footer>
        </article>
    }
</section>
