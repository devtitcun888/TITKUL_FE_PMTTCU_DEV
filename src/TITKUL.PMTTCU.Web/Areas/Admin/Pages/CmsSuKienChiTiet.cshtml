@page "/admin/cms/su-kien/sua/{id:guid?}"
@using TITKUL.PMTTCU.Web.Areas.Admin
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.CmsSuKienChiTietModel
@{
    ViewData["UseCmsEditor"] = true;
    ViewData["Title"] = Model.EventId is null ? "Sự kiện mới" : "Biên tập sự kiện";
    if (Model.Preview) Layout = "/Pages/Shared/_Layout.cshtml";
}

@if (Model.Preview)
{
<article class="portal-article wrap">
    <p><a href="/admin/cms/su-kien/sua/@Model.EventId">Quay lại biên tập</a> · Bản xem trước, chưa xuất bản</p>
    <h1>@Model.Title</h1>
    <p>@Model.StartAt · @Model.Location</p>
    @if (!string.IsNullOrWhiteSpace(Model.Summary)) { <p class="portal-lead">@Model.Summary</p> }
    <div class="portal-rich-content ck-content">@Html.Raw(Model.PreviewHtml)</div>
</article>
}
else
{
<section class="card stack">
    <h1>@(Model.EventId is null ? "Sự kiện mới" : "Biên tập sự kiện")</h1>
    <p><a href="/admin/cms/su-kien">Về danh sách</a></p>
    @if (!string.IsNullOrEmpty(Model.Status))
    {
        <p>Trạng thái: @EducationUi.Status(Model.Status)</p>
        @if (Model.PublishedAt > DateTimeOffset.UtcNow) { <p role="status">Đã lên lịch xuất bản: @Model.PublishedAt.Value.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm") (giờ Việt Nam).</p> }
    }
@if (Model.EventId is Guid previewId)
    {
        <p><a class="button" href="/admin/cms/su-kien/sua/@previewId?preview=true" target="_blank" rel="noopener">Xem trước như trang công khai</a></p>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="alert" role="alert">@Model.ErrorMessage</p>
    }
    @if (Model.CanEdit)
    {
        <form method="post" asp-page-handler="Save" class="stack">
            <div>
                <label for="title">Tiêu đề</label>
                <input id="title" name="Title" value="@Model.Title" required maxlength="250" data-slug-source />
            </div>
            <div>
                <label for="slug">Đường dẫn (tự gợi ý từ tiêu đề, có thể chỉnh)</label>
                <input id="slug" name="Slug" value="@Model.Slug" maxlength="280" data-slug-target data-slug-prefix="/su-kien/" />
                <small>Đường dẫn xem trước: <code data-slug-preview>/su-kien/@Model.Slug</code></small>
            </div>
            <div>
                <label for="startAt">Bắt đầu</label>
                <input id="startAt" name="StartAt" type="datetime-local" value="@Model.StartAt" required />
            </div>
            <div>
                <label for="endAt">Kết thúc</label>
                <input id="endAt" name="EndAt" type="datetime-local" value="@Model.EndAt" required />
            </div>
            <div>
                <label for="location">Địa điểm</label>
                <input id="location" name="Location" value="@Model.Location" maxlength="300" />
            </div>
            <div>
                <label for="summary">Tóm tắt</label>
                <textarea id="summary" name="Summary" rows="3">@Model.Summary</textarea>
            </div>
            <div>
                <label for="html">Nội dung HTML</label>
                <textarea id="html" name="Html" rows="8" data-editor="cms">@Model.Html</textarea>
            </div>
            <button type="submit">Lưu nháp</button>
        </form>
        @if (Model.EventId is Guid eventId)
        {
            <p class="row-actions">
                @if (Model.Status != "PUBLISHED" && Model.Status != "CANCELLED")
                {
                    <form method="post" asp-page-handler="Publish">
                        <button type="submit">Đăng sự kiện</button>
                    </form>
                    <form method="post" asp-page-handler="Schedule" class="row-actions">
                        <label for="scheduleAt">Hoặc hẹn giờ xuất bản (giờ Việt Nam)</label>
                        <input id="scheduleAt" name="ScheduleAt" type="datetime-local" required />
                        <button type="submit">Đặt lịch</button>
                    </form>
                }
                @if (Model.Status == "PUBLISHED")
                {
                    <form method="post" asp-page-handler="Cancel">
                        <button type="submit" class="button-quiet">Hủy sự kiện</button>
                    </form>
                    <a class="button" href="/su-kien/@Model.Slug">Xem trên Portal</a>
                }
            </p>
        }
    }
    @if (!string.IsNullOrEmpty(Model.Html))
    {
        <h2>Xem trước</h2>
        <article class="card">
            <h3>@Model.Title</h3>
            @Html.Raw(Model.PreviewHtml)
        </article>
    }
</section>
}
