@page "/admin/nhan-su"
@model TITKUL.PMTTCU.Web.Areas.Admin.Pages.NhanSuModel
@{
    ViewData["Title"] = "Nhân sự, cộng tác viên";
}

<section class="card stack admin-education-page">
    <div class="row-actions">
        <div>
            <h1>Nhân sự, cộng tác viên</h1>
            <p>Danh sách giảng viên và cộng tác viên theo biểu mẫu của Trung tâm.</p>
        </div>
        <a class="button button-quiet" href="/admin/nhan-su?handler=Export">Xuất Excel theo mẫu</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <p class="alert" role="alert">@Model.ErrorMessage</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <p class="status-note" role="status">@Model.SuccessMessage</p>
    }

    <details class="card stack">
        <summary>Nhập danh sách từ file Excel</summary>
        <p>Nhập một sheet có tiêu đề cột theo mẫu “CỘNG TÁC VIÊN, GV”. Hồ sơ trống được bỏ qua; file có dòng dữ liệu thiếu họ tên hoặc năm sinh không hợp lệ sẽ bị từ chối trước khi nhập.</p>
        <form method="post" enctype="multipart/form-data" asp-page-handler="Import" class="row-actions">
            <label for="importFile">File Excel .xlsx</label>
            <input id="importFile" name="ImportFile" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required />
            <button type="submit">Nhập danh sách</button>
        </form>
    </details>

    <details class="card stack" open="@(Model.IsEditing ? "open" : null)">
        <summary>@(Model.IsEditing ? "Sửa hồ sơ" : "Thêm hồ sơ")</summary>
        <form method="post" class="stack">
            @if (Model.Id is Guid id)
            {
                <input type="hidden" name="Id" value="@id" />
            }
            <div>
                <label for="fullName">Họ và tên</label>
                <input id="fullName" name="FullName" value="@Model.FullName" maxlength="180" required autocomplete="name" />
            </div>
            <div>
                <label for="female">Giới tính</label>
                <select id="female" name="Female">
                    <option value="false" selected="@(!Model.Female ? "selected" : null)">Nam</option>
                    <option value="true" selected="@(Model.Female ? "selected" : null)">Nữ</option>
                </select>
            </div>
            <div>
                <label for="birthYear">Năm sinh</label>
                <input id="birthYear" name="BirthYear" type="number" min="1" max="9999" value="@Model.BirthYear" />
            </div>
            <div>
                <label for="workUnit">Đơn vị công tác</label>
                <input id="workUnit" name="WorkUnit" value="@Model.WorkUnit" maxlength="240" />
            </div>
            <div>
                <label for="position">Chức vụ</label>
                <input id="position" name="Position" value="@Model.Position" maxlength="180" />
            </div>
            <div>
                <label for="phone">Số điện thoại</label>
                <input id="phone" name="Phone" value="@Model.Phone" maxlength="40" autocomplete="tel" />
            </div>
            <div>
                <label for="linkedUserId">Tài khoản đăng nhập (tùy chọn)</label>
                <select id="linkedUserId" name="LinkedUserId">
                    <option value="">Không liên kết tài khoản</option>
                    @foreach (var staff in Model.Staff)
                    {
                        <option value="@staff.Id" selected="@(Model.LinkedUserId == staff.Id ? "selected" : null)">@staff.Username</option>
                    }
                </select>
                <small>Liên kết hồ sơ không tự tạo tài khoản hoặc cấp quyền đăng nhập.</small>
            </div>
            <div>
                <label for="note">Ghi chú</label>
                <textarea id="note" name="Note" maxlength="1000" rows="3">@Model.Note</textarea>
            </div>
            <div class="row-actions">
                <button type="submit">@(Model.IsEditing ? "Lưu hồ sơ" : "Thêm hồ sơ")</button>
                @if (Model.IsEditing)
                {
                    <a class="button button-quiet" href="/admin/nhan-su">Hủy sửa</a>
                }
            </div>
        </form>
    </details>

    <form method="get" class="row-actions">
        <label for="q">Tìm kiếm</label>
        <input id="q" name="Q" value="@Model.Q" placeholder="Họ tên, đơn vị, chức vụ, số điện thoại" />
        <button type="submit">Tìm</button>
    </form>

    @if (Model.Items.Count == 0)
    {
        <p class="empty">Chưa có hồ sơ cộng tác viên, giáo viên.</p>
    }
    else
    {
        <div class="table-scroll">
            <table>
                <caption>Danh sách cộng tác viên và giáo viên, tổng @Model.Total hồ sơ</caption>
                <thead>
                    <tr>
                        <th scope="col">Họ và tên</th>
                        <th scope="col">Nữ</th>
                        <th scope="col">Năm sinh</th>
                        <th scope="col">Đơn vị công tác</th>
                        <th scope="col">Chức vụ</th>
                        <th scope="col">Số ĐT</th>
                        <th scope="col">Tài khoản</th>
                        <th scope="col">Ghi chú</th>
                        <th scope="col">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.FullName</td>
                            <td>@(item.Female ? "X" : "")</td>
                            <td>@item.BirthYear</td>
                            <td>@item.WorkUnit</td>
                            <td>@item.Position</td>
                            <td>@item.Phone</td>
                            <td>@(item.LinkedUsername ?? "Không liên kết")</td>
                            <td>@item.Note</td>
                            <td><a href="/admin/nhan-su?id=@item.Id">Sửa</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
